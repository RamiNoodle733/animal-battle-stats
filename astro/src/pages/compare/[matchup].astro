---
import Base from '../../layouts/Base.astro';
import VsScreen from '../../components/VsScreen.astro';
import { PAIRS, verdict, notesFor } from '../../lib/matchups.js';
import { SITE, absoluteUrl } from '../../lib/site.js';
import { matchupPreview, PREVIEW_FILE } from '../../lib/card.js';

export function getStaticPaths() {
    return PAIRS.map((pair) => ({ params: { matchup: pair.slug }, props: { pair } }));
}

const { pair } = Astro.props;
const { a, b } = pair;
const result = verdict(a, b);
const path = `/compare/${pair.slug}`;
// The two battle cards squared up (scripts/images/build-cards.mjs).
const preview = matchupPreview(`vs/${pair.slug}`, a, b);
const previewAlt = `${a.name} vs ${b.name} battle cards: who would win?${result.draw ? ' Dead even, a draw.' : ` ${result.winner.name}, ${result.odds}%.`}`;
const notes = notesFor(a, b);
const extraFaq = notes?.faq || [];
const title = `${notes?.title || `${a.name} vs ${b.name}`}: Who Would Win? | ${SITE.name}`;
const description = result.draw
    ? `${a.name} vs ${b.name} is dead even in our model (50-50): the fight ends in a draw. Stat duel, size comparison, speed, bite force and an animated fight.`
    : `${result.winner.name} beats the ${result.loser.name} ${result.odds}% of the time in our model (${result.strength.toLowerCase()}). Stat duel, size comparison, speed, bite force and an animated fight.`;
const jsonLd = [
    {
        '@type': 'WebPage',
        url: absoluteUrl(path),
        name: `${a.name} vs ${b.name}: who would win?`,
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        primaryImageOfPage: { '@type': 'ImageObject', contentUrl: absoluteUrl(preview), url: absoluteUrl(preview), caption: previewAlt, width: PREVIEW_FILE.width, height: PREVIEW_FILE.height, creator: { '@id': `${SITE.url}/#organization` } },
        image: absoluteUrl(preview),
        about: [
            { '@type': 'Taxon', name: a.name, scientificName: a.scientific_name, url: absoluteUrl(`/stats/${a.slug}`) },
            { '@type': 'Taxon', name: b.name, scientificName: b.scientific_name, url: absoluteUrl(`/stats/${b.slug}`) }
        ]
    },
    {
        '@type': 'FAQPage',
        mainEntity: [
            { '@type': 'Question', name: `Who would win, ${a.name} or ${b.name}?`, acceptedAnswer: { '@type': 'Answer', text: `${result.draw ? 'Neither: it is a draw.' : `${result.winner.name}.`} ${result.paragraphs.join(' ')}` } },
            { '@type': 'Question', name: `Is the ${result.winner.name} stronger than the ${result.loser.name}?`, acceptedAnswer: { '@type': 'Answer', text: result.draw ? `They are dead even: power index ${result.winner.powerIndex} vs ${result.loser.powerIndex} on the Animal Battle Stats scale, and a 50-50 fight.` : `Overall, yes: power index ${result.winner.powerIndex} vs ${result.loser.powerIndex} on the Animal Battle Stats scale.` } },
            ...extraFaq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } }))
        ]
    },
    {
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
            { '@type': 'ListItem', position: 2, name: 'Who would win', item: absoluteUrl('/compare') },
            { '@type': 'ListItem', position: 3, name: `${a.name} vs ${b.name}`, item: absoluteUrl(path) }
        ]
    }
];
---
<Base title={title} description={description} path={path} image={preview} imageAlt={previewAlt} jsonLd={jsonLd} active="compare" biome={result.winner.biome}>
    <VsScreen a={a} b={b} extraFaq={extraFaq} cardImage={{ src: preview, alt: previewAlt }} />
</Base>
<script>
    import '../../scripts/versus.js';
</script>
