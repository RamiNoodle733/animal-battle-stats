---
// The Roblox logomark, unmodified and in one flat colour (currentColor). Used only
// where it names Roblox as the place to play or sign in. Roblox and the Roblox
// logo are trademarks of Roblox Corporation.
const { size = 20, class: className, title } = Astro.props;
---
<svg class:list={['rbx-mark', className]} viewBox="0 0 24 24" width={size} height={size} fill="currentColor" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} focusable="false">{title && <title>{title}</title>}<path d="M18.926 23.998 0 18.892 5.075.002 24 5.108ZM15.348 10.09l-5.282-1.453-1.414 5.273 5.282 1.453z" /></svg>
