---
import AnimalImage from './AnimalImage.astro';
import { TIERS, fmtScore } from '../lib/catalog.js';

const { list } = Astro.props;
const tiers = TIERS.map((tier) => ({ ...tier, animals: list.filter((animal) => animal.tier === tier.id) }));
---
<div class="tier-board">
    {tiers.map((tier) => (
        <section class={`tier-row tier-${tier.id.toLowerCase()}`} id={`tier-${tier.id.toLowerCase()}`} aria-label={`${tier.id} tier: ${tier.name}`}>
            <header class="tier-label">
                <i class={`tier-badge lg tier-${tier.id.toLowerCase()}`}>{tier.id}</i>
                <span>{tier.name}</span>
                <small>{tier.animals.length}</small>
            </header>
            {tier.animals.length ? (
                <ol class="tier-list">
                    {tier.animals.map((animal) => (
                        <li>
                            <a class={`tchip bio-${animal.biome}`} href={`/stats/${animal.slug}`} title={`${animal.name}: power ${fmtScore(animal.powerIndex)} (#${animal.rank})`} data-sfx>
                                <span class="tart"><AnimalImage animal={animal} sizes="96px" alt="" class="animal-art" /></span>
                                <span class="tl-name">{animal.name}</span>
                                <span class="tl-score">{fmtScore(animal.powerIndex)}</span>
                            </a>
                        </li>
                    ))}
                </ol>
            ) : <p class="tier-empty">None in this group</p>}
        </section>
    ))}
</div>

<style>
    .tier-board { display: grid; gap: 8px; }
    .tier-row {
        display: grid;
        grid-template-columns: 86px minmax(0, 1fr);
        min-height: 104px;
        background: rgba(0, 0, 0, 0.26);
        border: 1px solid var(--line-2);
        border-radius: 10px;
        overflow: hidden;
    }
    .tier-label {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
        background: linear-gradient(180deg, color-mix(in srgb, var(--tier) 16%, #17181c), #111215);
        border-right: 2px solid color-mix(in srgb, var(--tier) 70%, transparent);
    }
    .tier-label .tier-badge { width: 50px; height: 60px; }
    .tier-label span { font-family: var(--font-display); font-size: 0.9rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; }
    .tier-label small { font-size: 0.7rem; font-weight: 800; color: var(--muted); }
    .tier-list { list-style: none; margin: 0; padding: 8px; display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
    .tchip {
        position: relative;
        display: flex; flex-direction: column; align-items: center;
        width: 88px; height: 100%;
        padding: 4px 4px 5px;
        background: radial-gradient(80% 60% at 50% 38%, rgba(255, 255, 255, 0.07), transparent 75%), linear-gradient(180deg, #202227, #121316);
        border: 1px solid var(--line-2);
        border-radius: 8px;
        transition: transform 0.18s var(--spring), border-color 0.15s;
        text-align: center;
    }
    .tchip:hover { transform: translateY(-4px) scale(1.04); border-color: var(--tier); z-index: 2; }
    .tart { width: 80px; height: 56px; display: grid; place-items: center; container-type: size; }
    .tchip :global(img) { --fit: 0.86; filter: drop-shadow(0 5px 6px rgba(0, 0, 0, 0.55)); }
    .tl-name { margin-top: 2px; font-family: var(--font-display); font-size: 0.8rem; font-weight: 900; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; }
    .tl-score { font-family: var(--font-display); font-size: 0.82rem; font-weight: 900; color: var(--gold-2); }
    .tier-empty { margin: 0; padding: 16px; font-size: 0.8rem; color: var(--dim); align-self: center; }
    @media (max-width: 640px) {
        .tier-row { grid-template-columns: 54px minmax(0, 1fr); }
        .tier-label .tier-badge { width: 36px; height: 43px; }
        .tier-label span { display: none; }
        .tchip { width: 74px; }
        .tart { width: 66px; height: 46px; }
    }
</style>
