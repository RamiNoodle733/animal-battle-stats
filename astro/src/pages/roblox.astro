---
// The game's official page, as one game screen: the game card on the left (Play
// on Roblox, live numbers, Discord, Roblox account linking) and a tabbed stage on
// the right (trailer, gameplay videos, codes, in-game leaderboards, questions).
// Everything game-specific comes from data/roblox-game.json (see astro/src/lib/site.js).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HoloCard from '../components/HoloCard.astro';
import AnimalImage from '../components/AnimalImage.astro';
import RobloxMark from '../components/RobloxMark.astro';
import { getAnimal, animals } from '../lib/catalog.js';
import { SITE, ROBLOX, SOCIAL, absoluteUrl } from '../lib/site.js';

const fan = ['honey-badger', 'megalodon', 'army-ant'].map(getAnimal).filter(Boolean);
const title = `Animal Battle Stats on Roblox: Collect 225 Real Animals & Battle | ${SITE.name}`;
const description = `The Animal Battle Stats Roblox game: collect all ${animals.length} real animals as holo-cards, power them up and battle across eight biome islands. Free to play, no loot boxes. ${ROBLOX.live ? 'Play now on Roblox.' : 'Coming soon to Roblox.'}`;
const discord = SOCIAL.find((item) => item.name === 'Discord');
const { trailer, screenshots } = ROBLOX;
const clips = ROBLOX.videos.map((clip) => ({ ...clip, art: clip.animal ? getAnimal(clip.animal) : null }));
const thumbCount = screenshots.length + (trailer ? 1 : 0);
// Same boards as lib/roblox-game.js; the section shows once the API has entries.
const BOARDS = [['POWER', 'Team power', 'bolt'], ['COLLECTION', 'Animals collected', 'cards'], ['WINS', 'Battles won', 'swords'], ['SHOW', 'Best show streak', 'tv']];
const TABS = [['trailer', 'tv', 'Trailer'], ['gameplay', 'swords', 'Gameplay'], ['codes', 'gift', 'Codes'], ['boards', 'trophy', 'Leaderboards'], ['faq', 'book', 'Questions']]
    .filter(([id]) => (id !== 'gameplay' || ROBLOX.videos.length) && (id !== 'codes' || ROBLOX.codes.length));
const PLAY_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>';
const faq = [
    { q: 'Is Animal Battle Stats on Roblox?', a: ROBLOX.live ? `Yes. Animal Battle Stats is live on Roblox and free to play: ${ROBLOX.gameUrl}` : 'The Animal Battle Stats game is in development for Roblox. Join the Discord or check this page for the launch.' },
    { q: 'Is it free?', a: 'Yes, it is free to play. There are no loot boxes or paid packs, and nothing you can buy makes an animal stronger.' },
    { q: 'Are the animals the same as on the website?', a: `Yes. All ${animals.length} animals, their stats and their home biomes come straight from this site, so new research here changes the game too.` },
    { q: 'What do you do in the game?', a: 'Fly your champion card across floating biome islands, fight and recruit wild animals, level them up, beat island bosses (the Ocean boss is the Megalodon), and join server-wide shows, tournaments and raids.' },
    { q: 'How do I connect my Roblox account?', a: 'Press Continue with Roblox on this page or Connect Roblox on your profile. Roblox asks you to approve it, and your profile then shows your Roblox name and your in-game stats. Roblox handles the sign-in, so this site never sees your Roblox password, and you can disconnect at any time.' }
];
const jsonLd = [
    {
        '@type': 'VideoGame',
        name: 'Animal Battle Stats',
        description,
        url: ROBLOX.gameUrl || absoluteUrl('/roblox'),
        image: absoluteUrl('/images/og/roblox.jpg'),
        genre: ['Collectible card game', 'Fighting', 'Adventure'],
        gamePlatform: ['Roblox', 'PC', 'Mac', 'iOS', 'Android', 'Xbox'],
        applicationCategory: 'Game',
        operatingSystem: 'Windows, macOS, iOS, Android, Xbox',
        playMode: ['SinglePlayer', 'MultiPlayer'],
        author: { '@id': `${SITE.url}/#organization` },
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: ROBLOX.live ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder' }
    },
    { '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
];
---

<Base title={title} description={description} path="/roblox" image="/images/og/roblox.jpg" imageAlt="Animal Battle Stats on Roblox" jsonLd={jsonLd} active="roblox" biome="ocean" seed={11}>
    <div class="rbx screen-grid" data-rbx data-shots={screenshots.length}>
        <aside class="panel rbx-card enter">
            <div class="rbx-id">
                <span class="rbx-icon"><img src="/images/logo.png" alt="" width="84" height="84" data-game-icon /></span>
                <div class="rbx-id-text">
                    <span class={`rbx-status ${ROBLOX.live ? 'is-live' : ''}`}><i></i>{ROBLOX.live ? 'Live on Roblox' : 'Coming soon'}</span>
                    <h1 class="rbx-title">Animal Battle Stats</h1>
                    <p class="rbx-by"><RobloxMark size={14} /><span>Roblox experience</span><span data-creator></span></p>
                </div>
            </div>
            <div class="rbx-cta">
                {ROBLOX.live
                    ? <a class="btn btn-play btn-lg" href={ROBLOX.playUrl} rel="noopener" target="_blank"><RobloxMark size={26} />Play on Roblox</a>
                    : <span class="btn btn-play btn-lg" aria-disabled="true"><RobloxMark size={26} />Coming soon</span>}
                {discord && <a class="btn" href={discord.url} rel="noopener" target="_blank"><Icon name="friends" size={24} />{ROBLOX.live ? 'Join the Discord' : 'Get launch news'}</a>}
            </div>
            <dl class="rbx-live" data-live-stats hidden>
                <div><dt>Playing</dt><dd data-stat="playing">–</dd></div>
                <div><dt>Visits</dt><dd data-stat="visits">–</dd></div>
                <div><dt>Favorites</dt><dd data-stat="favorites">–</dd></div>
                <div><dt>Likes</dt><dd data-stat="likes">–</dd></div>
            </dl>
            <ul class="rbx-tags" aria-label="At a glance">
                <li><Icon name="check" size={20} />Free to play</li>
                <li><Icon name="shield" size={20} />No loot boxes</li>
                <li><Icon name="paw" size={20} />{animals.length} real animals</li>
                <li><Icon name="friends" size={20} />Multiplayer</li>
            </ul>
            <div class="rbx-connect" id="connect" data-connect data-state="loading" hidden>
                <span class="cn-tile"><RobloxMark size={26} /></span>
                <span class="cn-copy"><b>Your Roblox account</b><small data-cn-note>&nbsp;</small></span>
                {/* No static href: crawlers must never start a sign-in. roblox.js sets it. */}
                <a class="btn btn-roblox btn-sm" aria-disabled="true" data-cn-btn><span data-cn-label>Connect</span></a>
            </div>
            <p class="rbx-legal"><RobloxMark size={11} />Roblox and the Roblox logo are trademarks of Roblox Corporation. Animal Battle Stats is an independent game on Roblox, not made, sponsored or endorsed by Roblox Corporation.</p>
        </aside>

        <section class="panel rbx-stage-panel enter-2">
            <div class="tabs rbx-tabs" role="tablist" aria-label="Game">
                {TABS.map(([id, icon, label], index) => (
                    <button type="button" role="tab" data-tab={id} aria-selected={index === 0 ? 'true' : 'false'} hidden={id === 'boards'} data-boards-tab={id === 'boards' ? '' : undefined}><Icon name={icon} size={22} />{label}</button>
                ))}
            </div>

            <div class="pane pane-trailer" data-pane="trailer">
                <div class="stage-box">
                    <div class="rbx-stage" data-stage data-youtube={trailer?.youtubeId || undefined} data-src={trailer?.src || undefined}>
                        {trailer ? (
                            <button class="stage-video" type="button" data-play aria-label="Play the official trailer">
                                {trailer.poster
                                    ? <img src={trailer.poster} alt="" width="1280" height="720" data-poster />
                                    : <video src={trailer.src} muted playsinline preload="metadata"></video>}
                                <span class="play-disc" set:html={PLAY_SVG} />
                                <span class="stage-label"><b>Official trailer</b></span>
                            </button>
                        ) : screenshots.length ? (
                            <img class="stage-img" src={screenshots[0].src} alt={screenshots[0].alt} width="1280" height="720" />
                        ) : (
                            <div class="stage-soon bio-ocean">
                                <div class="soon-cards" aria-hidden="true">
                                    {fan.map((animal, index) => <HoloCard animal={animal} tag="span" sizes="220px" priority={index === 1} />)}
                                </div>
                                <span class="play-disc is-off" aria-hidden="true" set:html={PLAY_SVG} />
                                <span class="stage-label"><b>Official trailer</b><span>Video pending</span></span>
                            </div>
                        )}
                    </div>
                </div>
                <div class="rbx-thumbs" data-thumbs hidden={thumbCount < 2}>
                    {trailer && (
                        <button class="thumb" type="button" data-kind="video" aria-pressed="true" aria-label="Trailer">
                            {trailer.poster ? <img src={trailer.poster} alt="" loading="lazy" width="320" height="180" data-poster /> : <video src={trailer.src} muted playsinline preload="metadata"></video>}
                            <span class="thumb-play" aria-hidden="true" set:html={PLAY_SVG} />
                        </button>
                    )}
                    {screenshots.map((shot, index) => (
                        <button class="thumb" type="button" data-kind="image" data-src={shot.src} data-alt={shot.alt} aria-pressed={!trailer && index === 0 ? 'true' : 'false'} aria-label={`Screenshot ${index + 1}`}>
                            <img src={shot.src} alt="" loading="lazy" width="320" height="180" />
                        </button>
                    ))}
                </div>
            </div>

            {clips.length > 0 && (
                <div class="pane" data-pane="gameplay" hidden>
                    <div class="clips">
                        {clips.map((clip, index) => (
                            <figure class:list={['clip', `bio-${clip.art?.biome || 'ocean'}`, { 'is-big': index === 0, 'is-pending': !clip.ready }]}>
                                {clip.src ? (
                                    <video src={clip.src} poster={clip.poster || undefined} muted loop playsinline preload="none" aria-label={clip.title} data-autoplay></video>
                                ) : clip.youtubeId ? (
                                    <button class="clip-yt" type="button" data-youtube={clip.youtubeId} aria-label={`Play: ${clip.title}`}>
                                        <img src={clip.poster} alt="" loading="lazy" width="640" height="360" data-poster />
                                        <span class="play-disc" set:html={PLAY_SVG} />
                                    </button>
                                ) : (
                                    <div class="clip-pending" aria-hidden="true">
                                        {clip.art && <span class="clip-art"><AnimalImage animal={clip.art} sizes={index === 0 ? '480px' : '240px'} alt="" class="animal-art" /></span>}
                                        <span class="play-disc is-off" set:html={PLAY_SVG} />
                                    </div>
                                )}
                                <figcaption><b>{clip.title}</b>{!clip.ready && <span class="pending-chip">Video pending</span>}</figcaption>
                            </figure>
                        ))}
                    </div>
                </div>
            )}

            {ROBLOX.codes.length > 0 && (
                <div class="pane pane-codes" data-pane="codes" hidden>
                    <ul class="codes">
                        {ROBLOX.codes.map((entry) => (
                            <li>
                                <button class="code" type="button" data-copy={entry.code} aria-label={`Copy code ${entry.code}`}>
                                    <b>{entry.code}</b>
                                    <span class="code-copy"><Icon name="check" size={18} lazy /><span>Copy</span></span>
                                </button>
                                <span class="code-reward">{entry.reward}</span>
                                {entry.ends && <small>Until {new Date(`${entry.ends}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</small>}
                            </li>
                        ))}
                    </ul>
                    <p class="plate"><Icon name="gear" size={24} /><span>Tap a code to copy it, then in the game open <b>Settings</b>, then <b>Codes</b>, and paste it.</span></p>
                </div>
            )}

            <div class="pane" data-pane="boards" hidden>
                <div class="boards">
                    {BOARDS.map(([id, label, icon]) => (
                        <div class="board" data-board={id}>
                            <h3><Icon name={icon} size={24} lazy />{label}</h3>
                            <ol>{[1, 2, 3, 4, 5].map((rank) => <li class="is-empty"><span class="lb-rank">{rank}</span><span class="lb-name"><i></i></span><b>–</b></li>)}</ol>
                        </div>
                    ))}
                </div>
            </div>

            <div class="pane pane-faq" data-pane="faq" hidden>
                <div class="faq">{faq.map((item, index) => <details name="rbx-faq" open={index === 0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
            </div>
        </section>
    </div>
</Base>

<script>
    import '../scripts/roblox.js';
</script>

<style>
    .rbx { grid-template-columns: minmax(290px, 360px) minmax(0, 1fr); max-width: 1500px; margin: 0 auto; }

    /* ---- the game card (left) */
    .rbx-card { --trim: #3be58f; padding: clamp(12px, 2vh, 20px) 16px; gap: clamp(10px, 1.8vh, 16px); overflow: hidden; }
    .rbx-id { display: flex; align-items: center; gap: 14px; }
    .rbx-icon { flex: none; display: grid; place-items: center; width: 84px; height: 84px; overflow: hidden; background: linear-gradient(160deg, #1a2750, #070b1a); border: 1px solid var(--line-2); border-radius: 20px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12); }
    .rbx-icon :global(img) { width: 72px; height: 72px; object-fit: cover; }
    .rbx-icon :global(img).is-roblox { width: 100%; height: 100%; }
    .rbx-id-text { display: grid; gap: 5px; min-width: 0; }
    .rbx-status { display: inline-flex; align-items: center; gap: 7px; justify-self: start; padding: 3px 10px; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-2); background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.35); border-radius: 999px; }
    .rbx-status i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; animation: pulse 2s ease-out infinite; }
    .rbx-status.is-live { color: #7cf5b4; background: rgba(53, 220, 143, 0.1); border-color: rgba(53, 220, 143, 0.45); }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 60%, transparent); } 100% { box-shadow: 0 0 0 9px transparent; } }
    .rbx-title { margin: 0; font-family: var(--font-display); font-size: clamp(1.6rem, 2.2vw, 2.1rem); font-weight: 900; line-height: 0.92; letter-spacing: 0.02em; text-transform: uppercase; transform: skewX(-6deg); transform-origin: left bottom; text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45); }
    .rbx-by { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; margin: 0; font-size: 0.78rem; font-weight: 600; color: var(--muted); }
    .rbx-by span { white-space: nowrap; }
    .rbx-by :global(.rbx-mark) { color: var(--text-2); }
    .rbx-cta { display: grid; gap: 8px; }
    .rbx-cta .btn-lg { min-height: clamp(54px, 8vh, 68px); font-size: clamp(1.3rem, 2.4vh, 1.6rem); }
    .rbx-live { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; margin: 0; }
    .rbx-live[hidden] { display: none; }
    .rbx-live div { padding: 7px 10px; background: rgba(4, 7, 18, 0.65); border: 1px solid var(--line); border-radius: 10px; }
    .rbx-live dt { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
    .rbx-live dd { margin: 2px 0 0; font-family: var(--font-display); font-size: 1.5rem; font-weight: 900; line-height: 1; }
    .rbx-tags { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; margin: 0; padding: 0; list-style: none; }
    .rbx-tags li { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 700; color: var(--text-2); white-space: nowrap; }
    .rbx-tags :global(img) { flex: none; }
    .rbx-connect { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px 10px; background: rgba(4, 7, 18, 0.65); border: 1px solid var(--line-2); border-radius: 12px; }
    .rbx-connect[hidden] { display: none; }
    .cn-tile { display: grid; place-items: center; width: 40px; height: 40px; color: #fff; background: linear-gradient(160deg, #3a3d44, #0d0e10); border-radius: 10px; }
    .cn-copy { display: grid; min-width: 0; }
    .cn-copy b { font-size: 0.84rem; }
    .cn-copy small { font-size: 0.7rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cn-copy :global(a) { color: var(--cyan-2); text-decoration: underline; text-underline-offset: 2px; }
    .rbx-connect[data-state="linked"] { border-color: rgba(53, 220, 143, 0.5); }
    .rbx-connect[data-state="loading"] [data-cn-btn] { opacity: 0.6; }
    .rbx-legal { display: flex; align-items: flex-start; gap: 5px; margin: auto 0 0; font-size: 0.64rem; line-height: 1.35; color: var(--dim); }
    .rbx-legal :global(.rbx-mark) { flex: none; margin-top: 2px; }

    /* ---- the stage (right) */
    .rbx-stage-panel { min-height: 0; }
    .pane { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding: clamp(10px, 1.8vh, 18px) clamp(10px, 1.4vw, 18px); }
    .pane[hidden] { display: none; }
    .plate { display: flex; align-items: center; gap: 10px; margin: 0; padding: 10px 14px; font-size: 0.86rem; color: var(--text-2); background: rgba(3, 6, 16, 0.55); border: 1px solid var(--line); border-radius: 10px; }
    .plate :global(img) { flex: none; }
    .plate b { color: var(--text); }

    /* shared video bits: play disc and labels (also used by roblox.js) */
    .rbx :global(.play-disc) { position: relative; z-index: 2; display: grid; place-items: center; width: clamp(56px, 8vw, 92px); aspect-ratio: 1; color: #fff; background: rgba(8, 12, 26, 0.55); border: 2px solid rgba(255, 255, 255, 0.85); border-radius: 50%; backdrop-filter: blur(6px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); transition: transform 0.2s var(--spring), background 0.2s; }
    .rbx :global(.play-disc svg) { width: 44%; margin-left: 6%; }
    .rbx :global(button:hover > .play-disc) { transform: scale(1.08); background: #10a95c; border-color: #fff; }
    .rbx :global(.play-disc.is-off) { z-index: 3; opacity: 0.9; }

    /* trailer: the 16:9 stage as big as the pane allows */
    .stage-box { flex: 1; min-height: 0; display: grid; place-items: center; container-type: size; }
    .rbx-stage { position: relative; width: min(100cqw, 100cqh * 16 / 9); aspect-ratio: 16 / 9; overflow: hidden; background: #03050c; border: 1px solid var(--line-2); border-radius: 14px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.5); }
    .rbx-stage :global(.stage-img), .rbx-stage :global(iframe), .rbx-stage :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; background: #000; }
    .rbx-stage :global(.stage-video) { position: absolute; inset: 0; display: grid; place-items: center; padding: 0; background: none; border: 0; cursor: pointer; }
    .rbx-stage :global(.stage-video img), .rbx-stage :global(.stage-video video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease), filter 0.3s; }
    .rbx-stage :global(.stage-video:hover img) { transform: scale(1.02); filter: brightness(0.85); }
    .rbx-stage :global(.stage-label) { position: absolute; left: 16px; bottom: 14px; z-index: 2; display: grid; gap: 1px; text-align: left; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8); }
    .rbx-stage :global(.stage-label b) { font-family: var(--font-display); font-size: 1.35rem; font-weight: 900; letter-spacing: 0.04em; text-transform: uppercase; }
    .rbx-stage :global(.stage-label span) { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-2); }
    .stage-soon { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(70% 80% at 50% 45%, color-mix(in srgb, var(--bio-glow) 34%, transparent), transparent 70%), linear-gradient(180deg, var(--bio-sky), #040712 88%); }
    .stage-soon::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3, 5, 12, 0.15), rgba(3, 5, 12, 0.35) 55%, rgba(3, 5, 12, 0.85)); pointer-events: none; }
    /* The bottom fifth stays clear for the label. */
    .soon-cards { position: absolute; inset: 6% 0 21%; display: flex; justify-content: center; align-items: center; }
    .soon-cards :global(.card) { height: 100%; width: auto; margin: 0 -3%; pointer-events: none; }
    .soon-cards :global(.card:nth-child(1)) { transform: rotate(-10deg) translateY(6%) scale(0.86); }
    .soon-cards :global(.card:nth-child(2)) { z-index: 2; }
    .soon-cards :global(.card:nth-child(3)) { transform: rotate(10deg) translateY(6%) scale(0.86); }
    .rbx-thumbs { flex: none; display: flex; justify-content: center; gap: 10px; }
    .rbx-thumbs[hidden] { display: none; }
    .rbx-thumbs :global(.thumb) { position: relative; flex: 0 1 150px; display: block; aspect-ratio: 16 / 9; overflow: hidden; padding: 0; background: #070b1a; border: 1px solid var(--line-2); border-radius: 10px; cursor: pointer; transition: transform 0.15s var(--ease), border-color 0.15s, box-shadow 0.15s; }
    .rbx-thumbs :global(.thumb img), .rbx-thumbs :global(.thumb video) { width: 100%; height: 100%; object-fit: cover; }
    .rbx-thumbs :global(.thumb:hover) { transform: translateY(-2px); border-color: rgba(255, 255, 255, 0.5); }
    .rbx-thumbs :global(.thumb[aria-pressed="true"]) { border-color: #fff; box-shadow: 0 0 0 2px #fff; }
    .rbx-thumbs :global(.thumb-play) { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; background: rgba(0, 0, 0, 0.25); }
    .rbx-thumbs :global(.thumb-play svg) { width: 30%; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6)); }

    /* gameplay: a fitted 3x3 wall, the first clip big */
    .clips { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .clip { position: relative; margin: 0; min-height: 0; overflow: hidden; background: #03050c; border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45); }
    .clip.is-big { grid-column: span 2; grid-row: span 2; }
    .clip > video, .clip :global(iframe), .clip-yt :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
    .clip-yt { position: absolute; inset: 0; display: grid; place-items: center; padding: 0; background: none; border: 0; cursor: pointer; }
    .clip-pending { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(70% 80% at 50% 40%, color-mix(in srgb, var(--bio-glow) 38%, transparent), transparent 72%), linear-gradient(180deg, var(--bio-sky), #040712 90%); }
    .clip-art { position: absolute; inset: 8% 10% 26%; display: grid; place-items: center; container-type: size; opacity: 0.8; }
    .clip-art :global(.animal-art) { --fit: 0.95; filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.6)); }
