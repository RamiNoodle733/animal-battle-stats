---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RobloxMark from '../components/RobloxMark.astro';
import { PAIRS } from '../lib/matchups.js';
import { SITE, ROBLOX, SOCIAL, absoluteUrl } from '../lib/site.js';

const title = `Community: Animal Debates, Votes & Leaderboards | ${SITE.name}`;
const description = 'Join the Animal Battle Stats community: debate who would win, vote on the strongest animals, climb the player leaderboard and follow the Animal Battle Stats Roblox game.';
const jsonLd = [{ '@type': 'WebPage', url: absoluteUrl('/community'), name: 'Animal Battle Stats community', description, isPartOf: { '@id': `${SITE.url}/#website` } }];
const classics = PAIRS.filter((pair) => pair.classic).slice(0, 12);
const discord = SOCIAL.find((item) => item.name === 'Discord');
const FEATURE_ICONS = ['cards', 'map', 'burst', 'tv', 'bolt', 'shield'];
---

<Base title={title} description={description} path="/community" jsonLd={jsonLd} active="community" biome="jungle" seed={21}>
    <h1 class="visually-hidden">Animal Battle Stats community</h1>
    <div class="hub" data-hub data-view="arena">
        <nav class="hub-views" aria-label="Community views">
            <button type="button" class="hv" data-view-tab="arena" aria-pressed="true"><Icon name="friends" size={26} /><b>Arena</b><small>Talk, trending, players</small></button>
            <button type="button" class="hv" data-view-tab="stats" aria-pressed="false"><Icon name="map" size={26} /><b>World stats</b><small>Visits, places, activity</small></button>
            <span class="online-pill" data-online-pill hidden><i></i><b data-online-count>0</b> online now</span>
        </nav>
        <nav class="hub-tabs tabs" aria-label="Community sections">
            <button type="button" aria-selected="true" data-hub-tab="talk"><Icon name="friends" size={22} />Talk</button>
            <button type="button" aria-selected="false" data-hub-tab="trending"><Icon name="fire" size={22} />Trending</button>
            <button type="button" aria-selected="false" data-hub-tab="players"><Icon name="medal" size={22} />Players</button>
            <button type="button" aria-selected="false" data-hub-tab="stats"><Icon name="map" size={22} />Stats</button>
            <button type="button" aria-selected="false" data-hub-tab="roblox"><RobloxMark size={18} />Roblox</button>
        </nav>

        <div class="hub-arena" data-view-pane="arena">
            <section class="panel talk" data-col="talk" aria-labelledby="talk-title">
                <div class="panel-head"><Icon name="friends" size={28} /><h2 id="talk-title" class="panel-title">The Arena</h2><span class="aside">Debate anything animal</span></div>
                <form class="composer" data-composer>
                    <label class="visually-hidden" for="msg">Your message</label>
                    <textarea id="msg" maxlength="500" rows="2" placeholder="Who would win: 100 army ants or one honey badger?" data-msg></textarea>
                    <div class="composer-row">
                        <span class="small muted" data-composer-note>Be kind. 500 characters max.</span>
                        <button class="btn btn-cyan btn-sm" type="submit" data-post><Icon name="arrow" size={20} />Post</button>
                    </div>
                </form>
                <div class="feed scroll" data-talk-feed aria-live="polite">
                    {Array.from({ length: 5 }, () => <div class="msg skeleton-msg"><span></span><p></p></div>)}
                </div>
            </section>

            <section class="panel mid" aria-label="Trending and players">
                <div class="tabs" role="tablist">
                    <button type="button" role="tab" aria-selected="true" data-mid-tab="trending"><Icon name="fire" size={20} />Trending</button>
                    <button type="button" role="tab" aria-selected="false" data-mid-tab="leaders"><Icon name="trophy" size={20} />Leaders</button>
                    <button type="button" role="tab" aria-selected="false" data-mid-tab="comments"><Icon name="book" size={20} />Comments</button>
                    <button type="button" role="tab" aria-selected="false" data-mid-tab="players"><Icon name="medal" size={20} />Players</button>
                </div>
                <div class="mid-pane scroll" data-mid="trending" data-col="trending">
                    <h3 class="sub-h">Fan favorites</h3>
                    <ol class="fav-list" data-favs><li class="muted small">Loading votes…</li></ol>
                    <h3 class="sub-h">Hot matchups</h3>
                    <div class="match-chips">{classics.map((pair) => <a class="chip" href={`/compare/${pair.slug}`}>{pair.a.name} vs {pair.b.name}</a>)}</div>
                </div>
                <div class="mid-pane scroll" data-mid="leaders" hidden>
                    <div class="leaders" data-leaders><p class="muted small">Loading animal records…</p></div>
                </div>
                <div class="mid-pane scroll" data-mid="comments" hidden>
                    <div class="feed" data-comment-feed><p class="muted small">Loading comments…</p></div>
                    <button class="btn btn-sm more-btn" type="button" data-comments-more hidden>Load more</button>
                </div>
                <div class="mid-pane scroll" data-mid="players" data-col="players" hidden>
                    <ol class="players" data-players><li class="muted small">Loading players…</li></ol>
                    <p class="small muted">Earn XP and BattlePoints by calling fights, voting on animals, running tournaments and posting.</p>
                </div>
            </section>

            <aside class="side" data-col="roblox">
                <section class="panel hot rbx-panel">
                    <div class="panel-head"><span class="rbx-tile"><RobloxMark size={18} /></span><h2 class="panel-title">Roblox game</h2><span class="aside" data-rbx-status>{ROBLOX.live ? 'Live' : 'Coming soon'}</span></div>
                    <div class="panel-body">
                        <div class="rbx-stats" data-rbx-stats hidden>
                            <div><b data-rs="playing">–</b><span>Playing</span></div>
                            <div><b data-rs="visits">–</b><span>Visits</span></div>
                            <div><b data-rs="favorites">–</b><span>Favorites</span></div>
                        </div>
                        <p class="small rbx-copy" data-rbx-copy>{ROBLOX.pitch}{ROBLOX.live ? '' : ' Game leaderboards show up here at launch.'}</p>
                        <div class="rbx-boards" data-rbx-boards></div>
                        <ul class="rbx-feats">
                            {ROBLOX.features.map((feature, index) => (
                                <li><Icon name={FEATURE_ICONS[index % FEATURE_ICONS.length]} size={26} lazy /><span><b>{feature.title}</b><span>{feature.text}</span></span></li>
                            ))}
                        </ul>
                        <div class="btn-row">
                            {ROBLOX.live
                                ? <a class="btn btn-play btn-sm" href={ROBLOX.playUrl} rel="noopener" target="_blank"><RobloxMark size={18} />Play</a>
                                : <a class="btn btn-white btn-sm" href="/roblox"><RobloxMark size={18} />The game</a>}
                            {discord && <a class="btn btn-sm" href={discord.url} rel="noopener" target="_blank">Discord</a>}
                        </div>
                    </div>
                </section>
                <section class="panel gold stats-panel">
                    <div class="panel-head"><Icon name="trophy" size={28} /><h2 class="panel-title">By the numbers</h2><button class="aside link-btn" type="button" data-view-tab="stats">All stats</button></div>
                    <div class="panel-body big-nums">
                        <div><b data-ss="totalUsers">–</b><span>Members</span></div>
                        <div><b data-ss="totalVisits">–</b><span>Site visits</span></div>
                        <div><b data-ss="totalVotes">–</b><span>Votes cast</span></div>
                        <div><b data-ss="totalComments">–</b><span>Comments</span></div>
                    </div>
                </section>
            </aside>
        </div>

        <div class="stats-view" data-view-pane="stats" data-stats-show="live" hidden>
            <nav class="stats-tabs tabs" aria-label="Stats sections">
                <button type="button" aria-selected="true" data-stats-tab="live"><Icon name="bolt" size={20} />Live</button>
                <button type="button" aria-selected="false" data-stats-tab="world"><Icon name="map" size={20} />World</button>
                <button type="button" aria-selected="false" data-stats-tab="intel"><Icon name="scroll" size={20} />Details</button>
            </nav>

            <section class="panel gold st-live" data-st-panel="live" aria-labelledby="st-live-title">
                <div class="panel-head"><Icon name="bolt" size={28} /><h2 id="st-live-title" class="panel-title">Live</h2><span class="aside" data-st-updated>Loading</span></div>
                <div class="st-body">
                    <div class="now">
                        <span class="now-dot" aria-hidden="true"></span>
                        <b data-st-online>–</b>
                        <span><small>Online now</small><em data-st-online-split>&nbsp;</em></span>
                    </div>
                    <ul class="online-list scroll" data-st-online-list></ul>
                    <h3 class="sub-h">All time</h3>
                    <div class="nums">
                        <div><b data-ss="totalUsers">–</b><span>Members</span></div>
                        <div><b data-ss="totalVisits">–</b><span>Site visits</span></div>
                        <div><b data-sg="pageViews">–</b><span>Page views</span></div>
                        <div><b data-ss="totalVotes">–</b><span>Votes cast</span></div>
                        <div><b data-ss="totalComparisons">–</b><span>Fights compared</span></div>
                        <div><b data-ss="totalComments">–</b><span>Comments</span></div>
                        <div><b data-ss="totalTournaments">–</b><span>Tournaments</span></div>
                        <div><b data-ss="totalMatches">–</b><span>Bracket fights</span></div>
                    </div>
                </div>
            </section>

            <section class="panel st-world" data-st-panel="world" aria-labelledby="st-world-title">
                <div class="panel-head"><Icon name="map" size={28} /><h2 id="st-world-title" class="panel-title">World</h2><span class="aside">Drag to spin, tap a light</span></div>
                <div class="w-globe" data-globe>
                    <canvas aria-label="Globe showing where Animal Battle Stats visitors come from" role="img"></canvas>
                    <div class="w-tip" data-w-tip hidden></div>
                </div>
                <div class="w-strip">
                    <div><b data-sg="uniqueVisitors">–</b><span>Visitors</span></div>
                    <div><b data-sg="totalVisits">–</b><span>Visits</span></div>
                    <div><b data-sg="totalEvents">–</b><span>Events</span></div>
                    <div><b data-sg="places">–</b><span>Places</span></div>
                    <div><b data-sg="countries">–</b><span>Countries</span></div>
                </div>
                <div class="w-windows">
                    <span><b data-sw="last24h">–</b>events today</span>
                    <span><b data-sw="last7d">–</b>this week</span>
                    <span><b data-sw="last30d">–</b>this month</span>
                    <span class="pace" data-sw-pace-box><b data-sw="pace">–</b>weekly pace</span>
                </div>
            </section>

            <section class="panel hot st-intel" data-st-panel="intel" aria-label="Activity details">
                <div class="tabs" role="tablist">
                    <button type="button" role="tab" aria-selected="true" data-ip-tab="activity"><Icon name="bolt" size={20} />Activity</button>
                    <button type="button" role="tab" aria-selected="false" data-ip-tab="places"><Icon name="compass" size={20} />Places</button>
                    <button type="button" role="tab" aria-selected="false" data-ip-tab="pages"><Icon name="book" size={20} />Pages</button>
                    <button type="button" role="tab" aria-selected="false" data-ip-tab="events" data-owner-only hidden><Icon name="shield" size={20} />Events</button>
                </div>

                <div class="ip" data-ip="activity">
                    <div class="ip-row">
                        <div class="seg range" data-range>
                            <button type="button" aria-pressed="false" data-r="14d">14D</button>
                            <button type="button" aria-pressed="true" data-r="30d">30D</button>
                            <button type="button" aria-pressed="false" data-r="90d">90D</button>
                            <button type="button" aria-pressed="false" data-r="365d">12M</button>
                            <button type="button" aria-pressed="false" data-r="all">All</button>
                        </div>
                        <span class="legend"><i class="lg-ev"></i>Events<i class="lg-vi"></i>Visits</span>
                    </div>
                    <div class="chart" data-chart><p class="muted small">Loading activity…</p></div>
                    <div class="insights">
                        <div><small>Most active place</small><b data-in="place">–</b><span data-in="place-n"></span></div>
                        <div><small>Top country</small><b data-in="country">–</b><span data-in="country-n"></span></div>
                        <div><small>Busiest page</small><b data-in="page">–</b><span data-in="page-n"></span></div>
                        <div><small>Best day</small><b data-in="day">–</b><span data-in="day-n"></span></div>
                    </div>
                </div>

                <div class="ip" data-ip="places" hidden>
                    <div class="places-list" data-places-list>
                        <div class="ip-row">
                            <label class="field place-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg><input type="search" placeholder="Search places" aria-label="Search places" data-place-q /></label>
                            <span class="small muted" data-place-count></span>
                        </div>
                        <ol class="bars scroll" data-places><li class="muted small">Loading places…</li></ol>
                    </div>
                    <div class="place-detail scroll" data-place-detail hidden></div>
                </div>

                <div class="ip ip-pages scroll" data-ip="pages" hidden>
                    <section><h3 class="sub-h">Top pages</h3><ol class="bars" data-top-pages></ol></section>
                    <section><h3 class="sub-h">Top actions</h3><ol class="bars" data-top-actions></ol></section>
                    <section><h3 class="sub-h">Top countries</h3><ol class="bars" data-top-countries></ol></section>
                </div>

                <div class="ip" data-ip="events" hidden>
                    <form class="ev-filters" data-ev-filters>
                        <select class="ev-select" name="eventType" aria-label="Event type">
                            <option value="">All events</option>
                            <option value="site_visit">Page views</option>
                            <option value="site_leave">Site exits</option>
                            <option value="login">Logins</option>
                            <option value="signup">Signups</option>
                            <option value="vote">Votes</option>
                            <option value="fight">Fights</option>
                            <option value="comment">Comments</option>
                            <option value="chat_message">Chat</option>
                            <option value="tournament_complete">Tournaments</option>
                            <option value="level_up">Level ups</option>
                        </select>
                        <select class="ev-select" name="deliveryStatus" aria-label="Discord delivery">
                            <option value="">Any Discord status</option>
                            <option value="sent">Sent</option>
                            <option value="pending">Pending</option>
                            <option value="failed">Failed</option>
                        </select>
                        <input class="ev-select" name="user" type="search" placeholder="Player" aria-label="Player" />
                    </form>
                    <ol class="ev-list scroll" data-ev-list></ol>
                    <div class="ev-foot"><button class="btn btn-sm" type="button" data-ev-more hidden>Load more</button><button class="btn btn-sm" type="button" data-ev-retry hidden>Retry failed Discord posts</button></div>
                </div>
            </section>
        </div>
    </div>
</Base>

<script>
    import '../scripts/community.js';
</script>

<style>
    .hub { height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 10px; max-width: 1600px; margin: 0 auto; }
    .hub-tabs { display: none; }

    /* view switch: Arena / World stats */
    .hub-views { display: flex; align-items: center; gap: 8px; }
    .hv {
        --c1: #22325f; --c2: #131d3d; --edge: #080d20;
        display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; column-gap: 10px; align-items: center;
        padding: 6px 22px 7px 16px; border: 0; color: var(--text); text-align: left; font: inherit; cursor: pointer;
        background: linear-gradient(180deg, var(--c1), var(--c2));
        clip-path: polygon(12px 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
        box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.16), inset 0 -4px 0 var(--edge);
        transition: filter 0.15s;
    }
    .hv:hover { filter: brightness(1.15); }
    .hv[aria-pressed="true"] { --c1: #ffa24d; --c2: #ff5f00; --edge: #a13a00; color: #1d0800; }
    .hv :global(img) { grid-row: 1 / 3; }
    .hv b { font-family: var(--font-display); font-size: 1.2rem; font-weight: 900; line-height: 1; letter-spacing: 0.04em; text-transform: uppercase; transform: skewX(-6deg); }
    .hv small { font-size: 0.68rem; color: var(--text-2); }
    .hv[aria-pressed="true"] small { color: #3b1500; }
    .online-pill { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; font-size: 0.8rem; font-weight: 700; color: var(--text-2); background: rgba(4, 7, 18, 0.7); border: 1px solid rgba(53, 220, 143, 0.45); border-radius: 999px; }
    .online-pill[hidden] { display: none; }
    .online-pill i, .now-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(53, 220, 143, 0.6); animation: live 2s ease-out infinite; }
    .online-pill b { font-family: var(--font-display); font-size: 1.1rem; color: #fff; }
    @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(53, 220, 143, 0.6); } 100% { box-shadow: 0 0 0 10px rgba(53, 220, 143, 0); } }

    .hub-arena { min-height: 0; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(280px, 0.8fr); gap: 12px; }
    .hub-arena[hidden], .stats-view[hidden] { display: none; }
    .talk, .mid { min-height: 0; }
    .composer { padding: 10px 14px; border-bottom: 1px solid var(--line); }
    .composer textarea { width: 100%; resize: none; padding: 10px 12px; background: rgba(3, 6, 16, 0.6); border: 1px solid var(--line-2); border-radius: 10px; color: var(--text); font: inherit; }
    .composer textarea:focus { outline: none; border-color: var(--cyan); }
    .composer-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 6px; }
    .feed { flex: 1; min-height: 0; padding: 10px 14px; display: grid; gap: 8px; align-content: start; }
    .mid-pane { flex: 1; min-height: 0; padding: 12px 14px; }
    .mid-pane .feed { padding: 0; }
    .more-btn { display: flex; margin: 10px auto 0; }
    .more-btn[hidden] { display: none; }
    .sub-h { margin: 4px 0 8px; font-family: var(--font-display); font-size: 1.1rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-2); }
    .fav-list, .players { margin: 0 0 14px; padding: 0; list-style: none; display: grid; gap: 6px; }
    .match-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .match-chips .chip:hover { border-color: var(--orange); color: var(--orange-2); }
    .side { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 12px; min-height: 0; }
    .rbx-panel { min-height: 0; }
    .rbx-tile { flex: none; display: grid; place-items: center; width: 30px; height: 30px; color: #fff; background: linear-gradient(160deg, #3a3d44, #0d0e10); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; }
    .hub-tabs :global(.rbx-mark) { width: 18px; height: 18px; }
    .rbx-panel .panel-body { overflow-y: auto; }
    .rbx-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .big-nums { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .stats-panel .link-btn { margin-left: auto; }
    .rbx-feats { margin: 0 0 12px; padding: 0; list-style: none; display: grid; gap: 8px; }
    .rbx-feats li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; align-items: start; }
    .rbx-feats b { display: block; font-family: var(--font-display); font-size: 1rem; font-weight: 900; letter-spacing: 0.03em; text-transform: uppercase; }
    .rbx-feats li > span > span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.78rem; color: var(--text-2); }
    .rbx-stats div, .big-nums div, .nums div, .w-strip div { display: flex; flex-direction: column; padding: 8px 10px; background: rgba(3, 6, 16, 0.5); border: 1px solid var(--line); border-radius: 8px; min-width: 0; }
    .rbx-stats b, .big-nums b, .nums b { font-family: var(--font-display); font-size: 1.7rem; font-weight: 900; line-height: 1; }
    .rbx-stats span, .big-nums span, .nums span, .w-strip span { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rbx-copy { color: var(--text-2); margin: 10px 0; }
    .rbx-boards { display: grid; gap: 8px; margin-bottom: 12px; }

    /* leaders (animal records from /api/rankings) */
    .leaders { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
    .leaders :global(.rec) { padding: 10px 12px; background: rgba(3, 6, 16, 0.45); border: 1px solid var(--line); border-radius: 10px; }
    .leaders :global(.rec h4) { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-family: var(--font-display); font-size: 1rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: var(--orange-2); }
    .leaders :global(.rec ol) { margin: 0; padding: 0; list-style: none; display: grid; gap: 3px; }
    .leaders :global(.rec li) { display: grid; grid-template-columns: 18px 30px minmax(0, 1fr) auto; align-items: center; gap: 6px; font-size: 0.84rem; }
    .leaders :global(.rec li > span:first-child) { font-family: var(--font-display); font-weight: 900; color: var(--muted); text-align: center; }
    .leaders :global(.rec li img) { width: 30px; height: 24px; object-fit: contain; }
    .leaders :global(.rec li a) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
    .leaders :global(.rec li a:hover) { color: var(--cyan-2); }
    .leaders :global(.rec li b) { font-family: var(--font-display); font-weight: 900; color: var(--gold-2); white-space: nowrap; }
    .leaders :global(.rec li b.down) { color: var(--red); }
    .leaders :global(.rec li b.up) { color: var(--green); }

    /* ---------------------------------------------------------------- world stats */
    .stats-view { min-height: 0; display: grid; grid-template-columns: minmax(250px, 0.78fr) minmax(0, 1.2fr) minmax(320px, 1.05fr); gap: 12px; }
    .stats-tabs { display: none; }
    .st-live, .st-world, .st-intel { min-height: 0; }
    .st-body { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; }
    .now { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: linear-gradient(180deg, rgba(53, 220, 143, 0.14), rgba(3, 6, 16, 0.5)); border: 1px solid rgba(53, 220, 143, 0.45); border-radius: 12px; }
    .now b { font-family: var(--font-display); font-size: 2.8rem; font-weight: 900; line-height: 0.9; }
    .now small { display: block; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #86f2c2; }
    .now em { font-style: normal; font-size: 0.8rem; color: var(--text-2); }
    .online-list { flex: 1 1 60px; min-height: 0; margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; align-content: start; }
