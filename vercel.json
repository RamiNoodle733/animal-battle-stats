{
  "version": 2,
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-ignore-research.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/site-activity_xV4PFzoF89",
      "destination": "/api/community?action=gone"
    },
    {
      "source": "/site-activity_xV4PFzoF89/:path*",
      "destination": "/api/community?action=gone"
    },
    {
      "source": "/api/admin/analytics",
      "destination": "/api/community?action=admin-analytics"
    },
    {
      "source": "/api/admin/discord-retry",
      "destination": "/api/community?action=admin-retry-discord"
    },
    {
      "source": "/api/cron/discord-retry",
      "destination": "/api/community?action=discord-retry-cron"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/profile",
      "destination": "/app"
    },
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/signup",
      "destination": "/app"
    },
    {
      "source": "/forgot-password",
      "destination": "/app"
    },
    {
      "source": "/reset-password",
      "destination": "/app"
    },
    {
      "source": "/battlepoints",
      "destination": "/app"
    },
    {
      "source": "/profile/:username",
      "destination": "/app"
    },
    {
      "source": "/community/:tab",
      "destination": "/community"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/discord-retry",
      "schedule": "17 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/battle",
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/methodology",
      "destination": "/about#model",
      "permanent": true
    }
  ]
}
