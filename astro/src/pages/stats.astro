---
// /stats: the Animal Database (every animal, every ranking; see AnimalDatabase.astro).
import Base from '../layouts/Base.astro';
import AnimalDatabase from '../components/AnimalDatabase.astro';
import { animals } from '../lib/catalog.js';
import { SITE, absoluteUrl } from '../lib/site.js';

const title = `Animal Rankings & Stats Database: Strongest, Fastest & Heaviest of ${animals.length} Animals | ${SITE.name}`;
const description = `Rank ${animals.length} real animals by power, attack, defense, agility, stamina, intelligence, special, weight, top speed, length, bite force and fan votes. One sortable table, filters for mammals, birds, reptiles, sea creatures and bugs.`;
const jsonLd = [
    {
        '@type': 'CollectionPage',
        url: absoluteUrl('/stats'),
        name: 'Animal stats database',
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        mainEntity: {
            '@type': 'ItemList',
            name: 'Animals ranked by power index',
            numberOfItems: animals.length,
            itemListOrder: 'https://schema.org/ItemListOrderDescending',
            itemListElement: animals.map((animal) => ({ '@type': 'ListItem', position: animal.rank, name: animal.name, url: absoluteUrl(`/stats/${animal.slug}`) }))
        }
    }
];
---

<Base title={title} description={description} path="/stats" jsonLd={jsonLd} active="animals">
    <AnimalDatabase />
</Base>
