    sort: '<path d="M8 4v16M4.5 16.5L8 20l3.5-3.5M16 20V4M12.5 7.5L16 4l3.5 3.5"/>',
    ruler: '<path d="M3.5 15.5l12-12 5 5-12 12z"/><path d="M7 12l2 2M10 9l2 2M13 6l2 2"/>',
    random: '<path d="M4 7h3.5c4.5 0 5 10 9.5 10H20M4 17h3.5c1.6 0 2.7-1.3 3.6-3M20 7h-3c-1.6 0-2.7 1.3-3.6 3M17.5 4.5L20 7l-2.5 2.5M17.5 14.5L20 17l-2.5 2.5"/>'
