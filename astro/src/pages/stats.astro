---
// The Animal Database: every animal in one sortable table (the FUTBIN /
// Showdown dex idea), with a Cards view, fast filters and a two-pick compare
// tray. The table is plain HTML, so search engines and AI assistants can read
// every rating without running scripts.
import Base from '../layouts/Base.astro';
import UiIcon from '../components/UiIcon.astro';
import { animals, GROUPS, TIERS, STATS, researchedCount, fmtScore, fmtWeight, fmtSpeed } from '../lib/catalog.js';
import { SITE, absoluteUrl } from '../lib/site.js';

const title = `Animal Stats Database: Compare ${animals.length} Animals by Strength, Speed & Power | ${SITE.name}`;
const description = `Sortable battle stats for ${animals.length} real animals: power index, attack, defense, agility, stamina, intelligence, special, weight and top speed. Filter by mammals, birds, reptiles, sea creatures and bugs.`;
const jsonLd = [
    {
        '@type': 'CollectionPage',
        url: absoluteUrl('/stats'),
        name: 'Animal stats database',
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        mainEntity: {
            '@type': 'ItemList',
            name: 'Animals ranked by power index',
            numberOfItems: animals.length,
            itemListOrder: 'https://schema.org/ItemListOrderDescending',
            itemListElement: animals.map((animal) => ({ '@type': 'ListItem', position: animal.rank, name: animal.name, url: absoluteUrl(`/stats/${animal.slug}`) }))
        }
    }
];
const SORTS = [
    ['rank', 'Power rank'], ['name', 'Name A–Z'],
    ...STATS.map((stat) => [stat.key, stat.label]),
    ['weight', 'Weight'], ['speed', 'Top speed']
];
const short = (value) => (value ? value.metric.replace(/\s*\(.*\)$/, '') : '—');
---

<Base title={title} description={description} path="/stats" jsonLd={jsonLd} active="animals">
    <div class="db screen-grid">
        <section class="panel dbp" aria-labelledby="db-title" data-db data-sort="rank" data-view="table">
            <header class="db-head">
                <div class="db-title">
                    <h1 id="db-title" class="panel-title">Animal Database</h1>
                    <span class="db-count" data-count aria-live="polite">{animals.length} animals</span>
                </div>
                <label class="field db-search">
                    <UiIcon name="search" size={17} />
                    <span class="visually-hidden">Search animals</span>
                    <input type="search" placeholder="Search by name or species" data-q autocomplete="off" spellcheck="false" />
                </label>
                <div class="seg db-view" role="group" aria-label="View">
                    <button type="button" aria-pressed="true" data-view-btn="table"><UiIcon name="rows" size={16} /><span>Table</span></button>
                    <button type="button" aria-pressed="false" data-view-btn="cards"><UiIcon name="grid" size={16} /><span>Cards</span></button>
                </div>
            </header>
            <div class="db-filters">
                <div class="seg db-groups" role="group" aria-label="Group">
                    <button type="button" aria-pressed="true" data-group="all">All</button>
                    {GROUPS.map((group) => <button type="button" aria-pressed="false" data-group={group.key}>{group.label.replace('Sea creatures', 'Sea').replace('Bugs & spiders', 'Bugs')}</button>)}
                </div>
                <div class="seg db-tiers" role="group" aria-label="Tier">
                    {TIERS.map((tier) => <button type="button" aria-pressed="false" data-tier={tier.id} class={`tier-${tier.id.toLowerCase()}`} title={`${tier.id} tier: ${tier.name}`}>{tier.id}</button>)}
                </div>
                <label class="field db-sort">
                    <UiIcon name="sort" size={16} />
                    <span class="visually-hidden">Sort by</span>
                    <select data-sort-select>{SORTS.map(([value, label]) => <option value={value}>{label}</option>)}</select>
                </label>
            </div>

            <div class="db-body scroll" data-scroll>
                <table class="db-table" data-table>
                    <caption class="visually-hidden">Battle stats for all {animals.length} animals: power index and six ratings from 0 to 100, with typical adult weight and top speed. {researchedCount} animals have full research profiles.</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="c-rank" aria-sort="ascending"><button type="button" data-key="rank">#</button></th>
                            <th scope="col" class="c-name"><button type="button" data-key="name">Animal</button></th>
                            <th scope="col" class="c-tier">Tier</th>
                            <th scope="col" class="c-pwr"><button type="button" data-key="rank" title="Power index">PWR</button></th>
                            {STATS.map((stat) => <th scope="col" class="c-stat" data-col={stat.key}><button type="button" data-key={stat.key} title={stat.label}><UiIcon name={stat.key} size={14} />{stat.abbr}</button></th>)}
                            <th scope="col" class="c-num" data-col="weight"><button type="button" data-key="weight">Weight</button></th>
                            <th scope="col" class="c-num" data-col="speed"><button type="button" data-key="speed">Speed</button></th>
                            <th scope="col" class="c-pick"><span class="visually-hidden">Compare</span></th>
                        </tr>
                    </thead>
                    <tbody data-rows>
                        {animals.map((animal, index) => (
                            <tr
                                data-slug={animal.slug}
                                data-name={animal.name.toLowerCase()}
                                data-sci={String(animal.scientific_name || '').toLowerCase()}
                                data-group={animal.group}
                                data-tier={animal.tier}
                                data-rank={animal.rank}
                                data-attack={animal.attack}
                                data-defense={animal.defense}
                                data-agility={animal.agility}
                                data-stamina={animal.stamina}
                                data-intelligence={animal.intelligence}
                                data-special={animal.special}
                                data-weight={animal.weight_kg || 0}
                                data-speed={animal.speed_mps || 0}
                            >
                                <td class="c-rank">{animal.rank}</td>
                                <th scope="row" class="c-name">
                                    <a href={`/stats/${animal.slug}`}>
                                        <img src={animal.img.thumb} alt="" width="46" height="36" loading={index < 14 ? 'eager' : 'lazy'} decoding="async" />
                                        <span><b>{animal.name}</b><small>{animal.class}</small></span>
                                    </a>
                                </th>
                                <td class="c-tier"><span class={`tier-badge sm tier-${animal.tier.toLowerCase()}`}>{animal.tier}</span></td>
                                <td class="c-pwr">{fmtScore(animal.powerIndex)}</td>
                                {STATS.map((stat) => {
                                    const value = Number(animal[stat.key]) || 0;
                                    return <td class="c-stat" data-col={stat.key} style={`--v:${Math.min(100, value)}`}><b>{fmtScore(value)}</b></td>;
                                })}
                                <td class="c-num" data-col="weight">{short(fmtWeight(animal.weight_kg))}</td>
                                <td class="c-num" data-col="speed">{short(fmtSpeed(animal.speed_mps))}</td>
                                <td class="c-pick"><button type="button" data-pick aria-pressed="false" aria-label={`Compare ${animal.name}`}></button></td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <div class="db-cards" data-cards hidden></div>
                <p class="empty-state" hidden data-empty>No animals match. <button type="button" class="link" data-reset>Clear filters</button></p>
            </div>

            <div class="tray" data-tray hidden>
                <div class="tray-picks" data-tray-picks></div>
                <span class="tray-hint" data-tray-hint>Pick one more to compare</span>
                <a class="btn btn-hot btn-sm" href="/compare" data-tray-go><UiIcon name="vs" size={16} /><span data-tray-label>Compare</span></a>
                <button type="button" class="hud-btn tray-clear" data-tray-clear aria-label="Clear picks"><UiIcon name="close" size={16} /></button>
            </div>
        </section>
    </div>
</Base>

<script>
    import { loadAnimalIndex, artVars, escapeHtml } from '../scripts/site.js';

    const db = document.querySelector('[data-db]');
    const tbody = db.querySelector('[data-rows]');
    const rows = [...tbody.rows];
    const bySlug = new Map(rows.map((row) => [row.dataset.slug, row]));
    const q = db.querySelector('[data-q]');
    const select = db.querySelector('[data-sort-select]');
    const count = db.querySelector('[data-count]');
    const empty = db.querySelector('[data-empty]');
    const cardsBox = db.querySelector('[data-cards]');
    const scroller = db.querySelector('[data-scroll]');
    const ASC = new Set(['rank', 'name']);
    const params = new URLSearchParams(location.search);
    const state = {
        q: params.get('q') || '',
        group: params.get('group') || 'all',
        tier: params.get('tier') ? params.get('tier').toUpperCase() : null,
        sort: params.get('sort') || 'rank',
        dir: params.get('dir') === 'asc' || params.get('dir') === 'desc' ? params.get('dir') : null,
        view: params.get('view') === 'cards' ? 'cards' : 'table'
    };
    const cards = new Map();
    const picks = [];
    q.value = state.q;

    function direction() { return state.dir || (ASC.has(state.sort) ? 'asc' : 'desc'); }

    function apply({ scrollTop = false } = {}) {
        const needle = state.q.trim().toLowerCase();
        const dir = direction() === 'asc' ? 1 : -1;
        const key = state.sort;
        const sorted = [...rows].sort((a, b) => {
            if (key === 'name') return dir * a.dataset.name.localeCompare(b.dataset.name);
            const diff = Number(a.dataset[key]) - Number(b.dataset[key]);
            return dir * diff || Number(a.dataset.rank) - Number(b.dataset.rank);
        });
        let shown = 0;
        const fragment = document.createDocumentFragment();
        const cardFragment = document.createDocumentFragment();
        for (const row of sorted) {
            const match = (!needle || row.dataset.name.includes(needle) || row.dataset.sci.includes(needle))
                && (state.group === 'all' || row.dataset.group === state.group)
                && (!state.tier || row.dataset.tier === state.tier);
            row.hidden = !match;
            if (match) shown += 1;
            fragment.appendChild(row);
            const card = cards.get(row.dataset.slug);
            if (card) { card.hidden = !match; cardFragment.appendChild(card); }
        }
        tbody.appendChild(fragment);
        if (cards.size) cardsBox.appendChild(cardFragment);
        count.textContent = shown === rows.length ? `${rows.length} animals` : `${shown} of ${rows.length}`;
        empty.hidden = shown > 0;
        db.dataset.sort = key;
        select.value = key;
        db.querySelectorAll('thead th').forEach((th) => th.removeAttribute('aria-sort'));
        const head = db.querySelector(`thead button[data-key="${key}"]`);
        head?.closest('th').setAttribute('aria-sort', direction() === 'asc' ? 'ascending' : 'descending');
        db.querySelectorAll('button[data-group]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.group === state.group)));
        db.querySelectorAll('button[data-tier]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.tier === state.tier)));
        const next = new URLSearchParams();
        if (state.q) next.set('q', state.q);
        if (state.group !== 'all') next.set('group', state.group);
        if (state.tier) next.set('tier', state.tier);
        if (key !== 'rank') next.set('sort', key);
        if (state.dir) next.set('dir', state.dir);
        if (state.view === 'cards') next.set('view', 'cards');
        history.replaceState(null, '', next.toString() ? `?${next}` : location.pathname);
        if (scrollTop) scroller.scrollTop = 0;
    }

    // ---- views: the table is in the page; cards are built once from the roster file
    async function setView(view) {
        state.view = view;
        db.dataset.view = view;
        db.querySelectorAll('[data-view-btn]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.viewBtn === view)));
        db.querySelector('[data-table]').hidden = view !== 'table';
        cardsBox.hidden = view !== 'cards';
        if (view === 'cards' && !cards.size) {
            const list = await loadAnimalIndex();
            for (const animal of list) {
                const tier = animal.tier.toLowerCase();
                const wrap = document.createElement('div');
                wrap.className = 'db-card';
                wrap.innerHTML = `<a class="card tier-${tier}" href="/stats/${animal.s}"><span class="card-inner"><span class="card-power"><b>${animal.p}</b><small>PWR</small></span><span class="card-rank">#${animal.r}</span><span class="tier-badge tier-${tier}">${animal.tier}</span><span class="card-art"><img src="${animal.m}" alt="" loading="lazy" decoding="async" style="${artVars(animal)}"></span><span class="card-plate"><span class="card-name">${escapeHtml(animal.n)}</span><span class="card-meta">${escapeHtml(animal.cls)}</span></span></span></a>`;
                cards.set(animal.s, wrap);
            }
        }
        apply({ scrollTop: true });
    }

    q.addEventListener('input', () => { state.q = q.value; apply({ scrollTop: true }); });
    select.addEventListener('change', () => { state.sort = select.value; state.dir = null; apply({ scrollTop: true }); });
    db.querySelectorAll('thead button[data-key]').forEach((button) => button.addEventListener('click', () => {
        const key = button.dataset.key;
        if (state.sort === key) state.dir = direction() === 'asc' ? 'desc' : 'asc';
        else { state.sort = key; state.dir = null; }
        apply({ scrollTop: true });
    }));
    db.querySelectorAll('button[data-group]').forEach((button) => button.addEventListener('click', () => { state.group = button.dataset.group; apply({ scrollTop: true }); }));
    db.querySelectorAll('button[data-tier]').forEach((button) => button.addEventListener('click', () => { state.tier = state.tier === button.dataset.tier ? null : button.dataset.tier; apply({ scrollTop: true }); }));
    db.querySelectorAll('[data-view-btn]').forEach((button) => button.addEventListener('click', () => setView(button.dataset.viewBtn)));
    db.querySelector('[data-reset]').addEventListener('click', () => { state.q = ''; q.value = ''; state.group = 'all'; state.tier = null; apply(); });

    // ---- compare tray: pick two animals, then open them in Versus
    const tray = db.querySelector('[data-tray]');
    function paintTray() {
        tray.hidden = picks.length === 0;
        db.classList.toggle('has-tray', picks.length > 0);
        tray.querySelector('[data-tray-picks]').innerHTML = picks.map((slug) => {
            const row = bySlug.get(slug);
            return `<span class="tray-pick"><img src="${row.querySelector('img').getAttribute('src')}" alt="">${escapeHtml(row.querySelector('b').textContent)}</span>`;
        }).join('<em>vs</em>');
        tray.querySelector('[data-tray-hint]').hidden = picks.length > 1;
        const go = tray.querySelector('[data-tray-go]');
        go.href = picks.length > 1 ? `/compare?a=${picks[0]}&b=${picks[1]}` : `/compare?a=${picks[0] || ''}`;
        tray.querySelector('[data-tray-label]').textContent = picks.length > 1 ? 'Fight' : 'Any rival';
        rows.forEach((row) => {
            const on = picks.includes(row.dataset.slug);
            row.classList.toggle('picked', on);
            row.querySelector('[data-pick]').setAttribute('aria-pressed', String(on));
        });
    }
    tray.querySelector('[data-tray-clear]').addEventListener('click', () => { picks.length = 0; paintTray(); });

    // A tap on a row opens the animal (the name is the real link); the + button picks it.
    tbody.addEventListener('click', (event) => {
        const pick = event.target.closest('[data-pick]');
        if (pick) {
            const slug = pick.closest('tr').dataset.slug;
            const at = picks.indexOf(slug);
            if (at >= 0) picks.splice(at, 1);
            else { picks.push(slug); if (picks.length > 2) picks.shift(); }
            paintTray();
            return;
        }
        if (event.target.closest('a, button')) return;
        const row = event.target.closest('tr');
        if (row) location.href = `/stats/${row.dataset.slug}`;
    });

    if (state.view === 'cards') setView('cards');
    else if (state.q || state.group !== 'all' || state.tier || state.sort !== 'rank' || state.dir) apply();
</script>

<style is:global>
    .db { max-width: 1480px; margin: 0 auto; grid-template-rows: minmax(0, 1fr); }
    .dbp { overflow: hidden; }
    .db-head { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
    .db-title { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
    .db-title .panel-title { font-size: 1.35rem; white-space: nowrap; }
    .db-count { font-size: 0.78rem; font-weight: 700; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .db-search { flex: 1 1 260px; max-width: 460px; margin-left: auto; }
    .db-filters { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
    .db-groups { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; min-width: 0; }
    .db-groups::-webkit-scrollbar { display: none; }
    .db-tiers { flex-wrap: nowrap; flex: none; }
    .db-tiers button { min-width: 32px; padding: 0 8px; }
    .db-tiers button[aria-pressed="true"] { color: #101114; background: linear-gradient(165deg, var(--tier-2), var(--tier) 45%, var(--tier-d)); }
    .db-sort { display: none; min-height: 36px; margin-left: auto; }
    .db-sort select { height: 34px; font-weight: 700; font-size: 0.86rem; }

    .db-body { flex: 1; min-height: 0; position: relative; }
    .db-table { width: 100%; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
    .db-table thead th {
        position: sticky; top: 0; z-index: 2;
        height: 38px; padding: 0 6px;
        text-align: center;
        background: #16171b;
        border-bottom: 1px solid var(--line-2);
        box-shadow: 0 6px 12px -8px rgba(0, 0, 0, 0.8);
    }
    .db-table thead button {
        display: inline-flex; align-items: center; justify-content: center; gap: 4px;
        width: 100%; min-height: 36px; padding: 0 2px;
        font-family: var(--font-display); font-size: 0.9rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
        color: var(--muted); background: none; border: 0;
    }
    .db-table thead th.c-tier { font-family: var(--font-display); font-size: 0.9rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
    .db-table thead button:hover { color: #fff; }
    .db-table thead .c-stat button { color: var(--stat); }
    .db-table th[aria-sort] button { color: #fff; }
    .db-table th[aria-sort] button::after { content: ""; border: 4px solid transparent; border-top-color: var(--gold); margin-top: 4px; }
    .db-table th[aria-sort="ascending"] button::after { border-top-color: transparent; border-bottom-color: var(--gold); margin: 0 0 4px; }
    .db-table thead .c-name { text-align: left; }
    .db-table thead .c-name button { justify-content: flex-start; padding-left: 8px; }

    .db-table tbody tr { cursor: pointer; }
    .db-table tbody td, .db-table tbody th { height: 50px; padding: 0 6px; text-align: center; border-bottom: 1px solid var(--line); font-weight: 600; }
    .db-table tbody tr:hover td, .db-table tbody tr:hover th { background: rgba(255, 255, 255, 0.035); }
    .db-table tbody tr.picked td, .db-table tbody tr.picked th { background: rgba(246, 180, 0, 0.08); }
    .c-rank { width: 46px; font-family: var(--font-display); font-size: 1.05rem; font-weight: 800; color: var(--muted); }
    .db-table .c-name { text-align: left; width: 24%; min-width: 200px; }
    .c-name a { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 4px 0; }
    .c-name img { flex: none; width: 46px; height: 36px; object-fit: contain; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.6)); }
    .c-name span { display: grid; min-width: 0; }
    .c-name b { overflow: hidden; font-size: 0.92rem; font-weight: 750; white-space: nowrap; text-overflow: ellipsis; color: #fff; }
    .c-name small { overflow: hidden; font-size: 0.7rem; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; color: var(--muted); }
    .c-name a:hover b { color: var(--gold-2); }
    .db-table tbody tr[data-rank="1"] .c-rank, .db-table tbody tr[data-rank="2"] .c-rank, .db-table tbody tr[data-rank="3"] .c-rank { color: transparent; background: url("/images/ui/medal-1.svg") center / 28px no-repeat; }
    .db-table tbody tr[data-rank="2"] .c-rank { background-image: url("/images/ui/medal-2.svg"); }
    .db-table tbody tr[data-rank="3"] .c-rank { background-image: url("/images/ui/medal-3.svg"); }
    .c-tier { width: 50px; }
    .c-tier .tier-badge { vertical-align: middle; }
    .db-table td.c-pwr { width: 64px; font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; color: #fff; }
    .c-pwr { width: 64px; }
    .c-stat { width: 64px; }
    td.c-stat b { display: block; font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; line-height: 1; color: var(--text); }
    td.c-stat b::after { content: ""; display: block; height: 3px; margin: 5px auto 0; width: 40px; border-radius: 2px; background: linear-gradient(90deg, var(--stat) calc(var(--v) * 1%), rgba(255, 255, 255, 0.1) 0); }
    .dbp [data-col="attack"] { --stat: var(--atk); }
    .dbp [data-col="defense"] { --stat: var(--def); }
    .dbp [data-col="agility"] { --stat: var(--agi); }
    .dbp [data-col="stamina"] { --stat: var(--sta); }
    .dbp [data-col="intelligence"] { --stat: var(--int); }
    .dbp [data-col="special"] { --stat: var(--spl); }
    .c-num { width: 84px; font-size: 0.84rem; color: var(--text-2); white-space: nowrap; }
    .c-pick { width: 48px; }
    .c-pick button {
        display: inline-grid; place-items: center; width: 32px; height: 32px;
        color: var(--muted); background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line-2); border-radius: 8px;
    }
    .c-pick button:hover { color: #fff; border-color: var(--frame-2); }
    .c-pick button[aria-pressed="true"] { color: #1d1400; background: var(--gold); border-color: var(--gold-2); }
    .c-pick button { position: relative; }
    .c-pick button::before, .c-pick button::after { content: ""; position: absolute; left: 50%; top: 50%; width: 13px; height: 2px; margin: -1px 0 0 -6.5px; background: currentColor; border-radius: 1px; transition: transform 0.15s; }
    .c-pick button::after { transform: rotate(90deg); }
    .c-pick button[aria-pressed="true"]::before { transform: rotate(45deg); }
    .c-pick button[aria-pressed="true"]::after { transform: rotate(135deg); }
    /* The sorted column is lit. */
    .dbp[data-sort="attack"] [data-col="attack"], .dbp[data-sort="defense"] [data-col="defense"], .dbp[data-sort="agility"] [data-col="agility"],
    .dbp[data-sort="stamina"] [data-col="stamina"], .dbp[data-sort="intelligence"] [data-col="intelligence"], .dbp[data-sort="special"] [data-col="special"],
    .dbp[data-sort="weight"] [data-col="weight"], .dbp[data-sort="speed"] [data-col="speed"] { background-color: rgba(255, 255, 255, 0.045); }
    .dbp[data-sort="weight"] td[data-col="weight"], .dbp[data-sort="speed"] td[data-col="speed"] { color: #fff; font-weight: 750; }

    .db-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(136px, 1fr)); gap: 12px; padding: 12px; }
    .db-card { min-width: 0; }

    .empty-state { margin: 16px; }
    .empty-state .link { background: none; border: 0; font: inherit; font-weight: 700; cursor: pointer; }

    .tray {
        position: absolute; left: 50%; bottom: 12px; z-index: 5;
        display: flex; align-items: center; gap: 10px;
        max-width: calc(100% - 24px);
        padding: 8px 8px 8px 12px;
        background: linear-gradient(180deg, #222429, #16171b);
        border: 1px solid var(--frame-2);
