---
import AnimalPicture from '../../components/AnimalPicture.astro';
import AnimalLayout from '../../layouts/AnimalLayout.astro';
import evidenceManifest from '../../../../data/animal-evidence.json';
import evidenceTools from '../../../../lib/animal-evidence.js';
import {
    animals,
    clampScore,
    detailedStats,
    formatList,
    formatMeasurement,
    formatScore,
    imageFor,
    relatedAnimals,
    rivalAnimals,
    stats
} from '../../lib/animals.js';

export function getStaticPaths() {
    return animals.map((animal) => ({
        params: { slug: animal.slug },
        props: { animal }
    }));
}

const { animal } = Astro.props;
const image = imageFor(animal);
const related = relatedAnimals(animal);
const rivals = rivalAnimals(animal);
const canonical = `https://animalbattlestats.com/stats/${animal.slug}`;
const title = `${animal.name} Stats, Rank, Habitat, Diet, and Battle Profile | Animal Battle Stats`;
const description = `${animal.name} is ranked #${animal.rank}. Explore attack, defense, agility, stamina, intelligence, special abilities, habitat, measurements, and battle profile.`;
const battleProfile = animal.battle_profile || {};
const speedKmh = Number(animal.speed_mps) > 0 ? Number(animal.speed_mps) * 3.6 : 0;
const powerIndex = animal.totalStats / stats.length;
const evidenceFields = 6;
const animalEvidence = evidenceTools.latestEvidenceByField(evidenceManifest.records.filter((record) => record.animal === animal.name));
const evidenceAssessment = evidenceTools.assessEvidence(animalEvidence);
const reviewedEvidenceFields = animalEvidence.length;
const correctionUrl = `https://github.com/RamiNoodle733/animal-battle-stats/issues/new?template=data-correction.yml&title=${encodeURIComponent(`Data correction: ${animal.name}`)}`;
const evidenceValue = (record) => {
    if (record.state !== 'known' && record.state !== 'actual_zero') return record.state.replaceAll('_', ' ');
    const primary = `${record.typical ?? record.value} ${record.unit}`;
    return record.minimum != null && record.maximum != null
        ? `${primary} (range ${record.minimum}–${record.maximum} ${record.unit})`
        : primary;
};
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Dataset',
            name: `${animal.name} comparative battle statistics`,
            description,
            url: canonical,
            dateModified: String(animal.updatedAt || animal.createdAt || '').slice(0, 10) || undefined,
            about: {
                '@type': 'Thing',
                name: animal.name,
                alternateName: animal.scientific_name || undefined,
                description: animal.description || undefined
            },
            variableMeasured: stats.map(([key, label]) => ({
                '@type': 'PropertyValue',
                name: label,
                value: clampScore(animal[key]),
                maxValue: 100
            }))
        },
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://animalbattlestats.com/' },
                { '@type': 'ListItem', position: 2, name: 'Animal Stats', item: 'https://animalbattlestats.com/stats' },
                { '@type': 'ListItem', position: 3, name: animal.name, item: canonical }
            ]
        }
    ]
};
---

<AnimalLayout title={title} description={description} canonical={canonical} image={image.fallback} jsonLd={jsonLd}>
    <main id="main-content">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><a href="/stats">Animal Stats</a><span>/</span><span aria-current="page">{animal.name}</span>
        </nav>

        <section class="hero-grid" aria-labelledby="animal-title">
            <div class="hero-copy">
                <div class="eyebrow-row">
                    <span class="rank-chip">WORLD RANK #{animal.rank}</span>
                    <span>{animal.type || 'Animal'}</span>
                    <span>{animal.class || 'Unclassified'}</span>
                </div>
                <p class="kicker">FIELD PROFILE / {animal.slug.toUpperCase()}</p>
                <h1 id="animal-title">{animal.name}</h1>
                <p class="scientific-name"><em>{animal.scientific_name || 'Scientific classification unavailable'}</em></p>
                <p class="hero-description">{animal.description || `${animal.name} comparative animal profile.`}</p>
                <div class="hero-actions">
                    <a class="action-primary" href={`/stats?animal=${animal.slug}`}>Open interactive profile</a>
                    <a class="action-secondary" href={`/compare?animal=${animal.slug}`}>Compare this animal</a>
                    <a class="action-secondary" href={`/battle?a=${animal.slug}`}>Try the battle model</a>
                </div>
                <p class="method-note">Scores are comparative editorial ratings for hypothetical matchups, not direct scientific measurements.</p>
            </div>
            <div class="animal-stage">
                <div class="stage-orbit" aria-hidden="true"></div>
                <AnimalPicture animal={animal} image={image} priority={true} />
                <div class="power-index">
                    <span>POWER INDEX</span>
                    <strong>{formatScore(powerIndex)}</strong>
                    <small>/ 100</small>
                </div>
            </div>
        </section>

        <section class="stats-panel" aria-labelledby="battle-stats-title">
            <div class="section-heading">
                <div><p>COMBAT TELEMETRY</p><h2 id="battle-stats-title">Battle stats</h2></div>
                <span>Six-category comparative model</span>
            </div>
            <div class="stat-grid">
                {stats.map(([key, label, abbreviation]) => (
                    <article class={`stat-card stat-${key}`} style={`--score:${clampScore(animal[key])}%`}>
                        <div class="stat-card-top"><span>{abbreviation}</span><strong>{formatScore(animal[key])}</strong></div>
                        <h3>{label}</h3>
                        <div class="stat-track" aria-label={`${label}: ${formatScore(animal[key])} out of 100`}>
                            <span></span>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="detail-panel" aria-labelledby="detailed-stats-title">
            <div class="section-heading">
                <div><p>DETAILED COMBAT MATRIX</p><h2 id="detailed-stats-title">Twelve substats</h2></div>
                <span>Editorial 0–100 ratings</span>
            </div>
            <div class="substat-grid">
                {detailedStats.map(([key, label]) => (
                    <div class="substat-row">
                        <span>{label}</span><strong>{formatScore(animal.substats?.[key])}</strong>
                        <div class="substat-track" aria-label={`${label}: ${formatScore(animal.substats?.[key])} out of 100`}><i style={`width:${clampScore(animal.substats?.[key])}%`}></i></div>
                    </div>
                ))}
            </div>
            <p class="module-note">Substats explain the six headline ratings. They are editorial judgments, not additional scientific measurements or independent inputs to the current battle probability.</p>
        </section>

        <div class="intel-grid">
            <section class="intel-card battle-card" aria-labelledby="battle-profile-title">
                <div class="section-heading compact"><div><p>TACTICAL READOUT</p><h2 id="battle-profile-title">Battle profile</h2></div></div>
                <dl class="profile-strip">
                    <div><dt>Combat style</dt><dd>{battleProfile.combat_style || 'Unknown'}</dd></div>
                    <div><dt>Preferred range</dt><dd>{battleProfile.preferred_range || 'Unknown'}</dd></div>
                    <div><dt>Primary environment</dt><dd>{battleProfile.primary_environment || animal.habitat || 'Unknown'}</dd></div>
                </dl>
                <div class="strength-grid">
                    <div><h3>Advantages</h3><ul>{(battleProfile.strengths || []).map((item) => <li>{item}</li>)}</ul></div>
                    <div class="weaknesses"><h3>Pressure points</h3><ul>{(battleProfile.weaknesses || []).map((item) => <li>{item}</li>)}</ul></div>
                </div>
            </section>

            <section class="intel-card" aria-labelledby="field-data-title">
                <div class="section-heading compact"><div><p>FIELD DATA</p><h2 id="field-data-title">Measurements</h2></div></div>
                <dl class="measurement-grid">
                    <div><dt>Habitat</dt><dd>{animal.habitat || 'Unknown'}</dd></div>
                    <div><dt>Diet</dt><dd>{formatList(animal.diet)}</dd></div>
                    <div><dt>Weight</dt><dd>{formatMeasurement(animal.weight_kg, 'kg', 1)}</dd></div>
                    <div><dt>Length</dt><dd>{formatMeasurement(animal.length_cm, 'cm')}</dd></div>
                    <div><dt>Top speed</dt><dd>{formatMeasurement(speedKmh, 'km/h', 1)}</dd></div>
                    <div><dt>Lifespan</dt><dd>{formatMeasurement(animal.lifespan_years, 'years', 1)}</dd></div>
                    <div><dt>Bite force</dt><dd>{formatMeasurement(animal.bite_force_psi, 'psi')}</dd></div>
                    <div><dt>Behavior</dt><dd>{animal.isSocial ? 'Social' : 'Primarily solitary'}{animal.isNocturnal ? ' · Nocturnal' : ''}</dd></div>
                </dl>
            </section>
        </div>

        <section class="evidence-panel" aria-labelledby="evidence-title" data-evidence-status={reviewedEvidenceFields ? 'partial' : 'unavailable'}>
            <div class="section-heading compact">
                <div><p>DATA PROVENANCE</p><h2 id="evidence-title">Evidence status</h2></div>
                <span>{reviewedEvidenceFields} of {evidenceFields} fields reviewed</span>
            </div>
            <div class="evidence-summary">
                <strong>{reviewedEvidenceFields ? 'Partial evidence coverage' : 'Per-field review pending'}</strong>
                <p>
                    {reviewedEvidenceFields
                        ? `${reviewedEvidenceFields} physical fields have cited evidence in data release ${evidenceManifest.dataRelease}. Unreviewed fields remain clearly separate from evidence-backed facts.`
                        : `No physical fields for ${animal.name} have per-field cited evidence in data release ${evidenceManifest.dataRelease}. The measurements above are legacy catalogue values and remain unreviewed.`}
                </p>
                <p>Missing values and legacy zeros are not treated as verified actual zero unless a cited record explicitly says so.</p>
                <div class="evidence-links">
                    <a href="/about#sources-title">Source policy</a>
                    <a href="/methodology">Battle methodology</a>
                    <a href={correctionUrl}>Report this profile</a>
                </div>
            </div>
            {animalEvidence.length > 0 && (
                <div class="evidence-table-wrap" tabindex="0" aria-label={`${animal.name} reviewed evidence`}>
                    <table class="evidence-table">
                        <thead><tr><th>Field</th><th>Reviewed value</th><th>Context</th><th>Source</th></tr></thead>
                        <tbody>
                            {animalEvidence.map((record) => (
                                <tr>
                                    <th scope="row">{record.field.replaceAll('_', ' ')}</th>
                                    <td>{evidenceValue(record)}</td>
                                    <td>{[record.basis, record.confidence, record.sex, record.ageClass].filter(Boolean).join(' · ')}{record.notes && <small>{record.notes}</small>}</td>
                                    <td>
                                        <a href={record.source.url}>{record.source.publisher}: {record.source.title}</a>
                                        <small>{record.source.publishedAt ? `Published ${record.source.publishedAt} · ` : ''}Accessed {record.source.accessedAt} · Reviewed {record.reviewedAt}</small>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
            <p class="evidence-confidence">Evidence confidence: <strong>{evidenceAssessment.confidence}</strong></p>
        </section>

        <section class="arsenal" aria-labelledby="arsenal-title">
            <div class="section-heading"><div><p>SPECIALIZATION</p><h2 id="arsenal-title">Abilities &amp; traits</h2></div></div>
            <div class="arsenal-grid">
                <div><h3>Special abilities</h3><ul>{(animal.special_abilities || []).map((item) => <li>{item}</li>)}</ul></div>
                <div><h3>Unique traits</h3><ul>{(animal.unique_traits || []).map((item) => <li>{item}</li>)}</ul></div>
            </div>
        </section>

        <section class="powerscaling-panel" aria-labelledby="powerscaling-title">
            <div class="section-heading"><div><p>ROSTER POSITION</p><h2 id="powerscaling-title">Powerscaling context</h2></div><a href="/rankings">Open rankings</a></div>
            <div class="rank-context-grid">
                <article><span>Overall</span><strong>#{animal.rank}</strong><small>of {animals.length}</small></article>
                <article><span>{animal.type} rank</span><strong>#{animal.typeRank.rank}</strong><small>of {animal.typeRank.total}</small></article>
                <article><span>{animal.class} archetype</span><strong>#{animal.classRank.rank}</strong><small>of {animal.classRank.total}</small></article>
                <article><span>{animal.size} size class</span><strong>#{animal.sizeRank.rank}</strong><small>of {animal.sizeRank.total}</small></article>
            </div>
            <p class="module-note">These positions sort the current editorial six-stat total within the named roster groups. Biome and pound-for-pound ranks remain unpublished until their classification and normalization rules are reviewed.</p>
            <div class="rival-heading"><h3>Closest roster rivals</h3><span>Nearest current total ratings</span></div>
            <div class="rival-grid">
                {rivals.map((candidate) => (
                    <article>
                        <a class="rival-profile" href={`/stats/${candidate.slug}`}><span>#{candidate.rank}</span><strong>{candidate.name}</strong><small>{candidate.type} · {candidate.class}</small></a>
                        <a class="rival-battle" href={`/battle?a=${animal.slug}&b=${candidate.slug}`}>Run matchup</a>
                    </article>
                ))}
            </div>
            <div class="powerscaling-actions"><a href={`/battle?a=${animal.slug}`}>Choose another opponent</a><a href="/tournament">Enter tournament</a><a href="/methodology">How rankings differ from predictions</a></div>
        </section>

        <section class="related" aria-labelledby="related-title">
            <div class="section-heading"><div><p>CONTINUE RESEARCH</p><h2 id="related-title">Related animals</h2></div><a href="/stats">View all 225</a></div>
            <div class="related-grid">
                {related.map((candidate) => (
                    <a href={`/stats/${candidate.slug}`}>
                        <span>#{candidate.rank}</span>
                        <strong>{candidate.name}</strong>
                        <small>{candidate.type} · {candidate.class}</small>
                    </a>
                ))}
            </div>
        </section>
    </main>
</AnimalLayout>
