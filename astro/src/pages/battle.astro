---
import SiteLayout from '../layouts/SiteLayout.astro';
import { animals, formatMeasurement } from '../lib/animals';
import engine from '../../../js/battle-engine.js';

const roster = [...animals].sort((a, b) => a.name.localeCompare(b.name));
const left = roster.find((a) => a.slug === 'african-lion');
const right = roster.find((a) => a.slug === 'siberian-tiger');
const result = engine.compare(left, right);
const favored = result.winner === 'left' ? left : right;
const percent = Math.round(100 * (result.winner === 'left' ? result.probability : 1 - result.probability));
const canonical = 'https://animalbattlestats.com/battle';
const description = 'Explore all 225 animals with a transparent experimental ABS battle model. Compare ratings, inspect the formula, and share a reproducible hypothetical matchup.';
const payload = roster.map((a) => Object.fromEntries(['name', 'slug', 'image', 'attack', 'defense', 'agility', 'stamina', 'intelligence', 'special', 'weight_kg', 'length_cm', 'height_cm', 'speed_mps', 'bite_force_psi'].map((key) => [key, a[key]])));
const measurements = [['weight_kg', 'Body mass', 'kg', 2], ['length_cm', 'Body length', 'cm', 1], ['height_cm', 'Height', 'cm', 1], ['speed_mps', 'Speed', 'm/s', 1], ['bite_force_psi', 'Bite force', 'psi', 0]];
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'ABS Battle Model Preview', url: canonical, description, breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://animalbattlestats.com/' }, { '@type': 'ListItem', position: 2, name: 'Battle', item: canonical }] } };
---
<SiteLayout title="Who Would Win? Battle Model Preview | Animal Battle Stats" description={description} canonical={canonical} jsonLd={jsonLd} activeNav="battle" styles={['/css/pages/battle-static.css']} scripts={['/js/battle-client.js']} footerLabel="Experimental ABS battle model" bodyClass="battle-route">
    <main id="main-content" class="battle-main">
        <div class="battle-command-bar">
            <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Battle Arena</span></nav>
            <p class="battle-kicker">ABS MODEL <span id="model-version">{engine.VERSION}</span> · EXPERIMENTAL</p>
        </div>

        <header class="battle-hero">
            <div><p class="battle-kicker">HEAD-TO-HEAD ANALYSIS</p><h1>Who would win?</h1></div>
            <p>Choose two animals, run the rating model, then inspect the deciding factors without leaving the arena.</p>
        </header>

        <section class="battle-arena" aria-labelledby="selector-title">
            <h2 id="selector-title" class="sr-only">Choose your matchup</h2>
            <form id="battle-form" action="/battle" method="get">
                <article class="battle-fighter battle-fighter-left">
                    <p class="fighter-slot">ANIMAL A</p>
                    <div class="battle-portrait"><img id="animal-a-image" src={left.image} alt="" width="320" height="240" /></div>
                    <label><span class="sr-only">Animal A</span><select name="a" id="animal-a">{roster.map((a) => <option value={a.slug} selected={a.slug === left.slug}>{a.name}</option>)}</select></label>
                    <a id="left-profile" href={`/stats/${left.slug}`}>{left.name} profile</a>
                </article>

                <div class="battle-control-core">
                    <span class="versus" aria-hidden="true">VS</span>
                    <button class="battle-primary" type="submit" id="battle-submit" disabled>RUN BATTLE</button>
                    <p id="battle-error" role="alert"></p>
                </div>

                <article class="battle-fighter battle-fighter-right">
                    <p class="fighter-slot">ANIMAL B</p>
                    <div class="battle-portrait"><img id="animal-b-image" src={right.image} alt="" width="320" height="240" /></div>
                    <label><span class="sr-only">Animal B</span><select name="b" id="animal-b">{roster.map((a) => <option value={a.slug} selected={a.slug === right.slug}>{a.name}</option>)}</select></label>
                    <a id="right-profile" href={`/stats/${right.slug}`}>{right.name} profile</a>
                </article>
            </form>

            <section class="battle-verdict" aria-labelledby="verdict-title" id="battle-result" tabindex="-1">
                <div><p id="matchup-label">{left.name} vs {right.name}</p><h2 id="verdict-title">{favored.name} favored: {percent}%</h2></div>
                <div class="battle-probability"><div class="battle-meter" aria-hidden="true"><span id="probability-fill" style={`width:${result.probability * 100}%`}></span></div><p id="probability-label">{left.name} {Math.round(result.probability * 100)}% · {right.name} {Math.round((1 - result.probability) * 100)}%</p></div>
                <button id="share-battle" type="button" disabled>SHARE</button>
                <p id="share-status" role="status"></p>
                <label id="share-fallback" hidden>Matchup URL<input readonly id="share-url" type="url" /></label>
            </section>
            <noscript><p>The arena shows African Lion vs Siberian Tiger. Enable JavaScript to calculate another pair, or explore the <a href="/stats">static animal profiles</a>.</p></noscript>
        </section>

        <section class="battle-intel" aria-label="Battle analysis">
            <div class="battle-intel-tabs" role="tablist" aria-label="Analysis views">
                <button type="button" role="tab" id="tab-summary" aria-controls="panel-summary" aria-selected="true">SUMMARY</button>
                <button type="button" role="tab" id="tab-ratings" aria-controls="panel-ratings" aria-selected="false" tabindex="-1">RATINGS</button>
                <button type="button" role="tab" id="tab-physical" aria-controls="panel-physical" aria-selected="false" tabindex="-1">PHYSICAL DATA</button>
                <button type="button" role="tab" id="tab-limits" aria-controls="panel-limits" aria-selected="false" tabindex="-1">LIMITS</button>
            </div>
            <div class="battle-intel-viewport">
                <section id="panel-summary" role="tabpanel" aria-labelledby="tab-summary">
                    <h2>Why the model leans this way</h2>
                    <p id="battle-summary">The largest weighted rating difference is {result.factors[0].label.toLowerCase()}. This is a formula-derived estimate, not a measured chance of winning.</p>
                    <p><strong>Prediction confidence: Low.</strong> <span>{result.confidenceReason}</span></p>
                    <p id="coverage-label">All six rating factors available. Per-field source verification remains incomplete.</p>
                    <p><strong>Assumptions:</strong> {result.scenario} Analytical calculation; no random simulations were run.</p>
                </section>
                <section id="panel-ratings" role="tabpanel" aria-labelledby="tab-ratings" hidden>
                    <h2>Weighted editorial ratings</h2><p>Positive contributions favor Animal A; negative contributions favor Animal B.</p>
                    <div class="battle-table-wrap" role="region" aria-label="Battle rating comparison" tabindex="0"><table><caption>Weighted rating breakdown</caption><thead><tr><th scope="col">Factor</th><th scope="col">A</th><th scope="col">B</th><th scope="col">Weight</th><th scope="col">Impact</th></tr></thead><tbody id="factor-rows">{engine.FACTORS.map((f) => <tr><th scope="row">{f.label}</th><td>{left[f.key]}</td><td>{right[f.key]}</td><td>{Math.round(f.weight * 100)}%</td><td>{result.factors.find((v) => v.key === f.key).contribution.toFixed(1)}</td></tr>)}</tbody></table></div>
                </section>
                <section id="panel-physical" role="tabpanel" aria-labelledby="tab-physical" hidden>
                    <h2>Physical data—not model inputs</h2><p>Legacy values awaiting source review. Unknown does not mean zero.</p>
                    <div class="battle-table-wrap" role="region" aria-label="Physical measurement comparison" tabindex="0"><table><caption>Physical measurements from the ABS dataset</caption><thead><tr><th scope="col">Measurement</th><th scope="col">Animal A</th><th scope="col">Animal B</th></tr></thead><tbody id="measurement-rows">{measurements.map(([key, label, unit, decimals]) => <tr><th scope="row">{label}</th><td>{formatMeasurement(left[key], unit, decimals)}</td><td>{formatMeasurement(right[key], unit, decimals)}</td></tr>)}</tbody></table></div>
                </section>
                <section id="panel-limits" role="tabpanel" aria-labelledby="tab-limits" hidden>
                    <h2>What could change the answer?</h2><p class="battle-caveat">Body size, environment, space, ambush, individual variation and specialized weapons can overturn a rating-only estimate. This preview does not quantify them or treat land and marine conditions as equivalent.</p><p>Community voting is separate. <a href="/compare">Open Compare</a> or <a href="/methodology">read the complete formula</a>.</p><p>ABS models hypothetical matchups for entertainment. Never approach, provoke or fight wildlife.</p>
                </section>
            </div>
            <div class="battle-presets" aria-label="Example matchups"><span>QUICK MATCH:</span><a href="/battle?a=african-lion&amp;b=siberian-tiger">Lion vs Tiger</a><a href="/battle?a=gorilla&amp;b=grizzly-bear">Gorilla vs Grizzly</a><a href="/battle?a=orca&amp;b=great-white-shark">Orca vs Great White</a><a href="/battle?a=hippopotamus&amp;b=rhinoceros">Hippo vs Rhino</a><a href="/battle?a=saltwater-crocodile&amp;b=siberian-tiger">Crocodile vs Tiger</a></div>
        </section>
    </main>
    <script is:inline id="battle-data" type="application/json" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
</SiteLayout>
