---
import Base from '../../layouts/Base.astro';
import AnimalImage from '../../components/AnimalImage.astro';
import Meters from '../../components/Meters.astro';
import Radar from '../../components/Radar.astro';
import UiIcon from '../../components/UiIcon.astro';
import {
    animals, STATS, SUBSTATS, GROUPS, BIOMES, groupRank, statRank, rivals, tierInfo,
    fmtWeight, fmtLength, fmtSpeed, fmtYears, fmtBite, fmtScore, ordinal, article
} from '../../lib/catalog.js';
import { verdict, matchupHref } from '../../lib/matchups.js';
import { creditFor } from '../../lib/credits.js';
import { SITE, absoluteUrl } from '../../lib/site.js';
import { rolesFor, logo as showLogo } from '../../lib/shows.js';
import { cardJson, cardFiles, cardAlt, CARD_FILE } from '../../lib/card.js';

export function getStaticPaths() {
    return animals.map((animal) => ({ params: { slug: animal.slug }, props: { animal } }));
}

const { animal } = Astro.props;
const roles = rolesFor(animal.slug);
const profile = animal.profile;
const researched = animal.researched;
const tier = tierInfo(animal.tier);
const group = GROUPS.find((item) => item.key === animal.group);
const biome = BIOMES[animal.biome];
const inGroup = groupRank(animal);
const credit = creditFor(animal.slug);
const path = `/stats/${animal.slug}`;
const seed = animal.rank;
// The battle card as files (front, back, and the page preview that shows it).
const cardFile = cardFiles(animal);

const sortedStats = [...STATS].sort((a, b) => (animal[b.key] || 0) - (animal[a.key] || 0));
const best = sortedStats[0];
const worst = sortedStats[sortedStats.length - 1];

const unverified = new Set(profile.unverifiedFacts || []);
const factRows = [
    ['Weight', fmtWeight(animal.weight_kg), 'weight_kg'],
    ['Height', fmtLength(animal.height_cm), 'height_cm'],
    ['Length', fmtLength(animal.length_cm), 'length_cm'],
    ['Top speed', fmtSpeed(animal.speed_mps), 'speed_mps'],
    ['Bite force', fmtBite(animal.bite_force_psi), 'bite_force_psi'],
    ['Lifespan', fmtYears(animal.lifespan_years), 'lifespan_years']
].map(([label, value, key]) => ({ label, value: researched && unverified.has(key) ? null : value, key }));

const abilities = profile.abilities?.length ? profile.abilities : (animal.special_abilities || []).map((name) => ({ name, description: '' }));
const traits = profile.traits?.length ? profile.traits : (animal.unique_traits || []).map((name) => ({ name, description: '' }));
const cap = (text) => (text ? text.charAt(0).toUpperCase() + text.slice(1) : '');

const summary = profile.summary || animal.description;
const specimenRaw = (profile.specimen || '').split(/(?<=[.!?])\s+(?=[A-Z])/)[0];
const specimen = cap(specimenRaw);
const rivalList = rivals(animal, 8).map((rival) => ({ rival, result: verdict(animal, rival), href: matchupHref(animal, rival) }));
const beats = rivalList.filter(({ result }) => !result.draw && result.winner.slug === animal.slug);
const loses = rivalList.filter(({ result }) => !result.draw && result.winner.slug !== animal.slug);
const draws = rivalList.filter(({ result }) => result.draw);

// Reports sometimes merge headings ("Diet and social system"): show each text once.
const sections = {};
const seenText = new Set();
for (const [key, value] of Object.entries(profile.sections || {})) {
    const first = String(value || '').split('\n')[0];
    if (!first || seenText.has(first)) continue;
    seenText.add(first);
    sections[key] = first;
}
const combat = profile.combat || {};
const weaponLines = String(combat.weapons || '').split('\n').filter(Boolean);
const sources = profile.sources || [];

const w = fmtWeight(animal.weight_kg);
const s = fmtSpeed(animal.speed_mps);
const bite = fmtBite(animal.bite_force_psi);
const title = `${animal.name} Stats: Strength, Speed, Size & Power Ranking | ${SITE.name}`;
const description = `${animal.name} ranks #${animal.rank} of ${animals.length} (${animal.tier}-tier, power ${fmtScore(animal.powerIndex)}). Attack ${fmtScore(animal.attack)}, defense ${fmtScore(animal.defense)}, agility ${fmtScore(animal.agility)}${w ? `, weighs ${w.metric}` : ''}${s ? `, runs ${s.metric}` : ''}. Sources included.`;

const faq = [];
faq.push({ q: `How strong is ${article(animal.name)} ${animal.name}?`, a: `On the Animal Battle Stats scale, the ${animal.name} has an attack rating of ${fmtScore(animal.attack)} and a power index of ${fmtScore(animal.powerIndex)} out of 100, which ranks it #${animal.rank} of ${animals.length} animals and puts it in ${animal.tier} tier (${tier.name}). Its strongest stat is ${best.label.toLowerCase()} (${fmtScore(animal[best.key])}).` });
if (w) faq.push({ q: `How much does ${article(animal.name)} ${animal.name} weigh?`, a: `A typical adult ${animal.name} weighs about ${w.metric} (${w.imperial}).${specimen ? ` Rated specimen: ${specimenRaw}` : ''}` });
faq.push({ q: `How fast is ${article(animal.name)} ${animal.name}?`, a: s ? `The ${animal.name}'s top speed is about ${s.metric} (${s.imperial}). Its agility rating is ${fmtScore(animal.agility)} out of 100.` : `There is no reliable measured top speed for the ${animal.name}, so we do not publish one. Its agility rating, which covers acceleration, reflexes and evasion, is ${fmtScore(animal.agility)} out of 100.` });
if (bite) faq.push({ q: `What is the ${animal.name}'s bite force?`, a: `The ${animal.name}'s bite force is about ${bite.metric}.` });
if (sections.diet) faq.push({ q: `What does ${article(animal.name)} ${animal.name} eat?`, a: sections.diet });
if (profile.conservationStatus) faq.push({ q: `Is the ${animal.name} endangered?`, a: `${profile.conservationStatus === 'Least Concern' ? `No. The ${animal.name} is listed as Least Concern.` : `The ${animal.name}'s conservation status is ${profile.conservationStatus}.`} ${(sections.conservation || '').slice(0, 400)}`.trim() });
const drawLine = draws.length ? ` It is dead even with ${draws.map(({ rival }) => `the ${rival.name}`).join(', ')}: a draw.` : '';
faq.push({
    q: `What animals can beat ${article(animal.name)} ${animal.name}?`,
    a: loses.length
        ? `Among its closest rivals, ${loses.map(({ rival, result }) => `the ${rival.name} (${result.odds}%)`).join(', ')} would be favored against the ${animal.name}. It would be favored against ${beats.length ? beats.map(({ rival }) => `the ${rival.name}`).join(', ') : 'none of them'}.${drawLine}`
        : `The ${animal.name} is favored against ${draws.length ? 'its other' : 'all of its'} closest rivals, including ${beats.map(({ rival }) => `the ${rival.name}`).join(', ')}.${drawLine}`
});

const jsonLd = [
    {
        '@type': 'WebPage',
        '@id': `${absoluteUrl(path)}#webpage`,
        url: absoluteUrl(path),
        name: title,
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        dateModified: profile.researchedAt || undefined,
        primaryImageOfPage: { '@id': `${absoluteUrl(path)}#image` },
        image: [{ '@id': `${absoluteUrl(path)}#card` }, { '@id': `${absoluteUrl(path)}#card-back` }, { '@id': `${absoluteUrl(path)}#image` }],
        thumbnailUrl: absoluteUrl(cardFile.preview),
        about: { '@type': 'Taxon', name: animal.name, scientificName: animal.scientific_name, alternateName: animal.scientific_name, description: summary },
        mainEntity: {
            '@type': 'Dataset',
            name: `${animal.name} battle statistics`,
            description: `Six research-based battle ratings (0-100) and physical measurements for the ${animal.name}.`,
            creator: { '@id': `${SITE.url}/#organization` },
            license: 'https://creativecommons.org/licenses/by/4.0/',
            variableMeasured: [
                ...STATS.map((stat) => ({ '@type': 'PropertyValue', name: stat.label, value: Number(animal[stat.key]) || 0, minValue: 0, maxValue: 100 })),
                { '@type': 'PropertyValue', name: 'Power index', value: animal.powerIndex, minValue: 0, maxValue: 100 },
                ...(animal.weight_kg > 0 ? [{ '@type': 'PropertyValue', name: 'Weight', value: animal.weight_kg, unitCode: 'KGM' }] : []),
                ...(animal.speed_mps > 0 ? [{ '@type': 'PropertyValue', name: 'Top speed', value: Math.round(animal.speed_mps * 3.6), unitText: 'km/h' }] : [])
            ]
        }
    },
    {
        '@type': 'ImageObject',
        '@id': `${absoluteUrl(path)}#image`,
        contentUrl: absoluteUrl(animal.img.src),
        caption: `${animal.name} (${animal.scientific_name})`,
        ...(credit ? { creditText: credit.artist, creator: { '@type': 'Person', name: credit.artist }, license: credit.licenseUrl || undefined, acquireLicensePage: credit.sourcePage || undefined, copyrightNotice: credit.artist } : {})
    },
    // The battle card: what link previews, image search and AI answers show.
    ...[['card', cardFile.front, cardAlt(animal)], ['card-back', cardFile.back, cardAlt(animal, 'back')]].map(([id, file, caption]) => ({
        '@type': 'ImageObject',
        '@id': `${absoluteUrl(path)}#${id}`,
        contentUrl: absoluteUrl(file),
        url: absoluteUrl(file),
        name: `${animal.name} battle card${id === 'card-back' ? ' (back)' : ''}`,
        caption,
        width: CARD_FILE.width,
        height: CARD_FILE.height,
        encodingFormat: 'image/webp',
        creator: { '@id': `${SITE.url}/#organization` },
        creditText: SITE.name,
        about: { '@type': 'Taxon', name: animal.name, scientificName: animal.scientific_name }
    })),
    {
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
            { '@type': 'ListItem', position: 2, name: 'Animals', item: `${SITE.url}/stats` },
            { '@type': 'ListItem', position: 3, name: animal.name, item: absoluteUrl(path) }
        ]
    },
    { '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
];

const TABS = [
    ['stats', 'Stats'], ['battle-card', 'Card'], ['kit', 'Abilities'], ['facts', 'Facts'],
    ['versus', 'Matchups'], ['lore', 'Analysis'], ['sources', 'Sources'], ['talk', 'Talk']
];
const tierCls = animal.tier.toLowerCase();
// The barcode strip on the back of the card, drawn from the animal's name.
const barcode = [...`${animal.slug}${animal.rank}`].flatMap((char) => [1 + (char.charCodeAt(0) % 3), 1 + ((char.charCodeAt(0) >> 2) % 2)]).slice(0, 34);
// The measurements under the photo: the database at a glance.
const glance = [
    ['Weight', fmtWeight(animal.weight_kg)],
    [animal.length_cm ? 'Length' : 'Height', fmtLength(animal.length_cm || animal.height_cm)],
    ['Top speed', fmtSpeed(animal.speed_mps)],
    ['Bite force', fmtBite(animal.bite_force_psi)],
    ['Lifespan', fmtYears(animal.lifespan_years)],
    ['Habitat', biome ? { metric: biome.label } : null]
].map(([label, value], index) => ({ label, value: value?.metric || null, main: index < 3 }));
const conservationClass = /Endangered|Vulnerable|Critically|Threatened/.test(profile.conservationStatus || '') ? 'chip-red' : profile.conservationStatus === 'Extinct' ? 'chip-orange' : 'chip-green';
---

<Base title={title} description={description} path={path} image={cardFile.preview} imageAlt={cardAlt(animal)} jsonLd={jsonLd} active="animals" biome={animal.biome} seed={seed}>
    <div class="profile screen-grid">
        <section class={`stage cb tier-${tierCls} bio-${animal.biome}`} aria-labelledby="animal-name">
            <div class="cb-top">
                <nav class="crumbs" aria-label="Breadcrumb"><a href="/stats">Animals</a><span>/</span><a href={`/stats?group=${animal.group}`}>{group?.label}</a></nav>
                <span class="cb-code" aria-hidden="true">{barcode.map((width) => <i style={`--w:${width}`}></i>)}</span>
                <span class="cb-num" title={`Ranked #${animal.rank} of ${animals.length} by power`}><b>#{animal.rank}</b>/{animals.length}</span>
            </div>
            <div class="cb-frame">
                <div class="cb-field">
                    <span class="cb-band" aria-hidden="true">Animal Battle Stats</span>
                    <div class="cb-power"><b>{fmtScore(animal.powerIndex)}</b><small>PWR</small></div>
                    <span class={`tier-badge lg tier-${tierCls}`} title={`${animal.tier} tier: ${tier.name}`}>{animal.tier}</span>
                    <div class="podium" style={`view-transition-name: art-${animal.slug}`}>
                        <AnimalImage animal={animal} priority sizes="(max-width: 760px) 70vw, 520px" class="hero-art" />
                    </div>
                    {credit && <p class="credit">Photo: {credit.artist} · <a href={credit.sourcePage} rel="noopener" target="_blank">{credit.license}</a></p>}
                </div>
                <div class="cb-plate">
                    <h1 id="animal-name" class="cb-name">{animal.name}</h1>
                    <p class="sci"><em>{animal.scientific_name}</em><span>{animal.tier} tier · {tier.name}</span><span>{ordinal(inGroup.rank)} of {inGroup.total} {group?.label.toLowerCase()}</span></p>
                </div>
            </div>
            <div class="chips">
                <span class="chip">{group?.label?.replace(/s$/, '') || animal.type}</span>
                <span class="chip">{animal.class}</span>
                {profile.conservationStatus && <span class={`chip status ${conservationClass}`}><i></i>{profile.conservationStatus}</span>}
                <span class="votes" data-votes={animal.name} role="group" aria-label={`Community vote on the ${animal.name}`}>
                    <button type="button" class="vbtn up" data-vote="up" title="Upvote: stronger than its rank"><span aria-hidden="true">▲</span><b data-count="up">·</b></button>
                    <button type="button" class="vbtn down" data-vote="down" title="Downvote: weaker than its rank"><span aria-hidden="true">▼</span><b data-count="down">·</b></button>
                </span>
            </div>
            <dl class="glance">
                {glance.map((fact) => <div class={fact.main ? 'main' : ''}><dt>{fact.label}</dt><dd>{fact.value || '—'}</dd></div>)}
            </dl>
            <div class="actions">
                <a class="btn btn-hot" href={`/compare?a=${animal.slug}`}><UiIcon name="vs" />Compare</a>
                <button class="btn" type="button" data-card title={`See the ${animal.name} card in 3D`}><UiIcon name="cards" /><span>Card</span></button>
                <button class="btn" type="button" data-share title={`Share the ${animal.name} card`}><UiIcon name="share" /><span>Share</span></button>
            </div>
            <script type="application/json" id="abs-card" is:inline set:html={cardJson(animal)}></script>
        </section>

        <section class="panel dossier enter-3" aria-label={`${animal.name} details`}>
            <div class="tabs" role="tablist">
                {TABS.map(([id, label], index) => (
                    <button type="button" role="tab" id={`tab-${id}`} aria-controls={`pane-${id}`} aria-selected={index === 0 ? 'true' : 'false'} data-tab={id}>
                        {label}
                    </button>
                ))}
            </div>

            <div class="pane scroll" id="pane-stats" role="tabpanel" aria-labelledby="tab-stats">
                <div class="stats-split">
                    <Meters animal={animal} />
                    <div class="radar-box"><Radar animal={animal} size={250} /></div>
                </div>
                <div class="callouts">
                    <div class={best.cls}><span>Best stat</span><strong>{best.label}</strong><small>{ordinal(statRank(animal, best.key).rank)} of {animals.length}</small></div>
                    <div class={worst.cls}><span>Weak spot</span><strong>{worst.label}</strong><small>{fmtScore(animal[worst.key])} / 100</small></div>
                </div>
                {roles.map(({ show, character }) => (
                    <a class="stars-in" href={show.url} style={`--show:${show.accent}`}>
                        <img src={showLogo(show)} alt={show.name} width="720" height="360" loading="lazy" />
                        <span><small>Stars in ABS Originals</small><b>{character.name}, {character.role.toLowerCase()}</b><span>{show.tagline} Watch free →</span></span>
                    </a>
                ))}
                <p class="summary">{summary}</p>
                <h2 class="pane-h">Detailed ratings</h2>
                <div class="pips">
                    {SUBSTATS.map(([key, label, parent]) => {
                        const stat = STATS.find((item) => item.key === parent);
                        const value = Number(animal.substats?.[key]) || 0;
                        return <div class={`pip-row ${stat.cls}`}><span>{label}</span><span class="track"><i style={`--w:${Math.min(100, value)}%`}></i></span><b>{fmtScore(value)}</b></div>;
                    })}
                </div>
                <p class="note">{researched ? `Research-backed ratings on one 0–100 scale for all ${animals.length} animals (updated ${profile.researchedAt}).` : 'Research for this animal is in progress; these are earlier ratings.'} <a class="link" href="/about#ratings">How ratings work</a></p>
            </div>

            <div class="pane scroll" id="pane-battle-card" role="tabpanel" aria-labelledby="tab-battle-card" hidden>
                <div class="card-files">
                    <figure>
                        <img src={cardFile.front} width={CARD_FILE.width} height={CARD_FILE.height} alt={cardAlt(animal)} loading="lazy" decoding="async" />
                        <figcaption>Front</figcaption>
                    </figure>
                    <figure>
                        <img src={cardFile.back} width={CARD_FILE.width} height={CARD_FILE.height} alt={cardAlt(animal, 'back')} loading="lazy" decoding="async" />
                        <figcaption>Back</figcaption>
                    </figure>
                </div>
                <div class="btn-row card-actions">
                    <button class="btn btn-gold" type="button" data-card><UiIcon name="cards" />Turn it in 3D</button>
                    <button class="btn" type="button" data-share><UiIcon name="share" />Share</button>
                    <a class="btn" href={cardFile.front} download={`${animal.slug}-battle-card.webp`} data-save-card>Save the card</a>
                </div>
                <p class="note">Card No. {animal.rank} of {animals.length}. Every animal on Animal Battle Stats has one: its power, tier and archetype on the front; its six battle stats, abilities and signature move on the back.</p>
            </div>

            <div class="pane scroll" id="pane-kit" role="tabpanel" aria-labelledby="tab-kit" hidden>
                <h2 class="pane-h">Special abilities</h2>
                <div class="moves">
                    {abilities.map((ability) => (
                        <div class="move"><div class="mv-head"><b>{ability.name}</b><i></i><small>Ability</small></div>{ability.description && <p>{cap(ability.description)}</p>}</div>
                    ))}
                </div>
                <h2 class="pane-h">Unique traits</h2>
                <div class="moves">
                    {traits.map((trait) => (
                        <div class="move trait"><div class="mv-head"><b>{trait.name}</b><i></i><small>Trait</small></div>{trait.description && <p>{cap(trait.description)}</p>}</div>
                    ))}
                </div>
                {(weaponLines.length > 0 || combat.badMatchups?.length > 0) && (
                    <>
                        <h2 class="pane-h">How it fights</h2>
                        <div class="fight-grid">
                            {weaponLines.length > 0 && <div class="fight good"><h3><UiIcon name="attack" size={16} />Weapons</h3><ul>{weaponLines.slice(0, 4).map((line) => <li>{line}</li>)}</ul></div>}
                            {combat.goodMatchups?.length > 0 && <div class="fight good"><h3><UiIcon name="check" size={16} />Beats</h3><ul>{combat.goodMatchups.slice(0, 4).map((line) => <li>{line}</li>)}</ul></div>}
                            {(combat.badMatchups?.length > 0 || combat.weaknesses?.length > 0) && <div class="fight bad"><h3><UiIcon name="close" size={16} />Struggles vs</h3><ul>{(combat.badMatchups?.length ? combat.badMatchups : combat.weaknesses).slice(0, 5).map((line) => <li>{line}</li>)}</ul></div>}
                        </div>
                    </>
                )}
            </div>

            <div class="pane scroll" id="pane-facts" role="tabpanel" aria-labelledby="tab-facts" hidden>
                <dl class="facts-grid">
                    {factRows.map((row) => (
                        <div><dt>{row.label}</dt>{row.value ? <dd>{row.value.metric}{row.value.imperial && <small>{row.value.imperial}</small>}</dd> : <dd class="na">No reliable measurement</dd>}</div>
                    ))}
                    <div><dt>Home biome</dt><dd>{biome?.label || '—'}</dd></div>
                    <div><dt>Lifestyle</dt><dd class="na" style="color:var(--text-2)">{animal.isSocial ? 'Social' : 'Mostly solitary'}{animal.isNocturnal ? ', nocturnal' : ''}</dd></div>
                </dl>
                {specimen && <p class="note">Rated specimen: {specimen}</p>}
                {profile.funFacts?.length > 0 && (
                    <>
                        <h2 class="pane-h">Fun facts</h2>
                        <ul class="fun">{profile.funFacts.slice(0, 6).map((fact) => <li>{fact}</li>)}</ul>
                    </>
                )}
            </div>

            <div class="pane scroll" id="pane-versus" role="tabpanel" aria-labelledby="tab-versus" hidden>
                <p class="note" style="margin-top:0">Closest rivals by power. Tap one for the full breakdown, or pick any opponent.</p>
                <div class="vs-list">
                    {rivalList.map(({ rival, result, href }) => {
                        const end = result.draw ? 'draw' : result.winner.slug === animal.slug ? 'win' : 'loss';
                        const word = { win: ['Wins', 'W', 'chip-green'], loss: ['Loses', 'L', 'chip-red'], draw: ['Draw', 'D', ''] }[end];
                        return (
                            <a class={`vs-row ${end}`} href={href} data-sfx>
                                <AnimalImage animal={animal} sizes="64px" alt="" />
                                <span class="vs-mid"><b>vs {rival.name}</b><small>{word[0]} · {result.draw ? '50-50' : `${result.odds}%`} · {result.strength}</small></span>
                                <span class="flip"><AnimalImage animal={rival} sizes="64px" alt="" /></span>
                                <span class={`chip ${word[2]}`}>{word[1]}</span>
                            </a>
                        );
                    })}
                </div>
                <a class="btn btn-cyan" href={`/compare?a=${animal.slug}`} style="margin-top:12px"><UiIcon name="vs" />Pick any opponent</a>
            </div>

            <div class="pane scroll prose" id="pane-lore" role="tabpanel" aria-labelledby="tab-lore" hidden>
                <h2 class="pane-h" style="margin-top:0">{animal.name} battle analysis</h2>
                {(profile.narrative?.length ? profile.narrative : [summary]).map((paragraph) => <p>{paragraph}</p>)}
                {sections.habitat && <><h3>Habitat &amp; range</h3><p>{sections.habitat}</p>{sections.range && <p>{sections.range}</p>}</>}
                {sections.diet && <><h3>Diet &amp; hunting</h3><p>{sections.diet}</p></>}
                {sections.social && <><h3>Social life</h3><p>{sections.social}</p></>}
                {sections.conservation && <><h3>Conservation</h3><p>{sections.conservation}</p></>}
                <h3>Quick answers</h3>
                <div class="faq">{faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
            </div>

            <div class="pane scroll" id="pane-sources" role="tabpanel" aria-labelledby="tab-sources" hidden>
                <p class="note" style="margin-top:0">{researched ? `Researched ${profile.researchedAt}. Ratings are editorial judgments built from these sources; measurements describe a healthy adult${profile.specimenSex && profile.specimenSex !== 'unspecified' ? ` ${profile.specimenSex}` : ''}.` : 'A full sourced research profile for this animal is in progress.'}</p>
                {sources.length > 0 ? (
                    <ol class="sources">
                        {sources.slice(0, 20).map((source) => <li><a href={source.url} rel="noopener nofollow" target="_blank">{source.title}</a>{source.supports && <span>{source.supports}</span>}</li>)}
                    </ol>
                ) : <p class="empty-state">Sources appear here when the research profile is published.</p>}
                {credit && <p class="note">Photo: “{credit.title}” by {credit.artist}, {credit.license}{credit.modified ? `, ${credit.modified.toLowerCase()}` : ''}. <a class="link" href={credit.sourcePage} rel="noopener" target="_blank">Original</a></p>}
                <a class="btn btn-sm" href={`https://github.com/RamiNoodle733/animal-battle-stats/issues/new?template=data-correction.yml&title=${encodeURIComponent(`Data correction: ${animal.name}`)}`} rel="noopener" target="_blank">Suggest a correction</a>
            </div>

            <div class="pane scroll" id="pane-talk" role="tabpanel" aria-labelledby="tab-talk" hidden data-comments={animal.name}></div>
        </section>
    </div>
</Base>

<script>
    import { sfx } from '../../scripts/sfx.js';
    import { toast, showReward } from '../../scripts/site.js';
    import { mountComments } from '../../scripts/comments.js';
    import { loadVotes, castVote } from '../../scripts/votes.js';

    // Community up/down vote on this animal (one per day, earns XP).
    const voteBox = document.querySelector('[data-votes]');
    let voteEntry = null;
    function paintVotes() {
        if (!voteEntry) return;
        for (const type of ['up', 'down']) {
            voteBox.querySelector(`[data-count="${type}"]`).textContent = voteEntry[type];
            voteBox.querySelector(`[data-vote="${type}"]`).classList.toggle('on', voteEntry.mine === type);
            voteBox.querySelector(`[data-vote="${type}"]`).setAttribute('aria-pressed', String(voteEntry.mine === type));
        }
    }
    loadVotes().then((map) => { voteEntry = map.get(voteBox.dataset.votes) || null; paintVotes(); }).catch(() => {});
    voteBox.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-vote]');
        if (!button || !voteEntry) return;
        const result = await castVote(voteEntry.id, voteBox.dataset.votes, button.dataset.vote, voteEntry);
        if (result.needsLogin) { toast('Log in to vote'); return; }
        if (result.error) { sfx.error(); toast(result.error); return; }
        voteEntry = result.entry;
        paintVotes();
        if (result.reward?.awarded) showReward(result.reward, button);
        else sfx.tick();
    });

    const tabs = [...document.querySelectorAll('[data-tab]')];
    function show(id, focus = false) {
        const tab = tabs.find((item) => item.dataset.tab === id) || tabs[0];
        for (const item of tabs) {
            const on = item === tab;
            item.setAttribute('aria-selected', String(on));
            item.tabIndex = on ? 0 : -1;
            document.getElementById(`pane-${item.dataset.tab}`).hidden = !on;
        }
        if (focus) tab.focus();
        // The comment thread loads the first time its tab opens.
        const talk = document.getElementById('pane-talk');
        if (tab.dataset.tab === 'talk' && talk) mountComments(talk, { animalName: talk.dataset.comments });
    }
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => { show(tab.dataset.tab); history.replaceState(null, '', `#${tab.dataset.tab}`); });
        tab.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
                const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
                show(next.dataset.tab, true);
                sfx.tab();
            }
        });
    });
    if (location.hash && location.hash !== '#card') show(location.hash.slice(1));

    // The collectible card: in 3D (#card links straight to it), or shared as a
    // picture or a video. Both load only when asked for.
    const card = JSON.parse(document.getElementById('abs-card').textContent);
    const cardUrl = () => `${location.origin}${location.pathname}#card`;
    async function shareCard() {
        try {
            const { shareAnimal } = await import('../../scripts/share-card.js');
            shareAnimal(card, { url: cardUrl() });
        } catch { toast('Could not open sharing. Check your connection.'); }
    }
    async function viewCard() {
        try {
            const { openCardViewer } = await import('../../scripts/card-viewer.js');
            openCardViewer(card, { onShare: shareCard });
        } catch { toast('Could not open the card. Check your connection.'); }
    }
    // the card's files start downloading as the finger lands
    const warm = () => { for (const src of [card.files?.base, card.files?.top, card.files?.back]) if (src) new Image().src = src; };
    document.querySelectorAll('[data-card]').forEach((button) => {
        button.addEventListener('pointerdown', warm, { once: true });
        button.addEventListener('click', () => {
            sfx.select();
            history.replaceState(null, '', '#card');
            viewCard();
        });
    });
    document.querySelectorAll('[data-share]').forEach((button) => button.addEventListener('click', () => { sfx.select(); shareCard(); }));

    // On iPhone and iPad, Save the card goes into Photos: the share sheet with
    // the front and back as pictures (it offers Save 2 Images). They are made
    // ready while the Card tab is open, so the tap opens the sheet at once.
    const saveCard = document.querySelector('[data-save-card]');
    const applePhone = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (saveCard && applePhone && navigator.canShare && card.files) {
        let ready = null;
        let preparing = null;
        const asJpeg = async (src, name) => {
            const img = new Image();
            img.src = src;
            await img.decode();
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            canvas.getContext('2d').drawImage(img, 0, 0);
            const bytes = atob(canvas.toDataURL('image/jpeg', 0.93).split(',')[1]);
            const buffer = new Uint8Array(bytes.length);
            for (let index = 0; index < bytes.length; index += 1) buffer[index] = bytes.charCodeAt(index);
            canvas.width = 0;
            canvas.height = 0;
            return new File([buffer], `${card.slug}-${name}.jpg`, { type: 'image/jpeg' });
        };
        const prepare = () => {
            preparing ||= Promise.all([asJpeg(card.files.front, 'battle-card'), asJpeg(card.files.back, 'battle-card-back')])
                .then((files) => { if (navigator.canShare({ files })) ready = files; })
                .catch(() => { preparing = null; });
            return preparing;
        };
        saveCard.textContent = 'Save to Photos';
        new IntersectionObserver((entries, observer) => {
            if (entries.some((entry) => entry.isIntersecting)) { prepare(); observer.disconnect(); }
        }).observe(saveCard);
        saveCard.addEventListener('click', (event) => {
            event.preventDefault();
            if (ready) {
                navigator.share({ files: ready }).catch(() => {});
                window.gtag?.('event', 'share', { method: 'save_photos', content_type: 'animal_card', item_id: card.name });
            } else {
                toast('Getting the card ready. Tap again in a moment.');
                prepare();
            }
        });
    }
    if (location.hash === '#card') viewCard();
</script>

