---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HoloCard from '../components/HoloCard.astro';
import AnimalImage from '../components/AnimalImage.astro';
import RobloxMark from '../components/RobloxMark.astro';
import { animals, gameAnimals, researchedCount, sourceCount, fmtScore } from '../lib/catalog.js';
import { PAIRS } from '../lib/matchups.js';
import { SITE, ROBLOX, absoluteUrl } from '../lib/site.js';

const ring = [...animals.filter((animal) => animal.tier === 'S'), ...animals.filter((animal) => animal.tier === 'A')].slice(0, 12);
const classics = PAIRS.filter((pair) => pair.classic).map((pair) => [pair.a.slug, pair.b.slug, pair.a.name, pair.b.name]);
const fresh = animals
    .filter((animal) => animal.profile.researchedAt)
    .sort((a, b) => String(b.profile.researchedAt).localeCompare(String(a.profile.researchedAt)) || a.rank - b.rank)
    .slice(0, 8);
const firstPair = PAIRS.find((pair) => pair.classic);
const featured = animals[0];

const title = `${SITE.name}: Who Would Win? Animal Matchups, Stats & Powerscaling (${animals.length} Animals)`;
const description = `Who would win? Compare any two of ${animals.length} real animals with research-backed battle stats, tier lists and power rankings, sources on every profile. Group fights like 100 men vs a gorilla, and an animated fight.`;
const MENU = [
    { href: '/compare', label: 'Who would win?', sub: 'Pick two animals and fight', icon: 'vs', cls: 'btn-hot primary' },
    { href: '/shows', label: 'Shows', sub: 'ABS Originals: watch & earn BattlePoints', icon: 'tv', badge: 'New' },
    { href: '/stats', label: 'Animals', sub: `${animals.length} fighters, full stats`, icon: 'paw' },
    { href: '/tier-list', label: 'Tier list', sub: `S to F, all ${animals.length}`, icon: 'crown' },
    { href: '/rankings', label: 'Rankings', sub: 'Strongest, fastest, biggest', icon: 'medal' },
    { href: '/tournament', label: 'Tournament', sub: 'Run a bracket', icon: 'trophy' },
    { href: '/community', label: 'Community', sub: 'Votes, talk, leaderboards', icon: 'friends' }
];
const jsonLd = [
    {
        '@type': 'WebPage',
        '@id': `${SITE.url}/#home`,
        url: `${SITE.url}/`,
        name: title,
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        about: { '@type': 'Thing', name: 'Animal powerscaling and hypothetical animal matchups' },
        mainEntity: {
            '@type': 'Dataset',
            name: 'Animal Battle Stats dataset',
            description: `Six battle ratings (attack, defense, agility, stamina, intelligence, special), physical measurements and sourced research profiles for ${animals.length} animals.`,
            url: absoluteUrl('/stats'),
            license: 'https://creativecommons.org/licenses/by/4.0/',
            creator: { '@id': `${SITE.url}/#organization` },
            distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absoluteUrl('/animal_stats.json') }],
            variableMeasured: ['attack', 'defense', 'agility', 'stamina', 'intelligence', 'special', 'weight', 'top speed', 'bite force']
        }
    }
];
---

<Base title={title} description={description} path="/" image="/images/og/site.jpg" imageAlt="Animal Battle Stats" jsonLd={jsonLd} active="" biome="savanna" seed={3}>
    <div class="home screen-grid">
        <section class="menu-col enter">
            <div class="logo-block">
                <img src="/images/logo.png" alt="Animal Battle Stats logo" width="120" height="120" />
                <div>
                    <h1 class="screen-title">Animal Battle Stats</h1>
                    <p class="tag">The animal powerscaling database</p>
                </div>
            </div>
            <p class="intro">Research-backed battle stats for {animals.length} real animals: {researchedCount} full research profiles with {sourceCount.toLocaleString('en-US')} cited sources. Settle any "who would win" debate.</p>
            <nav class="main-menu" aria-label="Main menu">
                {MENU.map((item) => (
                    <a class={`mm ${item.cls || ''}`} href={item.href}>
                        <Icon name={item.icon} size={40} />
                        <span><b>{item.label}{item.badge && <em class="mm-new">{item.badge}</em>}</b><small>{item.sub}</small></span>
                    </a>
                ))}
            </nav>
            <button class="home-search field" type="button" data-open-search>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
                <span>Find an animal, or "lion vs tiger"</span><kbd class="chip">/</kbd>
            </button>
        </section>

        <section class="show-col" aria-label="Featured">
            <div class="carousel enter-2" data-carousel aria-label="Top tier animals">
                <div class="ring" data-ring style={`--n:${ring.length}`}>
                    {ring.map((animal, index) => (
                        <div class="slot" style={`--i:${index}`}><HoloCard animal={animal} rank priority={index < 4} sizes="200px" /></div>
                    ))}
                </div>
                <p class="ring-hint">Drag to spin · top {ring.length} fighters</p>
            </div>

            <div class="tiles enter-3">
                <a class="tile panel daily" href={`/compare/${firstPair.slug}`} data-daily>
                    <span class="tile-k"><Icon name="swords" size={22} />Daily matchup<span class="tile-pay"><img src="/images/icons/abs/coin.webp" alt="" width="16" height="16" />Call it +10</span></span>
                    <span class="daily-row">
                        <span class="dart"><AnimalImage animal={firstPair.a} sizes="110px" alt="" class="d-a animal-art" /></span>
                        <em>VS</em>
                        <span class="dart"><AnimalImage animal={firstPair.b} sizes="110px" alt="" class="d-b animal-art" /></span>
                    </span>
                    <strong data-daily-title>{firstPair.a.name} vs {firstPair.b.name}</strong>
                </a>
                <a class="tile panel gold aotd" href={`/stats/${featured.slug}`} data-aotd>
                    <span class="tile-k"><Icon name="star" size={22} />Animal of the day</span>
                    <span class="aotd-row">
                        <span class="aart"><AnimalImage animal={featured} sizes="120px" alt="" class="aotd-img animal-art" /></span>
                        <span><strong data-aotd-name>{featured.name}</strong><small data-aotd-meta>#{featured.rank} · {featured.tier} tier · PWR {fmtScore(featured.powerIndex)}</small></span>
                    </span>
                </a>
                <a class="tile panel hot roblox" href="/roblox">
                    <span class="tile-k"><RobloxMark size={16} />{ROBLOX.live ? 'Live on Roblox' : 'Coming to Roblox'}</span>
                    <strong>Collect all {gameAnimals.length} as holo-cards</strong>
                    <small>Battle them in a 3D world, run the goofy crowd fights and climb the leaderboards.</small>
                    <span class={`btn btn-sm ${ROBLOX.live ? 'btn-play' : 'btn-white'}`}><RobloxMark size={18} />{ROBLOX.live ? 'Play free' : 'See the game'}</span>
                </a>
            </div>

            <div class="ticker enter-3" aria-label="Recently researched">
                <span class="tk-label"><Icon name="book" size={20} />Just researched</span>
                <div class="tk-track">
                    <div class="tk-run">
                        {[...fresh, ...fresh].map((animal) => <a href={`/stats/${animal.slug}`}>{animal.name} <b>{animal.tier}</b></a>)}
                    </div>
                </div>
            </div>
        </section>
    </div>
    <script type="application/json" id="home-data" set:html={JSON.stringify({ classics })}></script>
</Base>

<script>
    import { loadAnimalIndex } from '../scripts/site.js';

    // Swap a server-rendered image for another animal, keeping equal-area sizing.
    function swapArt(img, animal) {
        img.removeAttribute('srcset');
        img.style.setProperty('--ar', animal.ar || 1);
        img.style.setProperty('--k', animal.k || 1);
        img.src = animal.m;
    }

    // ---- 3D ring: auto spin, drag to rotate, slow on hover. Time-based, so it
    // turns at the same speed on 60 and 120 Hz screens, and every change of speed
    // eases instead of snapping. Pauses while off screen or in a hidden tab.
    const carousel = document.querySelector('[data-carousel]');
    const ring = document.querySelector('[data-ring]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CRUISE = reduced ? 0 : 5; // degrees a second
    const DRAG = 0.25; // degrees per pixel dragged
    let angle = 0;
    let direction = -1;
    let speed = -CRUISE;
    let fling = 0;
    let dragging = false;
    let hovering = false;
    let lastX = 0;
    let lastMove = 0;
    let last = 0;
    let raf = 0;
    let visible = true;
    function paint() {
        ring.style.transform = `translateZ(calc(var(--radius) * -1)) rotateX(-6deg) rotateY(${angle.toFixed(3)}deg)`;
    }
    function frame(now) {
        const dt = last ? Math.min(0.12, (now - last) / 1000) : 0;
        last = now;
        if (!dragging) {
            const goal = direction * CRUISE * (hovering ? 0.15 : 1);
            speed += (goal - speed) * (1 - Math.exp(-dt * 2.2));
            angle += speed * dt;
        }
        paint();
        raf = requestAnimationFrame(frame);
    }
    function run() {
        if (raf || !visible || document.hidden) return;
        last = 0;
        raf = requestAnimationFrame(frame);
    }
    function stop() {
        cancelAnimationFrame(raf);
        raf = 0;
    }
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) run(); else stop(); }).observe(carousel);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else run(); });
    run();
    // Dragging the ring must never pick up a card's picture or link (the browser's
    // own drag and drop, which showed a ghost image and the page address).
    carousel.querySelectorAll('a, img').forEach((node) => node.setAttribute('draggable', 'false'));
    carousel.addEventListener('dragstart', (event) => event.preventDefault());
    carousel.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') hovering = true; });
    carousel.addEventListener('pointerleave', () => { hovering = false; });
    carousel.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        // No text selection or native drag from a mouse press; taps still click.
        if (event.pointerType === 'mouse') event.preventDefault();
        dragging = true;
        fling = 0;
        lastX = event.clientX;
        lastMove = performance.now();
        carousel.setPointerCapture(event.pointerId);
    });
    carousel.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const now = performance.now();
        const turn = (event.clientX - lastX) * DRAG;
        const velocity = turn / Math.max(8, now - lastMove) * 1000;
        fling = fling * 0.5 + velocity * 0.5;
        angle += turn;
        lastX = event.clientX;
        lastMove = now;
        if (!raf) paint();
    });
    const release = () => {
        if (!dragging) return;
        dragging = false;
        // A drag that stopped before letting go doesn't fling.
        const flung = performance.now() - lastMove < 90 ? fling : 0;
        speed = Math.max(-360, Math.min(360, flung));
        if (Math.abs(flung) > CRUISE) direction = Math.sign(flung);
    };
    carousel.addEventListener('pointerup', release);
    carousel.addEventListener('pointercancel', release);
    // Only follow a card link when the pointer did not drag.
    let downX = 0;
    carousel.addEventListener('pointerdown', (event) => { downX = event.clientX; }, true);
    carousel.addEventListener('click', (event) => { if (Math.abs(event.clientX - downX) > 6) event.preventDefault(); }, true);

    // ---- daily picks (same for everyone, changes at midnight UTC)
    const day = Math.floor(Date.now() / 86400000);
    const { classics } = JSON.parse(document.getElementById('home-data').textContent);
    const pair = classics[day % classics.length];
    loadAnimalIndex().then((list) => {
        const bySlug = new Map(list.map((animal) => [animal.s, animal]));
        const a = bySlug.get(pair[0]);
        const b = bySlug.get(pair[1]);
        if (a && b) {
            const daily = document.querySelector('[data-daily]');
            daily.href = `/compare/${pair[0]}-vs-${pair[1]}`;
            swapArt(daily.querySelector('.d-a'), a);
            swapArt(daily.querySelector('.d-b'), b);
            daily.querySelector('[data-daily-title]').textContent = `${a.n} vs ${b.n}`;
        }
        const pool = list.filter((animal) => animal.res);
        const pick = pool[(day * 7919) % pool.length];
        if (pick) {
            const aotd = document.querySelector('[data-aotd]');
            aotd.href = `/stats/${pick.s}`;
            swapArt(aotd.querySelector('.aotd-img'), pick);
            aotd.querySelector('[data-aotd-name]').textContent = pick.n;
            aotd.querySelector('[data-aotd-meta]').textContent = `#${pick.r} · ${pick.tier} tier · PWR ${Number.isInteger(pick.p) ? pick.p : pick.p.toFixed(1)}`;
        }
    });
</script>

<style>
    .home { grid-template-columns: minmax(340px, 0.8fr) minmax(0, 1.2fr); max-width: 1500px; margin: 0 auto; align-items: stretch; }
    .menu-col { min-height: 0; display: flex; flex-direction: column; gap: 12px; padding: clamp(4px, 1vw, 12px); }
    .logo-block { display: flex; align-items: center; gap: 14px; }
    .logo-block img { width: clamp(76px, 8vw, 112px); height: auto; filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.6)); animation: float 6s ease-in-out infinite; }
    @keyframes float { 50% { transform: translateY(-5px); } }
    .logo-block h1 { font-size: clamp(2rem, 3.6vw, 3.4rem); }
    .tag { margin: 6px 0 0; font-family: var(--font-display); font-size: 1rem; font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase; color: var(--cyan-2); }
    .intro { margin: 0; font-size: 0.9rem; color: var(--text-2); max-width: 52ch; }
    .main-menu { display: grid; gap: 8px; }
    .mm {
        position: relative;
        display: flex; align-items: center; gap: 14px;
        min-height: 56px;
        padding: 8px 16px;
        background: var(--hex) 0 0 / var(--hex-size), linear-gradient(180deg, #222429, #16171b);
        border: 1px solid var(--frame);
        border-radius: 10px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
        transition: transform 0.15s var(--ease), border-color 0.15s;
    }
    .mm:hover { transform: translateX(4px); border-color: var(--frame-2); }
    .mm::after { content: ""; position: absolute; right: 16px; top: 50%; width: 9px; height: 14px; transform: translateY(-50%); background: var(--gold); clip-path: polygon(0 0, 100% 50%, 0 100%); opacity: 0; transition: opacity 0.15s; }
    .mm:hover::after { opacity: 1; }
    .mm b { display: block; font-family: var(--font-display); font-size: clamp(1.25rem, 1.8vw, 1.55rem); font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1; }
    .mm small { font-size: 0.74rem; color: var(--muted); }
    .mm.primary { min-height: 70px; color: #1d1400; background: linear-gradient(180deg, #ffd54a, #eaa400); border-color: #ffe28a; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 24px rgba(246, 180, 0, 0.18); }
    .mm.primary small { color: #4a3600; }
    .mm.primary::after { background: #1d1400; }
    .mm-new { display: inline-block; margin-left: 8px; padding: 1px 7px 2px; font-style: normal; font-family: var(--font-body); font-size: 0.62rem; font-weight: 900; letter-spacing: 0.08em; vertical-align: middle; color: #1d1400; background: var(--gold); border-radius: 5px; transform: translateY(-2px); }
    .mm.primary b { font-size: clamp(1.5rem, 2.2vw, 2rem); }
    .home-search { cursor: text; gap: 10px; color: var(--muted); text-align: left; }
    .home-search span { flex: 1; }

    .show-col { min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto auto; gap: 12px; }
    .carousel { --radius: 470px; position: relative; min-height: 0; perspective: 1600px; display: grid; place-items: center; cursor: grab; touch-action: pan-y; user-select: none; }
    .carousel::before { content: ""; position: absolute; left: 12%; right: 12%; bottom: 6%; height: 22%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255, 190, 90, 0.35), rgba(246, 180, 0, 0.12) 55%, transparent 75%); transform: perspective(500px) rotateX(66deg); }
    .carousel::after { content: ""; position: absolute; left: 50%; top: -10%; width: 60%; height: 90%; transform: translateX(-50%); background: conic-gradient(from 180deg at 50% 0%, transparent 42%, rgba(255, 220, 150, 0.10) 47%, rgba(255, 220, 150, 0.18) 50%, rgba(255, 220, 150, 0.10) 53%, transparent 58%); pointer-events: none; }
    .carousel:active { cursor: grabbing; }
    .carousel :global(a), .carousel :global(img) { -webkit-user-drag: none; -webkit-touch-callout: none; user-select: none; }
    .ring { position: relative; z-index: 1; width: 196px; height: 261px; transform-style: preserve-3d; will-change: transform; }
    .slot { position: absolute; inset: 0; transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--radius)); backface-visibility: hidden; }
    /* Twelve cards turning in 3D: no pointer tilt, pulse or moving foil on them
       (repainting those every frame is what made the ring stutter). */
    .slot :global(.card) { width: 100%; height: 100%; animation: none; transform: none; transition: none; }
    .slot :global(.card-inner::after) { animation: none; }
    .slot :global(.card-glare) { display: none; }
    .ring-hint { position: absolute; bottom: 4px; margin: 0; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }

    .tiles { display: grid; grid-template-columns: 1.1fr 1fr 1fr; gap: 12px; }
    .tile { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; min-height: 150px; transition: transform 0.18s var(--ease), filter 0.18s; }
    .tile:hover { transform: translateY(-3px); filter: brightness(1.1); }
    .tile-k { display: flex; align-items: center; gap: 6px; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan-2); }
    .tile strong { font-family: var(--font-display); font-size: 1.25rem; font-weight: 900; text-transform: uppercase; line-height: 1.05; }
    .tile small { font-size: 0.78rem; color: var(--text-2); }
    .daily-row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 4px; }
    .dart { height: 64px; display: grid; place-items: center; container-type: size; }
    .daily-row :global(img) { --fit: 1; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.6)); }
    .daily-row :global(.d-b) { transform: scaleX(-1); }
    .daily-row em { font-style: normal; font-family: var(--font-display); font-weight: 900; font-size: 1.3rem; color: var(--gold); }
    .aotd-row { display: flex; align-items: center; gap: 10px; }
    .aart { flex: none; width: 96px; height: 72px; display: grid; place-items: center; container-type: size; }
    .aotd-row :global(img) { --fit: 0.9; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.6)); }
    .aotd-row strong { display: block; }
    .roblox .tile-k { color: var(--gold-2); }
    .tile-pay { display: inline-flex; align-items: center; gap: 3px; margin-left: auto; padding: 1px 8px; font-size: 0.62rem; letter-spacing: 0.06em; color: var(--gold-2); background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.4); border-radius: 999px; }
    .roblox .btn { margin-top: auto; align-self: flex-start; }

    .ticker { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 6px 10px; background: rgba(9, 10, 12, 0.65); border: 1px solid var(--line); border-radius: 10px; }
    .tk-label { display: flex; align-items: center; gap: 6px; flex-shrink: 0; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-2); }
    .tk-track { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
    .tk-run { display: flex; gap: 22px; width: max-content; animation: marquee 40s linear infinite; }
    .tk-run a { font-size: 0.82rem; font-weight: 700; white-space: nowrap; color: var(--text-2); }
    .tk-run a:hover { color: #fff; }
    .tk-run b { color: var(--gold-2); font-family: var(--font-display); }
    @keyframes marquee { to { transform: translateX(-50%); } }

    @media (max-width: 1100px) { .carousel { --radius: 380px; } .ring { width: 160px; height: 213px; } }
    /* Short laptop windows: a tighter menu so everything fits without cutting off the last buttons. */
    @media (max-height: 800px) and (min-width: 901px) {
        .menu-col { gap: 8px; }
        .logo-block img { width: 64px; }
        .logo-block h1 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
        .intro { display: none; }
        .main-menu { gap: 6px; }
        .mm { padding: 6px 16px; }
        .mm.primary { padding: 9px 16px; }
        .mm b { font-size: 1.2rem; }
        .mm.primary b { font-size: 1.5rem; }
        .mm small { font-size: 0.68rem; }
        .ring { width: 160px; height: 213px; }
        .carousel { --radius: 380px; }
        .ring-hint { display: none; }
        .tile { min-height: 0; padding: 10px 12px; }
        .dart { height: 52px; }
    }
    @media (max-width: 900px) {
        /* One screen on phones too: the ring takes whatever height is left. */
        .home { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); gap: 8px; }
        .menu-col { gap: 8px; }
        .intro { display: none; }
        .home-search { min-height: 44px; }
        .main-menu { grid-template-columns: 1fr 1fr; gap: 6px; }
        .mm { min-height: 48px; padding: 6px 12px; gap: 8px; }
        .mm::after { display: none; }
        .mm.primary { grid-column: 1 / -1; min-height: 56px; }
        .mm small { display: none; }
        .mm :global(img) { width: 30px; height: 30px; }
        .show-col { grid-template-rows: minmax(200px, 1fr) auto; gap: 8px; }
        .carousel { container-type: size; }
        /* Twelve cards around the ring need a radius of about 1.9 card widths, or they overlap. */
        .ring { height: min(220px, 86cqh); width: auto; aspect-ratio: 3 / 4; --radius: calc(min(220px, 86cqh) * 1.45); }
        .logo-block { gap: 10px; }
        .logo-block img { width: 52px; }
        .logo-block h1 { font-size: 1.7rem; }
        .tag { margin-top: 3px; font-size: 0.72rem; letter-spacing: 0.16em; }
        .tile-pay { display: none; }
        .dart { height: 48px; }
        .aart { width: 72px; height: 54px; }
        .ring-hint, .ticker { display: none; }
        .tiles { grid-template-columns: 1fr 1fr; }
        .tiles { gap: 8px; }
        .tiles .roblox { grid-column: 1 / -1; min-height: 0; flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 10px; }
        .tiles .roblox small { display: none; }
        .tiles .roblox strong { flex: 1; font-size: 1rem; }
        .tiles .roblox .tile-k { flex-basis: 100%; }
        .tile { min-height: 0; }
    }
    /* Small phones: the HUD's Play button stands in for the Roblox tile. */
    @media (max-width: 900px) and (max-height: 700px) {
        .tiles .roblox { display: none; }
    }
</style>
