---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HoloCard from '../components/HoloCard.astro';
import { getAnimal, rosterSize } from '../lib/catalog.js';

const sloth = getAnimal('sloth') || getAnimal('snapping-turtle');
---
<Base title="Page not found | Animal Battle Stats" description={`This page does not exist. Search ${rosterSize} animals or jump back into the arena.`} path="/404" noindex biome="jungle">
    <div class="nf">
        <div class="nf-card"><HoloCard animal={sloth} tag="span" sizes="220px" meta="Still looking…" /></div>
        <div class="nf-copy">
            <p class="eyebrow"><Icon name="alert" size={22} />Error 404</p>
            <h1 class="screen-title">This page wandered off</h1>
            <p>The link is broken or the page moved. Search for an animal or head back to the arena.</p>
            <div class="btn-row">
                <button class="btn btn-cyan" type="button" data-open-search><Icon name="paw" size={26} />Search animals</button>
                <a class="btn btn-hot" href="/compare"><Icon name="vs" size={26} />Who would win?</a>
                <a class="btn" href="/"><Icon name="home" size={26} />Home</a>
            </div>
        </div>
    </div>
</Base>
<script>
    // Wrong addresses that still say what they want: a matchup typed the other way round
    // (/compare/african-lion-vs-siberian-tiger when the page is siberian-tiger-vs-african-lion), any
    // other pair (it opens in Versus), and an animal page under a shorter name (/stats/lion).
    const path = location.pathname.replace(/\/+$/, '').toLowerCase();
    const pair = path.match(/^\/compare\/([a-z0-9-]+?)-vs-([a-z0-9-]+)$/);
    const animal = path.match(/^\/stats\/([a-z0-9-]+)$/);
    if (pair) {
        const [, a, b] = pair;
        fetch(`/compare/${b}-vs-${a}`, { method: 'HEAD' })
            .then((response) => location.replace(response.ok ? `/compare/${b}-vs-${a}` : `/compare?a=${a}&b=${b}`))
            .catch(() => location.replace(`/compare?a=${a}&b=${b}`));
    } else if (animal) {
        const want = animal[1];
        fetch('/data/animals-lite.json').then((response) => response.json()).then((list) => {
            const words = want.split('-');
            const match = list.find((item) => item.s === want)
                || list.find((item) => item.s.endsWith(`-${want}`))
                || list.find((item) => words.every((word) => item.s.split('-').includes(word)));
            if (match) location.replace(`/stats/${match.s}`);
        }).catch(() => {});
    }
</script>
<style>
    .nf { height: 100%; display: flex; align-items: center; justify-content: center; gap: clamp(20px, 5vw, 60px); flex-wrap: wrap; }
    .nf-card { width: 200px; transform: rotate(-6deg); }
    .nf-copy { max-width: 520px; }
    .nf-copy p { color: var(--text-2); }
    .nf-copy .screen-title { margin: 6px 0 12px; }
</style>
