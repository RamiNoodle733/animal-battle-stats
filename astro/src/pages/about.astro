---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { STATS, TIERS, POWER_WEIGHTS, researchedCount, sourceCount, lastResearchDate, animals } from '../lib/catalog.js';
import { SITE, SOCIAL, absoluteUrl } from '../lib/site.js';

const title = `About Animal Battle Stats: How the Ratings, Tiers and Matchups Work | ${SITE.name}`;
const description = 'How Animal Battle Stats researches 225 animals, turns sources into six 0-100 battle ratings, builds the power index and tiers, and predicts who would win.';
const pct = (value) => `${Math.round(value * 100)}%`;
const faq = [
    { q: 'What is Animal Battle Stats?', a: `Animal Battle Stats (animalbattlestats.com) is a free animal powerscaling site. It rates ${animals.length} real animals on six battle stats, ranks them into tiers, and predicts hypothetical matchups. ${researchedCount} animals have full research profiles with cited sources.` },
    { q: 'Are the battle ratings scientific measurements?', a: 'No. Measurements such as weight, speed and bite force come from sources. The six battle ratings are editorial judgments built from that research, on one absolute scale so every animal can be compared.' },
    { q: 'Is it pound-for-pound?', a: 'No. Ratings are absolute. An ant is incredibly strong for its size and still rates far below a gorilla, because a real fight is about absolute force, weapons and durability.' },
    { q: 'Which animal is rated for males or females?', a: 'Each profile rates a healthy adult. When one sex is clearly larger or does the fighting, that sex is used: usually males, but females for species like eagles, most spiders and anacondas.' },
    { q: 'Does the higher power index always win?', a: 'No. The matchup model gives the stronger animal better odds, not a guarantee, and it ignores terrain, ambush and motivation. Those are exactly what the written verdicts discuss.' },
    { q: 'Who made Animal Battle Stats?', a: `${SITE.founder} designed and built Animal Battle Stats as an animal powerscaling and community project, with a companion game on Roblox.` }
];
const jsonLd = [
    { '@type': 'AboutPage', url: absoluteUrl('/about'), name: 'About Animal Battle Stats', description, isPartOf: { '@id': `${SITE.url}/#website` } },
    { '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
];
const TABS = [['about', 'About', 'paw'], ['ratings', 'Ratings', 'claws'], ['model', 'Matchups', 'vs'], ['sources', 'Sources', 'scroll'], ['faq', 'FAQ', 'book']];
const sourcesList = [
    ['Animal Diversity Web (University of Michigan)', 'https://animaldiversity.org/'],
    ['IUCN Red List', 'https://www.iucnredlist.org/'],
    ['Smithsonian National Zoo', 'https://nationalzoo.si.edu/'],
    ['San Diego Zoo Wildlife Alliance', 'https://animals.sandiegozoo.org/'],
    ['NOAA Fisheries', 'https://www.fisheries.noaa.gov/'],
    ['Peer-reviewed papers (linked per animal)', '/stats']
];
---

<Base title={title} description={description} path="/about" jsonLd={jsonLd} biome="forest">
    <div class="info screen-grid">
        <aside class="panel side">
            <div class="panel-head"><Icon name="book" size={30} /><h1 class="panel-title">About ABS</h1></div>
            <div class="panel-body">
                <p class="lede">The animal powerscaling database: real animals, researched stats, and a transparent way to settle "who would win".</p>
                <dl class="facts-grid">
                    <div><dt>Animals</dt><dd>{animals.length}</dd></div>
                    <div><dt>Researched</dt><dd>{researchedCount}</dd></div>
                    <div><dt>Sources cited</dt><dd>{sourceCount.toLocaleString('en-US')}</dd></div>
                    <div><dt>Last research</dt><dd style="font-size:1rem">{lastResearchDate || '—'}</dd></div>
                </dl>
                <div class="btn-row" style="margin-top:14px">
                    <a class="btn btn-cyan btn-sm" href={`https://github.com/RamiNoodle733/animal-battle-stats/issues/new?template=data-correction.yml`} rel="noopener" target="_blank">Report a correction</a>
                    <a class="btn btn-sm" href={`mailto:${SITE.email}`}>Email us</a>
                </div>
                <div class="socials">{SOCIAL.map((item) => <a class="chip" href={item.url} rel="me noopener" target="_blank">{item.name}</a>)}</div>
            </div>
        </aside>

        <section class="panel doc">
            <div class="tabs" role="tablist">
                {TABS.map(([id, label, icon], index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`p-${id}`} data-tab={id}><Icon name={icon} size={22} />{label}</button>)}
            </div>
            <div class="pane scroll prose" id="p-about" role="tabpanel">
                <h2 class="pane-h">What this is</h2>
                <p>Animal Battle Stats rates {animals.length} real animals, from army ants to the Megalodon, on six battle stats. Every rating sits on one absolute 0–100 scale, so a house cat and a hippo can be compared directly. The stats power the tier list, the rankings, the matchup simulator and the Animal Battle Stats game on Roblox.</p>
                <p>Each animal is researched from scratch: size, weapons, defenses, senses, behavior and real fighting records, with sources listed on its profile. A healthy adult of the stronger or fighting sex is the reference specimen.</p>
                <h2 class="pane-h">How a profile is built</h2>
                <ol>
                    <li><b>Pin down the animal.</b> Common name, exact species and the specimen being rated.</li>
                    <li><b>Collect measurements.</b> Weight, size, speed, lifespan and bite force from zoos, universities, agencies and papers. Values without solid evidence are left blank instead of guessed.</li>
                    <li><b>Study how it fights.</b> Weapons, defenses, endurance, senses, tactics and known conflicts.</li>
                    <li><b>Rate it.</b> Twelve detailed ratings roll up into the six headline stats, checked against similar animals so the scale stays consistent.</li>
                    <li><b>Publish and correct.</b> Research updates flow into the site automatically; corrections are welcome.</li>
                </ol>
            </div>
            <div class="pane scroll prose" id="p-ratings" role="tabpanel" hidden>
                <h2 class="pane-h" id="ratings">The six battle stats</h2>
                <div class="stat-defs">
                    {STATS.map((stat) => <div class={stat.cls}><b>{stat.label}</b><span>{stat.blurb}</span></div>)}
                </div>
                <h2 class="pane-h">Power index &amp; tiers</h2>
                <p>The power index combines the six stats: attack {pct(POWER_WEIGHTS.attack)}, defense {pct(POWER_WEIGHTS.defense)}, agility {pct(POWER_WEIGHTS.agility)}, stamina {pct(POWER_WEIGHTS.stamina)}, special {pct(POWER_WEIGHTS.special)} and intelligence {pct(POWER_WEIGHTS.intelligence)}. Fighting stats count most because they decide real fights.</p>
                <div class="tier-key">{TIERS.map((tier) => <span class={`tier-${tier.id.toLowerCase()}`}><i class={`tier-badge tier-${tier.id.toLowerCase()}`}>{tier.id}</i>{tier.name} · power {tier.id === 'F' ? `under ${TIERS[4].min}` : `${tier.min}+`}</span>)}</div>
            </div>
            <div class="pane scroll prose" id="p-model" role="tabpanel" hidden>
                <h2 class="pane-h" id="model">How "who would win" works</h2>
                <p>For two animals, each stat gap is multiplied by its weight (the same weights as the power index) and the results are added up. That margin becomes a win probability on a logistic curve, capped between 5% and 95% because upsets happen. The animated fight draws a winner with that probability, so a 70% favorite still loses three fights in ten.</p>
                <p>The model deliberately ignores terrain, ambush, group fights and motivation. The written verdict on each matchup page calls those out, for example when one animal lives in water and the other on land.</p>
                <p>Upsets, rematches and fan votes are part of the fun. Fan votes are shown next to the model and never change the ratings.</p>
            </div>
            <div class="pane scroll prose" id="p-sources" role="tabpanel" hidden>
                <h2 class="pane-h">Where the facts come from</h2>
                <p>Every researched profile lists its own sources with what each one supports. The most common references:</p>
                <ul>{sourcesList.map(([name, url]) => <li><a href={url} rel="noopener" target={url.startsWith('http') ? '_blank' : undefined}>{name}</a></li>)}</ul>
                <p>When sources disagree, profiles use a representative adult value and explain the range instead of picking the most dramatic number. Unverified internet figures (like many viral bite-force claims) are rejected.</p>
                <h2 class="pane-h">Photos</h2>
                <p>Animal images are real photographs of adult animals with the background removed, from freely licensed sources such as Wikimedia Commons. Photographers and licenses are credited on each profile and on the <a href="/credits">credits page</a>.</p>
                <h2 class="pane-h">Data for AI assistants</h2>
                <p>A plain-text summary lives at <a href="/llms.txt">/llms.txt</a>, the full dataset at <a href="/llms-full.txt">/llms-full.txt</a> and <a href="/animal_stats.json">/animal_stats.json</a>. Ratings are free to cite with a link to the animal's page.</p>
            </div>
            <div class="pane scroll" id="p-faq" role="tabpanel" hidden>
                <div class="faq">{faq.map((item, index) => <details open={index === 0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
            </div>
        </section>
    </div>
</Base>

<script>
    const tabs = [...document.querySelectorAll('[data-tab]')];
    function show(id) {
        for (const tab of tabs) {
            const on = tab.dataset.tab === id;
            tab.setAttribute('aria-selected', String(on));
            document.getElementById(`p-${tab.dataset.tab}`).hidden = !on;
        }
    }
    tabs.forEach((tab) => tab.addEventListener('click', () => { show(tab.dataset.tab); history.replaceState(null, '', `#${tab.dataset.tab === 'about' ? '' : tab.dataset.tab}`); }));
    const hash = location.hash.slice(1);
    const map = { ratings: 'ratings', model: 'model', sources: 'sources', faq: 'faq', credits: 'sources' };
    if (map[hash]) show(map[hash]);
</script>

<style>
    .info { grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); max-width: 1300px; margin: 0 auto; }
    .side .lede { color: var(--text-2); font-size: 0.95rem; }
    .socials { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .doc { min-height: 0; }
    .pane { flex: 1; min-height: 0; padding: 16px 20px; }
    .pane-h { margin: 14px 0 8px; font-family: var(--font-display); font-size: 1.35rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text); transform: skewX(-6deg); }
    .pane ol, .pane ul { padding-left: 20px; display: grid; gap: 6px; }
    .stat-defs { display: grid; gap: 8px; }
    .stat-defs div { padding: 10px 12px; background: rgba(3, 6, 16, 0.45); border: 1px solid var(--line); border-left: 3px solid var(--stat); border-radius: 8px; }
    .stat-defs b { display: block; font-family: var(--font-display); font-size: 1.1rem; text-transform: uppercase; color: var(--stat); }
    .tier-key { display: grid; gap: 6px; }
    .tier-key span { display: flex; align-items: center; gap: 8px; font-weight: 700; }
    .tier-key i { font-style: normal; height: 26px; min-width: 28px; font-size: 1rem; }
    @media (max-width: 860px) { .info { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); } .side .facts-grid, .side .socials { display: none; } }
</style>
