---
// One ABS Originals episode as a poster card (hub rails, "more episodes").
import { poster, clock, getShow } from '../lib/shows.js';

const { episode, current = false, eager = false } = Astro.props;
const show = getShow(episode.show);
---
<a class:list={['ep-card', { 'is-current': current }]} href={episode.url} data-ep-card={episode.id} style={`--show:${show.accent}`} aria-current={current ? 'page' : undefined}>
    <span class="ep-thumb">
        <img src={poster(episode.id, true)} alt={`${show.name} episode ${episode.number}: ${episode.title}`} width="640" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        <span class="ep-no">EP {episode.number}</span>
        <span class="ep-len">{clock(episode.seconds)}</span>
        <span class="ep-seen"><img src="/images/ui/icons/check.svg" alt="" width="16" height="16" loading="lazy" />Watched</span>
    </span>
    <b>{episode.title}</b>
    <small>{episode.hook}</small>
</a>
