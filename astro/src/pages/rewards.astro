---
// Rewards: one game screen, like the game's Rewards, Quests, Trainer Pass and Shop
// menus. A wallet plate and a menu on the left, one stage on the right showing the
// chosen page (daily reward, quests, Season Pass, shop, how to earn). Built from
// lib/economy.js; scripts/rewards.js fills in the player's progress from
// /api/auth?action=hub. Fits the screen: only the pass track scrolls (sideways).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import economy from '../../../lib/economy.js';
import { SITE } from '../lib/site.js';

const { ACTIONS, ITEMS, LOGIN, PASS, CALL_BONUS, QUEST_CHEST, passReward } = economy;
const itemName = new Map(ITEMS.map((item) => [item.id, item.name]));
const itemKind = new Map(ITEMS.map((item) => [item.id, item.kind]));
const tiers = Array.from({ length: PASS.tiers }, (_, index) => passReward(index + 1));
const frames = ITEMS.filter((item) => item.kind === 'frame');
const titles = ITEMS.filter((item) => item.kind === 'title');
const MENU = [
    ['daily', 'gift', 'Daily reward', 'Log in every day'],
    ['quests', 'scroll', 'Quests', 'Three a day, plus a chest'],
    ['pass', 'crown', 'Season Pass', `${PASS.tiers} free tiers`],
    ['shop', 'cards', 'Shop', 'Card frames and titles'],
    ['earn', 'coin', 'How to earn', 'BattlePoints and XP']
];
const EARN = [
    ['target', 'Call a fight', 'Who Would Win?', ACTIONS.matchup_call, 'matchup_call', `a right call pays +${CALL_BONUS.coins} BP or more, growing with your streak`, '/compare'],
    ['medal', 'Vote on an animal', 'Rankings', ACTIONS.vote, 'vote', 'each animal once a day', '/rankings'],
    ['book', 'Comment', 'Animals and matchups', ACTIONS.comment, 'comment', `replies pay +${ACTIONS.reply.coins} BP`, '/community'],
    ['trophy', 'Ranked tournament', 'Tournament', ACTIONS.tournament_participate, 'tournament_participate', 'finish a bracket', '/tournament']
];
const endDate = new Date(PASS.endsAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const earnText = (item) => ({ callStreak: `Call ${item.earn.value} right in a row`, calls: `Call ${item.earn.value} fights`, votes: `Vote on ${item.earn.value} animals`, loginRun: `Log in ${item.earn.value} days running`, pass: `Pass tier ${item.earn.value}` }[item.earn.what]);
const BP = '/images/ui/icons/coin.svg';
---

<Base title={`Rewards: BattlePoints, Daily Reward, Quests & Season Pass | ${SITE.name}`} description="Earn BattlePoints and XP for calling fights, voting and playing: a daily login reward, daily quests, the Season 1 Pass and a shop of profile frames and titles." path="/rewards" noindex active="rewards" biome="savanna" seed={17}>
    <h1 class="visually-hidden">Rewards</h1>
    <div class="rw screen-grid" data-rw data-state="loading">
        <aside class="rw-side">
            <div class="panel gold wallet enter">
                <div class="w-bp">
                    <img src={BP} alt="" width="56" height="56" />
                    <span><small>BattlePoints</small><b data-w-bp>–</b></span>
                </div>
                <div class="w-level">
                    <span class="w-lvl" data-w-level>–</span>
                    <span class="w-xp"><span class="w-xpbar"><i data-w-xpbar></i></span><small data-w-xptext>Level</small></span>
                </div>
                <div class="w-chips">
                    <span class="w-chip"><Icon name="target" size={22} /><b data-w-call>–</b><small>Call streak</small></span>
                    <span class="w-chip"><Icon name="fire" size={22} /><b data-w-run>–</b><small>Days running</small></span>
                </div>
            </div>
            <nav class="rw-menu enter-2" aria-label="Rewards">
                {MENU.map(([page, icon, label, sub]) => (
                    <button class="mm" type="button" data-go={page} aria-pressed={page === 'daily' ? 'true' : 'false'}>
                        <Icon name={icon} size={36} />
                        <span class="mm-t"><b>{label}</b><small>{sub}</small></span>
                        <em class="mm-badge" data-badge={page} hidden></em>
                    </button>
                ))}
            </nav>
        </aside>

        <section class="panel stage enter-2">
            <div class="pg" data-pg="daily">
                <div class="panel-head"><Icon name="gift" size={28} /><h2 class="panel-title">Daily reward</h2><span class="aside" data-d-aside>Day 7 pays the most</span></div>
                <div class="pg-body daily">
                    <ol class="d-ladder">
                        {LOGIN.map((reward, index) => (
                            <li data-day={index + 1} class={index === 6 ? 'big' : ''}>
                                <small>Day {index + 1}</small>
                                <img src={index === 6 ? '/images/ui/icons/chest.svg' : BP} alt="" width="52" height="52" />
                                <b>{reward.coins}</b>
                                <span class="d-xp">+{reward.xp} XP</span>
                                <span class="d-tick"><Icon name="check" size={22} /></span>
                            </li>
                        ))}
                    </ol>
                    <div class="d-foot">
                        <button class="btn btn-gold btn-lg d-claim" type="button" data-claim="daily" disabled><img src={BP} alt="" width="26" height="26" /><span data-d-label>Claim</span></button>
                        <p class="plate"><Icon name="shield" size={24} /><span data-d-note>Miss a day and your streak shield saves it (once a week).</span></p>
                    </div>
                </div>
            </div>

            <div class="pg" data-pg="quests" hidden>
                <div class="panel-head"><Icon name="scroll" size={28} /><h2 class="panel-title">Today's quests</h2><span class="aside" data-q-reset>New quests every day</span></div>
                <div class="pg-body quests">
                    <div class="q-list" data-q-list>
                        {[0, 1, 2].map(() => <div class="quest skeleton"></div>)}
                    </div>
                    <div class="chest" data-chest>
                        <img src="/images/ui/icons/chest.svg" alt="" width="64" height="64" />
                        <span><b>Quest chest</b><small>Claim all three quests to open it</small></span>
                        <span class="c-pay"><em><img src={BP} alt="" width="20" height="20" />+{QUEST_CHEST.coins}</em><em class="xp">+{QUEST_CHEST.xp} XP</em></span>
                        <button class="btn btn-gold" type="button" data-claim="chest" disabled>Open</button>
                    </div>
                </div>
            </div>

            <div class="pg" data-pg="pass" hidden>
                <div class="panel-head"><Icon name="crown" size={28} /><h2 class="panel-title">{PASS.name}</h2><span class="aside">Ends {endDate}</span></div>
                <div class="pg-body pass">
                    <div class="p-top">
                        <div class="p-tier"><small>Tier</small><b data-p-tier>0</b><small>of {PASS.tiers}</small></div>
                        <div class="p-bar-wrap">
                            <div class="p-bar"><i data-p-bar></i></div>
                            <small data-p-text>Every call, vote, quest and daily reward earns pass XP.</small>
                        </div>
                        <button class="btn btn-gold" type="button" data-claim="pass" disabled><span data-p-claim>Claim</span></button>
                    </div>
                    <ol class="p-track" data-p-track>
                        {tiers.map((tier) => (
                            <li data-tier={tier.tier} class={tier.item ? 'look' : ''}>
                                <span class="t-n">{tier.tier}</span>
                                <img class="t-img" src={tier.item ? '/images/ui/icons/chest.svg' : BP} alt="" width="44" height="44" loading="lazy" />
                                <span class="t-bp"><img src={BP} alt="" width="16" height="16" />{tier.coins}</span>
                                {tier.item && <em>{itemName.get(tier.item)}</em>}
                                <span class="t-tick"><Icon name="check" size={20} lazy /></span>
                            </li>
                        ))}
                    </ol>
                    <div class="p-looks">
                        {tiers.filter((tier) => tier.item).map((tier) => (
                            <div class="pl" data-look-tier={tier.tier}>
                                {itemKind.get(tier.item) === 'frame'
                                    ? <div class={`look-frame ${tier.item}`}><div class="lf-card"><Icon name="paw" size={22} lazy /></div></div>
                                    : <span class="title-chip">{itemName.get(tier.item)}</span>}
                                <b>{itemKind.get(tier.item) === 'frame' ? `${itemName.get(tier.item)} frame` : 'Title'}</b>
                                <small>Tier {tier.tier}</small>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <div class="pg" data-pg="shop" hidden>
                <div class="panel-head">
                    <Icon name="cards" size={28} /><h2 class="panel-title">Shop</h2>
                    <div class="seg shop-seg">
                        <button type="button" aria-pressed="true" data-shop-tab="frame">Card frames</button>
                        <button type="button" aria-pressed="false" data-shop-tab="title">Titles</button>
                    </div>
                    <span class="aside">Looks only. Never random.</span>
                </div>
                <div class="pg-body shop">
                    <div class="shop-grid" data-shop="frame">
                        <article class="item" data-item="none" data-kind="frame">
                            <div class="look-frame"><div class="lf-card"><Icon name="paw" size={28} lazy /></div></div>
                            <b>No frame</b>
                            <button class="btn btn-sm" type="button" data-equip="frame" data-id="">Wear</button>
                        </article>
                        {frames.map((item) => (
                            <article class="item" data-item={item.id} data-kind="frame" title={item.desc}>
                                <div class={`look-frame ${item.id}`}><div class="lf-card"><Icon name="paw" size={28} lazy /></div></div>
                                <b>{item.name}</b>
                                {item.price
                                    ? <button class="btn btn-sm btn-gold" type="button" data-buy={item.id} data-price={item.price}><img src={BP} alt="" width="18" height="18" />{item.price.toLocaleString('en-US')}</button>
                                    : <span class="lock" data-lock><Icon name="lock" size={16} lazy />{earnText(item)}</span>}
                                <button class="btn btn-sm" type="button" data-equip="frame" data-id={item.id} hidden>Wear</button>
                            </article>
                        ))}
                    </div>
                    <div class="shop-grid titles" data-shop="title" hidden>
                        {titles.map((item) => (
                            <article class="item" data-item={item.id} data-kind="title">
                                <span class="title-chip">{item.name}</span>
                                {item.price
                                    ? <button class="btn btn-sm btn-gold" type="button" data-buy={item.id} data-price={item.price}><img src={BP} alt="" width="18" height="18" />{item.price.toLocaleString('en-US')}</button>
                                    : !item.free && <span class="lock" data-lock><Icon name="lock" size={16} lazy />{earnText(item)}</span>}
                                <button class="btn btn-sm" type="button" data-equip="title" data-id={item.id} hidden={!item.free}>Wear</button>
                            </article>
                        ))}
                    </div>
                </div>
            </div>

            <div class="pg" data-pg="earn" hidden>
                <div class="panel-head"><Icon name="coin" size={28} /><h2 class="panel-title">How to earn</h2><span class="aside">Paid every time, up to a daily limit</span></div>
                <div class="pg-body earn">
                    {EARN.map(([icon, what, where, def, key, note, href]) => (
                        <a class="earn-row" href={href}>
                            <Icon name={icon} size={44} lazy />
                            <span class="e-what"><b>{what}</b><small>{where}: {note}</small></span>
                            <span class="e-pay"><em><img src={BP} alt="" width="20" height="20" />+{def.coins}</em><em class="xp">+{def.xp} XP</em></span>
                            <span class="e-cap"><span class="e-bar"><i data-cap-bar={key}></i></span><small data-cap={key}>First {def.cap} a day</small></span>
                        </a>
                    ))}
                    <p class="plate"><Icon name="scroll" size={24} /><span>Everything you do also counts toward today's quests and earns Season Pass XP. Level-ups pay BattlePoints too.</span></p>
                    <a class="plate" href="/collection"><Icon name="cards" size={24} /><span>Spend BattlePoints on battle cards: pick any animal's card for your <b>collection</b>.</span></a>
                </div>
            </div>

            <div class="guest-gate" data-guest hidden>
                <Icon name="lock" size={56} />
                <h2 class="panel-title">Log in to start earning</h2>
                <p>Every fight call, vote and comment pays BattlePoints and XP. Claim a daily reward, finish quests and climb the Season Pass.</p>
                <div class="btn-row"><a class="btn btn-gold btn-lg" href="/signup?returnTo=%2Frewards">Create account</a><a class="btn btn-lg" href="/login?returnTo=%2Frewards">Log in</a></div>
            </div>
        </section>
    </div>
</Base>

<script>
    import '../scripts/rewards.js';
</script>

<style>
    .rw { grid-template-columns: minmax(270px, 330px) minmax(0, 1fr); max-width: 1400px; margin: 0 auto; }
    .rw-side { min-height: 0; display: flex; flex-direction: column; gap: 12px; }
    .rw[data-state="loading"] .stage .pg-body { opacity: 0.6; }

    /* wallet plate */
    .wallet { padding: 14px 16px; gap: 12px; flex: none; }
    .w-bp { display: flex; align-items: center; gap: 12px; }
    .w-bp :global(img) { filter: drop-shadow(0 5px 8px rgba(0, 0, 0, 0.5)); }
    .w-bp small { display: block; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-2); }
    .w-bp b { display: block; font-family: var(--font-display); font-size: 2.6rem; font-weight: 900; line-height: 0.9; color: #fff; text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5); }
    .w-level { display: flex; align-items: center; gap: 10px; }
    .w-lvl { flex: none; display: grid; place-items: center; width: 42px; height: 42px; font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; color: #fff; text-shadow: 0 1px 2px #000, 0 0 6px rgba(0, 0, 0, 0.6); background: url("/images/ui/level.svg") center / contain no-repeat; }
    .w-xp { flex: 1; display: grid; gap: 4px; min-width: 0; }
    .w-xpbar, .p-bar, .e-bar { display: block; height: 10px; background: rgba(255, 255, 255, 0.1); clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%); overflow: hidden; }
    .w-xpbar i, .p-bar i, .e-bar i { display: block; width: 0; height: 100%; background: linear-gradient(90deg, var(--cyan), var(--cyan-2)); transition: width 0.8s var(--ease); }
    .w-xp small { font-size: 0.64rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .w-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .w-chip { display: grid; grid-template-columns: 22px minmax(0, 1fr); column-gap: 8px; align-items: center; padding: 6px 8px; background: rgba(9, 10, 12, 0.55); border: 1px solid var(--line); border-radius: 8px; }
    .w-chip :global(img) { grid-row: 1 / 3; }
    .w-chip b { font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; line-height: 1; }
    .w-chip small { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }

    /* menu: the home screen's main-menu buttons */
    .rw-menu { display: grid; gap: 8px; align-content: start; min-height: 0; }
    .mm {
        position: relative; display: flex; align-items: center; gap: 12px; width: 100%;
        min-height: 54px;
        padding: 8px 16px; color: var(--text); text-align: left; font: inherit;
        background: var(--hex) 0 0 / var(--hex-size), linear-gradient(180deg, #222429, #16171b);
        border: 1px solid var(--frame);
        border-radius: 10px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
        cursor: pointer;
        transition: border-color 0.15s;
    }
    .mm:hover { border-color: var(--frame-2); }
    .mm[aria-pressed="true"] { border-color: var(--gold); background: linear-gradient(90deg, rgba(246, 180, 0, 0.16), rgba(246, 180, 0, 0.03)), linear-gradient(180deg, #222429, #16171b); box-shadow: inset 4px 0 0 var(--gold); }
    .mm :global(img) { flex: none; }
    .mm-t { min-width: 0; }
    .mm b { display: block; font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1; }
    .mm small { display: block; font-size: 0.72rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mm-badge { margin-left: auto; flex: none; padding: 2px 9px; font-style: normal; font-family: var(--font-display); font-size: 0.9rem; font-weight: 900; letter-spacing: 0.04em; color: #fff; background: var(--red); border-radius: 999px; box-shadow: 0 0 12px rgba(255, 77, 94, 0.5); }
    .mm-badge[hidden] { display: none; }

    /* stage */
    .stage { min-height: 0; overflow: hidden; }
    .pg { flex: 1; min-height: 0; display: flex; flex-direction: column; }
    .pg[hidden] { display: none; }
    .pg-body { flex: 1; min-height: 0; padding: clamp(12px, 2.2vh, 24px) clamp(12px, 2vw, 24px); display: flex; flex-direction: column; gap: clamp(10px, 2vh, 18px); transition: opacity 0.2s; }
    .plate { display: flex; align-items: center; gap: 10px; margin: 0; padding: 10px 14px; font-size: 0.86rem; color: var(--text-2); background: rgba(9, 10, 12, 0.55); border: 1px solid var(--line); border-radius: 10px; }
    .plate :global(img) { flex: none; }
    a.plate { text-decoration: none; transition: border-color 0.15s; }
    a.plate:hover { border-color: var(--gold); }
    a.plate b { color: var(--gold); }

    /* daily */
    .daily { justify-content: center; }
    .d-ladder { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: clamp(6px, 1vw, 12px); margin: 0; padding: 8px 0 0; list-style: none; }
    .d-ladder li { position: relative; display: grid; justify-items: center; align-content: center; gap: clamp(4px, 1vh, 10px); min-height: clamp(150px, 30vh, 280px); padding: clamp(10px, 2.4vh, 22px) 4px; background: linear-gradient(180deg, rgba(44, 46, 52, 0.8), rgba(14, 15, 18, 0.9)); border: 1px solid var(--line-2); border-radius: 14px; transition: transform 0.2s var(--spring); }
    .d-ladder small { font-family: var(--font-display); font-size: 0.95rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .d-ladder li > :global(img) { width: clamp(34px, 8vh, 80px); height: auto; filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.5)); }
    .d-ladder b { font-family: var(--font-display); font-size: clamp(1.4rem, 4vh, 2.6rem); font-weight: 900; line-height: 1; color: var(--gold-2); }
    .d-xp { font-size: 0.7rem; font-weight: 800; color: var(--cyan-2); }
    .d-ladder .big { background: linear-gradient(180deg, rgba(255, 215, 0, 0.22), rgba(14, 15, 18, 0.9)); border-color: rgba(255, 215, 0, 0.5); }
    .d-ladder .now { border-color: var(--gold); box-shadow: 0 0 22px rgba(255, 215, 0, 0.45); transform: translateY(-6px) scale(1.04); }
    .d-ladder .done { opacity: 0.5; }
    .d-tick { position: absolute; top: 6px; right: 6px; display: none; }
    .d-ladder .done .d-tick { display: block; }
    .d-foot { display: grid; justify-items: center; gap: 12px; }
    .d-claim { min-width: 300px; justify-content: center; }

    /* quests */
    .quests { justify-content: center; }
    .q-list { display: grid; gap: clamp(8px, 1.6vh, 14px); }
    .rw :global(.quest) { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; column-gap: 14px; row-gap: 7px; padding: clamp(10px, 1.8vh, 16px) 16px; background: linear-gradient(180deg, rgba(44, 46, 52, 0.7), rgba(14, 15, 18, 0.85)); border: 1px solid var(--line-2); border-radius: 14px; }
    .rw :global(.quest > img) { grid-row: 1 / 4; width: 48px; height: 48px; }
    .rw :global(.quest b) { font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.05; }
    .rw :global(.quest.done) { border-color: rgba(53, 220, 143, 0.6); box-shadow: 0 0 18px rgba(53, 220, 143, 0.2); }
    .rw :global(.quest.claimed) { opacity: 0.5; }
    .rw :global(.q-bar) { display: block; height: 10px; background: rgba(255, 255, 255, 0.08); clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%); overflow: hidden; }
    .rw :global(.q-bar i) { display: block; height: 100%; background: linear-gradient(90deg, var(--green), #9bf0c6); transition: width 0.6s var(--ease); }
    .rw :global(.q-pay) { display: flex; flex-wrap: wrap; gap: 6px; }
    .rw :global(.q-pay span) { display: inline-flex; align-items: center; gap: 4px; padding: 1px 9px; font-size: 0.74rem; font-weight: 800; color: var(--gold-2); background: rgba(9, 10, 12, 0.6); border-radius: 999px; }
    .rw :global(.q-pay img) { width: 14px; height: 14px; }
    .rw :global(.q-pay span.x) { color: var(--cyan-2); }
    .rw :global(.q-pay span.p) { color: var(--orange-2); }
    .rw :global(.q-end) { grid-column: 3; grid-row: 1 / 4; display: grid; justify-items: center; gap: 4px; }
    .rw :global(.q-count) { font-family: var(--font-display); font-size: 1.6rem; font-weight: 900; line-height: 1; color: var(--text-2); }
    .quest.skeleton { min-height: 96px; }
    .chest { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 14px; padding: 12px 16px; background: linear-gradient(180deg, rgba(255, 215, 0, 0.12), rgba(9, 10, 12, 0.5)); border: 1px dashed rgba(255, 215, 0, 0.5); border-radius: 14px; }
    .chest b { display: block; font-family: var(--font-display); font-size: 1.3rem; font-weight: 900; text-transform: uppercase; line-height: 1.05; }
    .chest small { font-size: 0.8rem; color: var(--text-2); }
    .c-pay { display: flex; gap: 10px; }
    .c-pay em, .e-pay em { display: inline-flex; align-items: center; gap: 4px; font-style: normal; font-family: var(--font-display); font-size: 1.35rem; font-weight: 900; color: var(--gold-2); white-space: nowrap; }
    .c-pay em.xp, .e-pay em.xp { color: var(--cyan-2); }
    .chest.ready { border-style: solid; box-shadow: 0 0 22px rgba(255, 215, 0, 0.35); }
    .chest.ready > :global(img) { animation: float 1.6s ease-in-out infinite; }
    .chest.opened { opacity: 0.5; }

    /* pass */
    .p-top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; }
    .p-tier { display: grid; justify-items: center; line-height: 1; }
    .p-tier b { font-family: var(--font-display); font-size: 3.2rem; font-weight: 900; color: var(--orange-2); text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5); }
    .p-tier small { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
    .p-bar-wrap { display: grid; gap: 6px; }
    .p-bar { height: 14px; }
    .p-bar i { background: linear-gradient(90deg, var(--orange), var(--gold)); }
    .p-bar-wrap small { font-size: 0.8rem; color: var(--text-2); }
