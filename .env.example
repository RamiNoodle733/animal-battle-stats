# Environment Variables Template
# Copy this file to .env.local and fill in your values

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/animal-stats?retryWrites=true&w=majority

# JWT Secret for Authentication
# Generate a secure random string for production
JWT_SECRET=your-secret-key-here

# Activity feed (optional): site events are posted to either or both
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email (optional): verification links and password resets. Resend's API takes the
# site's JSON as it is; without a URL nothing is emailed (see DEPLOYMENT.md)
# EMAIL_WEBHOOK_URL=https://api.resend.com/emails
# EMAIL_WEBHOOK_TOKEN=
# EMAIL_FROM=Animal Battle Stats <no-reply@animalbattlestats.com>

# Google sign-in (optional): OAuth web client, redirect <site>/api/auth?action=google-callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Daily cron job (retries Discord/Slack deliveries); Vercel sends it as a bearer token
# CRON_SECRET=

# Roblox (optional). OAuth app for "Continue with Roblox" and "Connect Roblox";
# create it at https://create.roblox.com/dashboard/credentials (see DEPLOYMENT.md)
# ROBLOX_CLIENT_ID=
# ROBLOX_CLIENT_SECRET=
# ROBLOX_REDIRECT_URI=https://animalbattlestats.com/api/auth?action=roblox-callback
# Open Cloud key with ordered DataStore read access (leaderboards, linked players' stats)
# ROBLOX_OPEN_CLOUD_KEY=

# Node Environment (development, production, test)
NODE_ENV=development
