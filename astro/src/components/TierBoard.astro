---
import AnimalImage from './AnimalImage.astro';
import { TIERS, fmtScore } from '../lib/catalog.js';

const { list } = Astro.props;
const tiers = TIERS.map((tier) => ({ ...tier, animals: list.filter((animal) => animal.tier === tier.id) }));
---
<div class="tier-board">
    {tiers.map((tier) => (
        <section class={`tier-row tier-${tier.id.toLowerCase()}`} id={`tier-${tier.id.toLowerCase()}`} aria-label={`${tier.id} tier: ${tier.name}`}>
            <header class="tier-label">
                <strong>{tier.id}</strong>
                <span>{tier.name}</span>
                <small>{tier.animals.length}</small>
            </header>
            {tier.animals.length ? (
                <ol class="tier-list">
                    {tier.animals.map((animal) => (
                        <li>
                            <a class={`tchip bio-${animal.biome}`} href={`/stats/${animal.slug}`} title={`${animal.name}: power ${fmtScore(animal.powerIndex)} (#${animal.rank})`} data-sfx>
                                <AnimalImage animal={animal} sizes="96px" alt="" />
                                <span class="tl-name">{animal.name}</span>
                                <span class="tl-score">{fmtScore(animal.powerIndex)}</span>
                            </a>
                        </li>
                    ))}
                </ol>
            ) : <p class="tier-empty">None in this group</p>}
        </section>
    ))}
</div>

<style>
    .tier-board { display: grid; gap: 8px; }
    .tier-row {
        display: grid;
        grid-template-columns: 86px minmax(0, 1fr);
        min-height: 104px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--tier) 14%, transparent), transparent 35%), rgba(3, 6, 16, 0.5);
        border: 1px solid color-mix(in srgb, var(--tier) 35%, transparent);
        clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    }
    .tier-label {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: #0b0e1a;
        background: linear-gradient(160deg, var(--tier-2), var(--tier) 45%, var(--tier-d));
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
    }
    .tier-label strong { font-family: var(--font-display); font-size: 3.2rem; font-weight: 900; line-height: 0.85; }
    .tier-label span { font-family: var(--font-display); font-size: 0.85rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
    .tier-label small { font-size: 0.7rem; font-weight: 800; opacity: 0.7; }
    .tier-list { list-style: none; margin: 0; padding: 8px; display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
    .tchip {
        position: relative;
        display: flex; flex-direction: column; align-items: center;
        width: 88px; height: 100%;
        padding: 4px 4px 5px;
        background: radial-gradient(90% 70% at 50% 35%, color-mix(in srgb, var(--bio-glow) 26%, transparent), transparent 75%), linear-gradient(180deg, color-mix(in srgb, var(--bio-sky) 70%, transparent), rgba(3, 6, 16, 0.85));
        border: 1px solid color-mix(in srgb, var(--tier) 30%, transparent);
        border-radius: 8px;
        transition: transform 0.18s var(--spring), border-color 0.15s;
        text-align: center;
    }
    .tchip:hover { transform: translateY(-4px) scale(1.04); border-color: var(--tier); z-index: 2; }
    .tchip :global(img) { width: 80px; height: 56px; object-fit: contain; filter: drop-shadow(0 5px 6px rgba(0, 0, 0, 0.55)); }
    .tl-name { margin-top: 2px; font-family: var(--font-display); font-size: 0.8rem; font-weight: 900; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; }
    .tl-score { font-family: var(--font-display); font-size: 0.8rem; font-weight: 900; color: var(--tier); }
    .tier-empty { margin: 0; padding: 16px; font-size: 0.8rem; color: var(--dim); align-self: center; }
    @media (max-width: 640px) {
        .tier-row { grid-template-columns: 54px minmax(0, 1fr); }
        .tier-label strong { font-size: 2.2rem; }
        .tier-label span { display: none; }
        .tchip { width: 74px; }
        .tchip :global(img) { width: 66px; height: 46px; }
    }
</style>
