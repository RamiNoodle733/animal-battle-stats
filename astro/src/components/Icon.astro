---
// One of the metal item icons (images/ui/icons/*.svg, from scripts/assets/build-ui-icons.py).
const { name, size = 24, alt = '', class: className, lazy = false } = Astro.props;
---
<img class={className} src={`/images/ui/icons/${name}.svg`} width={size} height={size} alt={alt} loading={lazy ? 'lazy' : 'eager'} decoding="async" draggable="false" />
