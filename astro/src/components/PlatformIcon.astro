---
// Simple glyphs for the social accounts on the Shows pages (drawn here, not brand files).
const { name, size = 22 } = Astro.props;
---
<svg class="pf-icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
    {name === 'youtube' && <><rect x="1.5" y="5" width="21" height="14" rx="4.5" fill="currentColor" /><path d="M10 9v6l5.2-3z" fill="var(--pf-bg, #fff)" /></>}
    {name === 'tiktok' && <path d="M14.2 3h3c.3 2.1 1.7 3.6 3.8 3.9v3.1a7 7 0 0 1-3.8-1.2v6.3a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v3.2a2.8 2.8 0 1 0 2 2.7z" fill="currentColor" />}
    {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5.2" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="17.3" cy="6.8" r="1.35" fill="currentColor" /></>}
    {name === 'facebook' && <path d="M13.4 21v-7.6H16l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.7v3h2.6V21z" fill="currentColor" />}
    {name === 'x' && <path d="M4 3.5h4.6l4 5.5 4.8-5.5h2.3l-6.1 7 6.9 9.9h-4.6l-4.3-6-5.3 6H4l6.5-7.4z" fill="currentColor" />}
    {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" fill="currentColor" /><path d="M7 10h2.2v7H7zm1.1-3.6a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6M10.8 10h2.1v1c.4-.7 1.2-1.2 2.4-1.2 2.2 0 2.7 1.4 2.7 3.3V17h-2.2v-3.4c0-.9 0-1.9-1.2-1.9s-1.4.9-1.4 1.9V17h-2.2z" fill="var(--pf-bg, #0a66c2)" /></>}
    {name === 'discord' && <path d="M19.3 5.4A16 16 0 0 0 15.4 4l-.5 1a14.6 14.6 0 0 0-5.8 0l-.5-1a16 16 0 0 0-3.9 1.4C2.2 9.1 1.5 12.7 1.8 16.2a16 16 0 0 0 4.8 2.4l1-1.6c-.6-.2-1.1-.5-1.6-.8l.4-.3a11.4 11.4 0 0 0 11.2 0l.4.3c-.5.3-1 .6-1.6.8l1 1.6a16 16 0 0 0 4.8-2.4c.4-4-.6-7.6-2.9-10.8M8.8 14.2c-.9 0-1.7-.9-1.7-2s.8-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2m6.4 0c-.9 0-1.7-.9-1.7-2s.8-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2" fill="currentColor" />}
    {name === 'reddit' && <><circle cx="12" cy="13.5" r="7.5" fill="currentColor" /><circle cx="18.2" cy="5.2" r="1.6" fill="currentColor" /><path d="M12 6l1.2-3.3 4.8 1.4" fill="none" stroke="currentColor" stroke-width="1.4" /><circle cx="9.2" cy="13" r="1.3" fill="var(--pf-bg, #ff4500)" /><circle cx="14.8" cy="13" r="1.3" fill="var(--pf-bg, #ff4500)" /><path d="M9 16.3c1.7 1.2 4.3 1.2 6 0" fill="none" stroke="var(--pf-bg, #ff4500)" stroke-width="1.3" stroke-linecap="round" /></>}
</svg>
