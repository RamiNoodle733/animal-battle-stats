---
import { rosterSize } from '../lib/catalog.js';
// Static weights, not the variable fonts: Safari (WebKit) drew the variable
// display face at its thinnest weight.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource/big-shoulders-display/latin-900';
import '../styles/abs.css';
import packageJson from '../../../package.json';
import UiIcon from '../components/UiIcon.astro';
import Icon from '../components/Icon.astro';
import RobloxMark from '../components/RobloxMark.astro';
import { SITE, SOCIAL, ROBLOX, absoluteUrl } from '../lib/site.js';
import { sectionPreview, sectionAlt } from '../lib/previews.js';

const {
    title,
    description,
    path = '/',
    image = sectionPreview('home'),
    imageAlt = sectionAlt('home'),
    type = 'website',
    jsonLd = [],
    active = '',
    biome = 'arena',
    seed = 7,
    noindex = false,
    bodyClass = ''
} = Astro.props;

const canonical = absoluteUrl(path);
const socialImage = absoluteUrl(image);
const version = packageJson.version;
const MENU = [
    { key: 'animals', href: '/stats', label: 'Animals', icon: 'paw' },
    { key: 'compare', href: '/compare', label: 'Versus', icon: 'vs' },
    { key: 'shows', href: '/shows', label: 'Shows', icon: 'tv' },
    { key: 'tiers', href: '/tier-list', label: 'Tiers', icon: 'crown' },
    { key: 'tournament', href: '/tournament', label: 'Tournament', icon: 'trophy' },
    { key: 'community', href: '/community', label: 'Community', icon: 'users' }
];
// Phones: the four places people play most, then Menu (every other page).
const DOCK = [MENU[0], MENU[1], MENU[4], MENU[2]];
// The menu sheet: every page as a big tile.
const PAGES = [
    { href: '/', label: 'Home', icon: 'home', key: 'home' },
    { href: '/stats', label: 'Animals & rankings', icon: 'paw', key: 'animals' },
    { href: '/compare', label: 'Who would win?', icon: 'vs', key: 'compare' },
    { href: '/tournament', label: 'Tournament', icon: 'trophy', key: 'tournament' },
    { href: '/tier-list', label: 'Tier list', icon: 'crown', key: 'tiers' },
    { href: '/shows', label: 'Shows', icon: 'tv', key: 'shows' },
    { href: '/community', label: 'Community', icon: 'friends', key: 'community' },
    { href: '/collection', label: 'My card collection', icon: 'cards', key: 'collection' },
    { href: '/rewards', label: 'Rewards & shop', icon: 'gift', key: 'rewards' },
    { href: '/roblox', label: 'Roblox game', icon: 'roblox', key: 'roblox' },
    { href: '/about', label: 'How ratings work', icon: 'book', key: 'about' }
];
// Google Analytics 4 (property "Animal Battle Stats", web stream animalbattlestats.com).
const GA_ID = 'G-NQ328W18LX';
const graph = [
    {
        '@type': 'Organization',
        '@id': `${SITE.url}/#organization`,
        name: SITE.name,
        url: `${SITE.url}/`,
        logo: { '@type': 'ImageObject', url: absoluteUrl(SITE.logo), width: 512, height: 512 },
        email: SITE.email,
        founder: { '@type': 'Person', name: SITE.founder },
        sameAs: SOCIAL.map((item) => item.url)
    },
    {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        alternateName: ['ABS', 'animalbattlestats.com'],
        url: `${SITE.url}/`,
        description: SITE.description,
        publisher: { '@id': `${SITE.url}/#organization` },
        inLanguage: 'en',
        potentialAction: {
            '@type': 'SearchAction',
            target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/stats?q={search_term_string}` },
            'query-input': 'required name=search_term_string'
        }
    },
    ...jsonLd
];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
        <meta name="theme-color" content="#0b0c0e" />
        <meta name="color-scheme" content="dark" />
        <meta name="abs-version" content={version} />
        <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
        <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="alternate" type="text/plain" title="Summary for AI assistants" href="/llms.txt" />
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@AnimalBattStats" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <slot name="head" />
        <script type="application/ld+json" set:html={ldJson} />
        {/* GA4: the queue is ready at once so pages can send events; gtag.js itself
            loads after the page has finished loading, and only on the live site. */}
        <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', GA_ID);
            (function () {
                if (!/(^|\.)animalbattlestats\.com$/.test(location.hostname) || navigator.webdriver) return;
                function load() {
                    var script = document.createElement('script');
                    script.async = true;
                    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                    document.head.appendChild(script);
                }
                function later() { (window.requestIdleCallback || setTimeout)(load, { timeout: 2500 }); }
                if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
            })();
        </script>
    </head>
    <body class={`game bio-${biome} ${bodyClass}`.trim()}>
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="arena" aria-hidden="true"></div>

        <header class="hud">
            <a class="brand" href="/" aria-label="Animal Battle Stats home">
                <img src="/images/logo.png" alt="" width="40" height="40" />
                <span class="brand-word"><b>Animal Battle</b><span>Stats</span></span>
            </a>
            <nav class="menu" aria-label="Main">
                {MENU.map((item) => (
                    <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                        <UiIcon name={item.icon} />
                        <span>{item.label}</span>
                    </a>
                ))}
            </nav>
            <div class="hud-right">
                <button class="hud-btn" type="button" data-open-search aria-label="Search animals" title="Search (press /)">
                    <UiIcon name="search" />
                </button>
                <button class="hud-btn hud-sound" type="button" data-sound-toggle aria-label="Sound effects" aria-pressed="true">
                    <UiIcon name="sound" />
                </button>
                {ROBLOX.live
                    ? <a class="btn btn-play btn-sm play-btn" href={ROBLOX.playUrl} rel="noopener" target="_blank"><RobloxMark size={20} /><span>Play<span class="long"> on Roblox</span></span></a>
                    : <a class="btn btn-white btn-sm play-btn" href="/roblox" aria-current={active === 'roblox' ? 'page' : undefined}><RobloxMark size={20} /><span>Roblox<span class="long"> game</span></span></a>}
                <a class="hud-btn rewards-btn" href="/rewards" data-rewards-btn aria-label="Rewards" title="Rewards: daily reward, quests, Season Pass and shop" aria-current={active === 'rewards' ? 'page' : undefined}>
                    <UiIcon name="gift" /><span class="rw-badge" data-rewards-badge hidden>0</span>
                </a>
                <a class="player-chip" href="/login" data-player-chip><span class="lvl">?</span><span class="who">Log in</span></a>
                <button class="hud-btn hud-menu" type="button" data-sheet-toggle aria-expanded="false" aria-controls="more-sheet" aria-label="Menu">
                    <UiIcon name="menu" />
                </button>
            </div>
        </header>

        <main class="screen" id="main">
            <slot />
        </main>

        <nav class="dock" aria-label="Quick">
            {DOCK.map((item) => (
                <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                    <UiIcon name={item.icon} size={22} />
                    <span>{item.label}</span>
                </a>
            ))}
            <button type="button" class="dock-menu" data-sheet-toggle aria-expanded="false" aria-controls="more-sheet">
                <UiIcon name="menu" size={22} />
                <span>Menu</span>
            </button>
        </nav>

        <aside class="sheet" id="more-sheet" aria-label="Menu">
            <div class="sheet-head">
                <h2 class="panel-title">Menu</h2>
                <button class="hud-btn" type="button" data-sheet-toggle aria-label="Close menu"><UiIcon name="close" size={18} /></button>
            </div>
            <nav class="sheet-grid" aria-label="All pages">
                {PAGES.map((item) => (
                    <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
                        {item.icon === 'roblox' ? <span class="sheet-mark"><RobloxMark size={26} /></span> : <Icon name={item.icon} size={30} />}
                        <span>{item.label === 'Roblox game' && ROBLOX.live ? 'Play on Roblox' : item.label}</span>
                    </a>
                ))}
            </nav>
            <div class="sheet-row">
                <button class="sheet-sound" type="button" data-sound-toggle aria-pressed="true"><UiIcon name="sound" /><span data-sound-text>Sound effects: on</span></button>
                <a class="sheet-link" href="/credits">Sources &amp; photo credits</a>
                <a class="sheet-link" href="/llms.txt">Data for AI assistants</a>
            </div>
            <div class="socials">
                {SOCIAL.map((item) => <a class="chip" href={item.url} rel="me noopener" target="_blank">{item.name}</a>)}
            </div>
            <p class="fine">© {year} {SITE.name} · v{version}<br />Hypothetical matchups for fun and learning. Never approach wild animals.<br />Roblox is a trademark of Roblox Corporation. This site is not affiliated with or endorsed by Roblox.</p>
        </aside>

        <dialog class="search-dialog" id="search-dialog" aria-label="Search animals">
            <div class="search-field">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
                <input type="search" placeholder={`Search ${rosterSize} animals, or "lion vs tiger"`} aria-label="Search animals" autocomplete="off" spellcheck="false" data-search-input />
                <kbd class="chip">Esc</kbd>
            </div>
            <ul class="search-results" role="listbox" data-search-results></ul>
        </dialog>

        <script>
            import '../scripts/site.js';
        </script>
        <slot name="scripts" />
    </body>
</html>
