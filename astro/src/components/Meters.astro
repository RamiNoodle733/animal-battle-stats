---
// Six stat bars, one per line: label, bar, number. One colour for every stat,
// so the numbers carry the page (scripts update .m-bar --v and .m-val).
import { STATS, fmtScore } from '../lib/catalog.js';

const { animal, compact = false } = Astro.props;
---
<div class={`meters${compact ? ' compact' : ''}`}>
    {STATS.map((stat) => {
        const value = Number(animal[stat.key]) || 0;
        return (
            <div class="meter" data-meter={stat.key} title={`${stat.label}: ${stat.blurb}`}>
                <span class="m-label">{stat.label}</span>
                <span class="m-bar" style={`--v:${Math.min(100, value)}`} role="meter" aria-label={stat.label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={value}><i></i></span>
                <b class="m-val">{fmtScore(value)}</b>
            </div>
        );
    })}
</div>
